// r.PlanetAtmosphere.DebugMode 1 — "Atmosphere Bounds" debug visualization.
// For every visible atmosphere (sorted near -> far on the CPU) draws, analytically:
//   - the atmosphere shell [AtmosphereBottom, AtmosphereTop]  (blue haze, thicker along longer paths)
//   - the cloud shell      [CloudBottom, CloudTop]            (white haze)
//   - the planet sphere surface                                (shaded opaque-ish green)
// Everything is clipped by the scene depth, so scene geometry in front correctly occludes it.
// Does NOT evaluate cloud density (that lives only in CloudDensity.ush, used by CloudRaymarch.usf).

#include "/Engine/Private/Common.ush"
#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"

float DebugIntensity;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	FPAPixelRay Ray;
	if (!PA_SetupPixelRay(DispatchThreadId.xy, Ray))
	{
		return;
	}

	const float3 AtmosphereColor = float3(0.25, 0.5, 1.0);
	const float3 CloudColor = float3(1.0, 1.0, 1.0);
	const float3 SurfaceColor = float3(0.15, 0.4, 0.2);

	float3 Accum = 0.0;
	float Transmittance = 1.0;

	for (int Index = 0; Index < NumAtmospheres && Index < PA_MAX_ATMOSPHERES; ++Index)
	{
		const FPAAtmosphere A = PA_LoadAtmosphere(Index);

		// Quick reject: the ray misses the whole atmosphere.
		const float2 TopHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.AtmosphereTop);
		if (TopHit.x > TopHit.y || TopHit.y <= 0.0)
		{
			continue;
		}

		// The ray ends at the scene geometry or at the planet surface, whichever is closer.
		float TMax = Ray.SceneDistance;
		bool bSurfaceVisible = false;
		float SurfaceT = 0.0;
		const float2 PlanetHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, 0.0);
		if (PlanetHit.x <= PlanetHit.y && PlanetHit.y > 0.0)
		{
			SurfaceT = max(PlanetHit.x, 0.0);
			if (SurfaceT < TMax)
			{
				TMax = SurfaceT;
				bSurfaceVisible = true;
			}
		}

		const float AtmosphereThickness = max(A.AtmosphereTop - A.AtmosphereBottom, 1.0);
		const float CloudThickness = max(A.CloudTop - A.CloudBottom, 1.0);

		const float AtmosphereLength = PA_LengthInsideShell(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.AtmosphereBottom, A.AtmosphereTop, TMax);
		const float CloudLength = PA_LengthInsideShell(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.CloudBottom, A.CloudTop, TMax);

		// Opacity grows with the path length measured in shell thicknesses (limb looks denser).
		const float AtmosphereAlpha = 0.45 * (1.0 - exp(-0.5 * AtmosphereLength / AtmosphereThickness));
		const float CloudAlpha = 0.65 * (1.0 - exp(-0.5 * CloudLength / CloudThickness));

		PA_CompositeFrontToBack(Accum, Transmittance, AtmosphereColor, AtmosphereAlpha);
		PA_CompositeFrontToBack(Accum, Transmittance, CloudColor, CloudAlpha);

		if (bSurfaceVisible)
		{
			const float3 SurfaceNormal = normalize(A.CameraRel + Ray.Dir * SurfaceT);
			const float Facing = saturate(dot(SurfaceNormal, -Ray.Dir));
			PA_CompositeFrontToBack(Accum, Transmittance, SurfaceColor * (0.25 + 0.75 * Facing), 0.9);
		}

		if (Transmittance < 0.001)
		{
			break;
		}
	}

	OutputTexture[Ray.Pixel] = float4(Ray.SceneColor.rgb * Transmittance + Accum * DebugIntensity, Ray.SceneColor.a);
}
