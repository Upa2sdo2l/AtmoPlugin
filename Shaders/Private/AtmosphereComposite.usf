// Phase 3 / Step 17 — composite of the clouds + atmosphere over the scene:
//   final = SceneColor x Transmittance + Luminance
// Luminance (pre-exposed) and Transmittance come from CloudRaymarch.usf (every debug mode of the raymarch is expressed
// the same way). Same pixel coordinates as the scene textures. Since Step 18 the temporal pass (AtmosphereTemporal.usf) sits between the
// raymarch and this pass; this pass stays the only place that touches the scene color.

#include "/Engine/Private/Common.ush"

Texture2D SceneColorTexture;
Texture2D<float4> LuminanceTexture;
Texture2D<float4> TransmittanceTexture;
RWTexture2D<float4> OutputTexture;
float4 ViewRectMinAndSize;   // xy = view rect min (pixels), zw = view rect size
int bShowTemporalWeight;     // r.PlanetAtmosphere.DebugMode 8 with the temporal pass active (Step 18)
float CurrentFrameWeight;    // r.PlanetAtmosphere.Temporal.CurrentFrameWeight

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= (uint)ViewRectMinAndSize.z || DispatchThreadId.y >= (uint)ViewRectMinAndSize.w)
	{
		return;
	}

	const int3 Pixel = int3((uint2)ViewRectMinAndSize.xy + DispatchThreadId.xy, 0);
	const float4 SceneColor = SceneColorTexture.Load(Pixel);
	const float3 Luminance = LuminanceTexture.Load(Pixel).rgb;
	const float4 Transmittance = TransmittanceTexture.Load(Pixel);
	float3 Result = SceneColor.rgb * Transmittance.rgb + Luminance;
	if (bShowTemporalWeight != 0)
	{
		// Temporal Weight: transmittance.a = accumulated sample weight N (AtmosphereTemporal.usf; 1 per traced frame,
		// less for pixels between the interleaved samples). Shown: 1 / N, at least CurrentFrameWeight = the weight a traced
		// sample gets. Red = little history (rejected / new), green = long history.
		const float N = Transmittance.a;
		const float Weight = N <= 1.0 ? 1.0 : max(1.0 / N, CurrentFrameWeight);
		Result = Result * 0.25 + float3(Weight, 1.0 - Weight, 0.0);
	}
	OutputTexture[Pixel.xy] = float4(Result, SceneColor.a);
}
