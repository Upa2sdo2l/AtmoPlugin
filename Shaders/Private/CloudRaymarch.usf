// Cloud raymarch (r.PlanetAtmosphere.DebugMode 0 = Final Clouds, 2 = Density, 3 = Cloud Height, 4 = Ray Steps).
//
// For every visible atmosphere (sorted near -> far on the CPU):
//   1. intersect the ray with the cloud shell -> up to two segments (camera below / inside / above the layer),
//      clipped by the scene depth and the planet surface;
//   2. distribute RaymarchSteps over the segments (RaymarchSchedule.ush): uniform or camera-centered steps,
//      per-pixel jitter inside each step, optional empty-space skipping (Phase 2 / Step 9);
//   3. density comes ONLY from PA_SampleCloudDensity() (CloudDensity.ush, AD-1);
//   4. Beer-Lambert transmittance, energy-conserving integration over each step;
//   5. lighting (CloudLighting.ush): sun * phase * light-march transmittance * planet shadow + ambient.
// Composited front-to-back across planets; the scene behind is attenuated by the final transmittance.
// Debug views reuse exactly the same march (same density calls), they only change what is written out.

#include "/Engine/Private/Common.ush"
#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"
#include "/Plugin/PlanetAtmosphere/Private/CloudLighting.ush"
#include "/Plugin/PlanetAtmosphere/Private/RaymarchSchedule.ush"

int DebugMode;               // 0 = final clouds, 2 = density, 3 = cloud height, 4 = ray steps
int bDrawPlanetSurface;      // debug placeholder surface for planets without scene geometry

// Lighting (Step 7). Illuminance in lux (the Directional Light intensity x color x temperature).
float3 SunDirection;         // unit, world axes, pointing TOWARD the sun
float3 SunIlluminance;       // 0 when there is no sun
float3 AmbientIlluminance;   // sky/ambient light on the clouds
int bHasSun;
int LightSteps;              // r.PlanetAtmosphere.LightSteps (full detail); per planet: A.LightSteps after LOD

// Sample distribution (Step 9). See RaymarchSchedule.ush.
int StepDistribution;        // 0 = uniform, 1 = camera-centered
float StepNearDistanceScale; // T0 of the camera-centered distribution, in cloud-layer thicknesses
float StepRatioMax;          // per-ray cap of last step / first step (camera-centered)
int JitterMode;              // 0 = off, 1 = static, 2 = animated (View.StateFrameIndex)
int EmptySpaceSkipSpan;      // 0 = off; otherwise steps covered by one coarse probe in empty space
float MinTransmittance;      // the ray stops when the transmittance drops below this

// Density LOD (Step 12): noise octaves fade at NoiseFootprintScale x the pixel footprint. With < 1, detail smaller
// than a pixel is kept and point-sampled; the per-frame sub-pixel jitter of the TSR projection
// (FViewMatrices::HackAddTemporalAAProjectionJitter) moves the sample inside the pixel, so temporal accumulation
// averages it — an unbiased pixel average instead of "average noise -> nonlinear thresholds" (clouds of distant
// planets no longer vanish or turn into haze). 1 = Phase 1 behaviour.
float NoiseFootprintScale;

// Lighting inputs that are constant along one view ray.
struct FPACloudLightingContext
{
	float3 SunDirection;
	float3 SunIlluminance;
	float3 AmbientIlluminance;
	float Phase;          // PA_CloudPhase(dot(ray, sun))
	bool bHasSun;
};

// A sample whose contribution to the pixel (transmittance before it * its opacity) is below this
// does not run the light march (Step 9 early exit; error <= this x the sample radiance).
static const float PA_MIN_LIGHTING_CONTRIBUTION = 1e-4;

// Empty-space skipping: back to coarse probes after this many consecutive empty fine samples.
static const int PA_EMPTY_SPACE_RESUME = 2;

/** Everything accumulated along one view ray (final image + debug views). */
struct FPACloudMarchState
{
	float3 Accum;            // in-scattered radiance (absolute, not pre-exposed)
	float Transmittance;     // of clouds and the placeholder surface
	float OpticalDepth;      // clouds only (Density view)
	float HeightSum;         // sum of height fraction * contribution weight (Cloud Height view)
	float HeightWeight;      // sum of contribution weights
	uint DensitySamples;     // PA_SampleCloudDensity() calls: primary + empty-space probes + light march (Ray Steps view)
};

/** Cloud density at distance T along the ray (one density call). Outputs the planet-relative position and altitude. */
float PA_SampleCloudAlongRay(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, float T,
	out float3 P, out float Altitude, inout FPACloudMarchState State)
{
	P = A.CameraRel + Ray.Dir * T;           // planet-relative, world axes
	Altitude = length(P) - A.PlanetRadius;
	const float Footprint = T * Ray.FootprintPerUnitDistance;
	State.DensitySamples += 1u;
	return PA_SampleCloudDensity(Layer, PA_ToPlanetLocal(A, P), Altitude, Footprint);
}

/** Integrates one step: sample at T representing the step width Dt. Returns the density of the sample. */
float PA_IntegrateCloudStep(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, FPACloudLightingContext Light,
	float T, float Dt,
	inout FPACloudMarchState State)
{
	float3 P;
	float Altitude;
	const float Density = PA_SampleCloudAlongRay(A, Layer, Ray, T, P, Altitude, State);
	if (Density <= 0.0)
	{
		return Density;
	}

	const float Sigma = Density * A.CloudExtinction;
	const float StepTransmittance = exp(-Sigma * Dt);
	// Energy-conserving integration over the step: S * (1 - exp(-sigma dt)) / sigma * sigma.
	const float Contribution = State.Transmittance * (1.0 - StepTransmittance);
	const float HeightFraction = saturate(PA_CloudHeightFraction(Layer, Altitude));

	// In-scattered radiance at this sample (single-scattering albedo 1).
	float3 Radiance = 0.0;
	if (Contribution > PA_MIN_LIGHTING_CONTRIBUTION)
	{
		if (Light.bHasSun)
		{
			const float Shadow = PA_PlanetShadow(P, Light.SunDirection, A.PlanetRadius);
			if (Shadow > 0.0)
			{
				const float Footprint = T * Ray.FootprintPerUnitDistance;
				const float SunTransmittance = PA_CloudSunTransmittance(A, Layer, P, Altitude, Light.SunDirection, Footprint, A.LightSteps, State.DensitySamples);
				Radiance += Light.SunIlluminance * (Light.Phase * SunTransmittance * Shadow);
			}
		}
		const float Daylight = Light.bHasSun ? PA_DaylightFactor(P, Light.SunDirection) : 1.0;
		Radiance += Light.AmbientIlluminance * ((0.5 + 0.5 * HeightFraction) * Daylight);
	}

	State.Accum += Radiance * Contribution;
	State.HeightSum += HeightFraction * Contribution;
	State.HeightWeight += Contribution;
	State.Transmittance *= StepTransmittance;
	State.OpticalDepth += Sigma * Dt;
	return Density;
}

/**
 * Marches all steps of the schedule (both segments, one loop).
 * Empty-space skipping (EmptySpaceSkipSpan > 1): while the ray is in empty space one coarse probe covers
 * EmptySpaceSkipSpan steps; if the probe finds density, the same steps are marched finely (step back).
 * After PA_EMPTY_SPACE_RESUME empty fine samples the march returns to coarse probes.
 * Note: a probe only sees one point of its span, so thin structures inside a span can be missed
 * (CPU prototype: clearly measurable loss) -> off by default.
 */
void PA_MarchClouds(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, FPACloudLightingContext Light,
	FPAMarchSchedule Sch, float Jitter,
	inout FPACloudMarchState State)
{
	const int Span = EmptySpaceSkipSpan;
	bool bCoarse = Span > 1;
	int EmptyRun = 0;
	int Bin = 0;
	const int MaxIterations = 2 * Sch.NumBins + 2;
	for (int Iteration = 0; Iteration < MaxIterations && Bin < Sch.NumBins; ++Iteration)
	{
		float T;
		float Dt;
		if (bCoarse)
		{
			const int ProbeBin = min(Bin + Span - 1, Sch.NumBins - 1);
			PA_GetMarchBin(Sch, ProbeBin, Jitter, T, Dt);
			float3 ProbeP;
			float ProbeAltitude;
			if (PA_SampleCloudAlongRay(A, Layer, Ray, T, ProbeP, ProbeAltitude, State) <= 0.0)
			{
				Bin = ProbeBin + 1;   // the whole span is treated as empty
				continue;
			}
			bCoarse = false;          // step back: march this span finely, starting at Bin
			EmptyRun = 0;
		}

		PA_GetMarchBin(Sch, Bin, Jitter, T, Dt);
		const float Density = PA_IntegrateCloudStep(A, Layer, Ray, Light, T, Dt, State);
		++Bin;

		if (State.Transmittance < MinTransmittance)
		{
			break;
		}
		if (Span > 1)
		{
			EmptyRun = Density > 0.0 ? 0 : EmptyRun + 1;
			bCoarse = EmptyRun >= PA_EMPTY_SPACE_RESUME;
		}
	}
}

/** Black -> red -> yellow -> white. */
float3 PA_HeatColor(float X)
{
	X = saturate(X);
	return float3(saturate(X * 3.0), saturate(X * 3.0 - 1.0), saturate(X * 3.0 - 2.0));
}

/** Blue (layer bottom) -> green (middle) -> red (layer top). */
float3 PA_HeightColor(float H)
{
	H = saturate(H);
	return float3(saturate(2.0 * H - 1.0), 1.0 - abs(2.0 * H - 1.0), saturate(1.0 - 2.0 * H));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	FPAPixelRay Ray;
	if (!PA_SetupPixelRay(DispatchThreadId.xy, Ray))
	{
		return;
	}
	// Footprint used for noise LOD only (density + light march). See NoiseFootprintScale.
	Ray.FootprintPerUnitDistance *= NoiseFootprintScale;

	FPACloudMarchState State;
	State.Accum = 0.0;
	State.Transmittance = 1.0;
	State.OpticalDepth = 0.0;
	State.HeightSum = 0.0;
	State.HeightWeight = 0.0;
	State.DensitySamples = 0u;

	FPACloudLightingContext Light;
	Light.SunDirection = SunDirection;
	Light.SunIlluminance = SunIlluminance;
	Light.AmbientIlluminance = AmbientIlluminance;
	Light.Phase = PA_CloudPhase(dot(Ray.Dir, SunDirection));
	Light.bHasSun = bHasSun != 0;

	// Same jitter for every planet of this pixel; animated jitter changes every frame (StateFrameIndex).
	const float Jitter = PA_GetRayJitter(Ray.Pixel, JitterMode, View.StateFrameIndex);

	for (int Index = 0; Index < NumAtmospheres && Index < PA_MAX_ATMOSPHERES; ++Index)
	{
		const FPAAtmosphere A = PA_LoadAtmosphere(Index);
		const FPACloudLayer Layer = PA_MakeCloudLayer(A);

		// The planet sphere is inside the cloud-top sphere, so missing the latter means missing everything.
		const float2 TopHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.CloudTop);
		if (TopHit.x > TopHit.y || TopHit.y <= 0.0)
		{
			continue;
		}

		// The ray ends at the scene geometry or at the planet surface, whichever is closer.
		float TMax = Ray.SceneDistance;
		bool bSurfaceVisible = false;
		float SurfaceT = 0.0;
		const float2 PlanetHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, 0.0);
		if (PlanetHit.x <= PlanetHit.y && PlanetHit.y > 0.0)
		{
			SurfaceT = max(PlanetHit.x, 0.0);
			if (SurfaceT < TMax)
			{
				TMax = SurfaceT;
				bSurfaceVisible = true;
			}
		}

		// Cloud shell segments: inside the top sphere and outside the bottom sphere.
		float Seg1Start = max(TopHit.x, 0.0);
		float Seg1End = TopHit.y;
		float Seg2Start = 0.0;
		float Seg2End = 0.0;
		const float2 BottomHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.CloudBottom);
		if (BottomHit.x <= BottomHit.y && BottomHit.y > 0.0)
		{
			// The bottom sphere is crossed ahead of the camera: [top entry, bottom entry] and [bottom exit, top exit].
			Seg1End = BottomHit.x;                  // <= 0 when the camera is below the cloud layer -> empty
			Seg2Start = max(BottomHit.y, 0.0);
			Seg2End = TopHit.y;
		}
		Seg1End = min(Seg1End, TMax);
		Seg2End = min(Seg2End, TMax);
		if (Seg1End > Seg1Start || Seg2End > Seg2Start)
		{
			const FPAMarchSchedule Schedule = PA_MakeMarchSchedule(
				Seg1Start, Seg1End, Seg2Start, Seg2End,
				A.RaymarchSteps,
				StepDistribution != 0,
				StepNearDistanceScale * Layer.Thickness,
				StepRatioMax);
			PA_MarchClouds(A, Layer, Ray, Light, Schedule, Jitter, State);
		}

		// Debug placeholder surface (behind this planet's clouds). Opaque: hides everything farther away.
		if (bSurfaceVisible && bDrawPlanetSurface != 0)
		{
			// Lambertian placeholder (dark ocean-like albedo), lit by the same sun and ambient as the clouds.
			const float3 SurfaceP = A.CameraRel + Ray.Dir * SurfaceT;
			const float3 SurfaceNormal = normalize(SurfaceP);
			const float3 SurfaceAlbedo = float3(0.04, 0.06, 0.09);
			float3 SurfaceRadiance = Light.AmbientIlluminance * (Light.bHasSun ? PA_DaylightFactor(SurfaceP, Light.SunDirection) : 1.0);
			if (Light.bHasSun)
			{
				SurfaceRadiance += Light.SunIlluminance * saturate(dot(SurfaceNormal, Light.SunDirection));
			}
			State.Accum += State.Transmittance * SurfaceAlbedo / PA_PI * SurfaceRadiance;
			State.Transmittance = 0.0;
		}

		if (State.Transmittance < MinTransmittance)
		{
			break;
		}
	}

	const float3 DarkenedScene = Ray.SceneColor.rgb * 0.15;
	const float CloudOpacity = 1.0 - exp(-State.OpticalDepth);
	float3 Result;
	if (DebugMode == 2)
	{
		// Density: optical depth of the clouds along the ray as a heat map.
		Result = DarkenedScene + PA_HeatColor(CloudOpacity);
	}
	else if (DebugMode == 3)
	{
		// Cloud Height: where inside the layer the visible cloud matter is (contribution-weighted).
		const float MeanHeight = State.HeightWeight > 1e-4 ? State.HeightSum / State.HeightWeight : 0.0;
		Result = lerp(DarkenedScene, PA_HeightColor(MeanHeight), CloudOpacity);
	}
	else if (DebugMode == 4)
	{
		// Ray Steps: density-function calls for this pixel (primary + light march), i.e. the cost map.
		// White = 64 x (1 + LightSteps) calls or more.
		const float Budget = 64.0 * (1.0 + (float)max(LightSteps, 0));
		Result = DarkenedScene + PA_HeatColor((float)State.DensitySamples / Budget);
	}
	else
	{
		// Final clouds. Scene color is pre-exposed; bring our absolute radiance into the same space.
		Result = Ray.SceneColor.rgb * State.Transmittance + State.Accum * View.PreExposure;
	}
	OutputTexture[Ray.Pixel] = float4(Result, Ray.SceneColor.a);
}
