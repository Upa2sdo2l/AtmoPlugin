// Cloud + atmosphere raymarch (r.PlanetAtmosphere.DebugMode 0 = Final, 2 = Density, 3 = Cloud Height, 4 = Ray Steps,
// 5 = Atmosphere Only, 6 = Transmittance LUT, 7 = Multiple-Scattering LUT, 9 / 10 / 11 = Shadow Cascade 0 / 1 / 2,
// 12 = Cloud Shadow Usage, 13 = Surface Cloud Shadow, 14-17 = Weather Coverage / Humidity / Wind / Temperature).
//
// For every visible atmosphere (sorted near -> far on the CPU):
//   1. intersect the ray with the cloud shell -> up to two segments (camera below / inside / above the layer),
//      clipped by the scene depth and the planet surface;
//   2. distribute RaymarchSteps over the segments (RaymarchSchedule.ush): uniform or camera-centered steps,
//      per-pixel jitter inside each step, optional empty-space skipping (Phase 2 / Step 9);
//   3. density comes ONLY from PA_SampleCloudDensity() (CloudDensity.ush, AD-1);
//   4. Beer-Lambert transmittance, energy-conserving integration over each step;
//   5. lighting (CloudLighting.ush): sun * phase * light-march transmittance * planet shadow + ambient; since Phase 4 /
//      Step 23 the light march of the primary planet's clouds is a short local march + the cloud shadow cascades
//      (CloudShadowCommon.ush), with the full light march as the fallback where no cascade texel is available;
//   6. atmosphere (AtmosphereScattering.ush, Steps 13-14) along the whole ray inside the atmosphere, split at the
//      clouds' contribution-weighted mean depth (Step 15): the part in front of the clouds attenuates them and adds
//      haze (aerial perspective), the part behind is seen through them; then the placeholder surface, whose direct
//      sunlight is shadowed by the clouds since Phase 4 / Step 24 (cascades near the camera, a march through the layer
//      where their texels are too coarse).
//   Step 15 cloud lighting with the atmosphere on: sunlight through the atmosphere (transmittance LUT, planet shadow =
//   the atmosphere's horizon) and sky ambient = Psi_ms (MS LUT) x CloudSkyAmbientScale.
// Composited front-to-back across planets; the scene behind is attenuated by the final transmittance (applied to the scene
// color by the composite pass, AtmosphereComposite.usf, since Step 17).
// Transmittance = scalar part (clouds, surface) x color part (atmospheres of the planets already composited).
// Debug views reuse exactly the same march (same density calls), they only change what is written out.

#include "/Engine/Private/Common.ush"
#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"
#include "/Plugin/PlanetAtmosphere/Private/CloudLighting.ush"
#include "/Plugin/PlanetAtmosphere/Private/RaymarchSchedule.ush"
#include "/Plugin/PlanetAtmosphere/Private/AtmosphereScattering.ush"
#include "/Plugin/PlanetAtmosphere/Private/CloudShadowCommon.ush"
#include "/Plugin/PlanetAtmosphere/Private/WeatherCommon.ush"

// Interleaved rendering (Phase 3 / Step 19): with InterleaveFactor N > 1 one thread per N x N block traces the pixel
// block * N + InterleaveOffset (clamped into the view) and writes to texel = block of the reduced outputs;
// AtmosphereTemporal.usf reconstructs the full image. N = 1: every pixel, outputs at the scene-texture pixel.
int InterleaveFactor;
int InterleaveOffsetX;
int InterleaveOffsetY;

// Outputs (Step 17), same pixel coordinates as the scene textures (N = 1). Applied by AtmosphereComposite.usf.
RWTexture2D<float4> OutLuminance;      // rgb = pre-exposed luminance added in front of the scene
RWTexture2D<float4> OutTransmittance;  // rgb = transmittance applied to the scene color

int DebugMode;               // 0 = final, 2 = density, 3 = cloud height, 4 = ray steps, 5 = atmosphere only, 6 = transmittance LUT, 7 = MS LUT,
                             // 9-11 = shadow cascade 0-2, 12 = cloud shadow usage, 13 = surface cloud shadow, 14-17 = weather views
int bDrawPlanetSurface;      // debug placeholder surface for planets without scene geometry

// Lighting (Step 7). Illuminance in lux (the Directional Light intensity x color x temperature).
float3 SunDirection;         // unit, world axes, pointing TOWARD the sun
float3 SunIlluminance;       // 0 when there is no sun
float3 AmbientIlluminance;   // sky/ambient light on the clouds
int bHasSun;
int LightSteps;              // r.PlanetAtmosphere.LightSteps (full detail); per planet: A.LightSteps after LOD

// Sample distribution (Step 9). See RaymarchSchedule.ush.
int StepDistribution;        // 0 = uniform, 1 = camera-centered
float StepNearDistanceScale; // T0 of the camera-centered distribution, in cloud-layer thicknesses
float StepRatioMax;          // per-ray cap of last step / first step (camera-centered)
int JitterMode;              // 0 = off, 1 = static, 2 = animated (View.StateFrameIndex)
int EmptySpaceSkipSpan;      // 0 = off; otherwise steps covered by one coarse probe in empty space
float MinTransmittance;      // the ray stops when the transmittance drops below this

// Density LOD (Step 12): noise octaves fade at NoiseFootprintScale x the pixel footprint. With < 1, detail smaller
// than a pixel is kept and point-sampled; the per-frame sub-pixel jitter of the TSR projection
// (FViewMatrices::HackAddTemporalAAProjectionJitter) moves the sample inside the pixel, so temporal accumulation
// averages it — an unbiased pixel average instead of "average noise -> nonlinear thresholds" (clouds of distant
// planets no longer vanish or turn into haze). 1 = Phase 1 behaviour.
float NoiseFootprintScale;

// Light-march LOD (Step 12, variant 2): per cloud sample, light steps go from the planet's LightSteps (pixel footprint
// <= LightLODFullFootprint x layer thickness) down to LightLODMinSteps (footprint >= LightLODMinFootprint x thickness),
// interpolated in log2. Self-shadow detail smaller than a pixel is not visible. LightLODEnable = 0 -> always LightSteps.
int LightLODEnable;
float LightLODFullFootprint;
float LightLODMinFootprint;
int LightLODMinSteps;

// Atmosphere (Phase 2.5 / Steps 13-14). LUT atlases, sampler and bMultipleScattering are declared in AtmosphereScattering.ush.
int bAtmosphereEnabled;      // r.PlanetAtmosphere.Atmosphere
int AtmosphereSteps;         // r.PlanetAtmosphere.Atmosphere.Steps
float CloudSkyAmbientScaleMultiplier;   // r.PlanetAtmosphere.CloudSkyAmbientScale (global x per-planet CloudSkyAmbientScale)

// Cloud shadow cascades (Phase 4, CloudShadowCommon.ush). Step 23: lighting of the primary planet's clouds.
Texture2D<float4> CloudShadowAtlas;
int CloudShadowLighting;        // r.PlanetAtmosphere.CloudShadows.Lighting: 1 = local march + cascades, 0 = full light march
int CloudShadowLocalSteps;      // r.PlanetAtmosphere.CloudShadows.LocalMarchSteps
float CloudShadowLocalLength;   // r.PlanetAtmosphere.CloudShadows.LocalMarchLength (cm)
// Step 24: cloud shadows on the placeholder surface (PA_SurfaceCloudShadow).
int CloudShadowSurface;            // r.PlanetAtmosphere.CloudShadows.Surface: 1 = on, 0 = no cloud shadows on the surface
int CloudShadowSurfaceSteps;       // r.PlanetAtmosphere.CloudShadows.SurfaceMarchSteps (minimum)
int CloudShadowSurfaceMaxSteps;    // r.PlanetAtmosphere.CloudShadows.SurfaceMarchMaxSteps (>= SurfaceSteps)
float CloudShadowSurfaceMaxStep;   // r.PlanetAtmosphere.CloudShadows.SurfaceMarchMaxStep, in units of the planet's CloudShapeScale
float CloudShadowSurfaceMaxTexel;  // r.PlanetAtmosphere.CloudShadows.SurfaceMaxTexel, in units of the planet's CloudShapeScale
int CloudShadowSurfaceJitter;      // r.PlanetAtmosphere.CloudShadows.SurfaceMarchJitter: 1 = jittered samples, 0 = step centres

// Lighting inputs that are constant along one view ray.
struct FPACloudLightingContext
{
	float3 SunDirection;
	float3 SunIlluminance;
	float3 AmbientIlluminance;
	float Phase;          // PA_CloudPhase(dot(ray, sun))
	bool bHasSun;
	float PixelFootprintPerUnitDistance;   // TRUE pixel size at distance 1 (not scaled by NoiseFootprintScale)

	// Step 15, set per planet: clouds lit through this planet's atmosphere.
	bool bAtmosphereLighting;   // sunlight through the transmittance LUT, planet shadow = the atmosphere's horizon
	bool bSkyAmbient;           // ambient = Psi_ms (needs the MS LUT) instead of AmbientIlluminance
	float SkyAmbientScale;      // temporary compensation for the missing in-cloud multiple scattering (until Phase 7)
	int PlanetIndex;
	FPAScattering Scattering;
	bool bCloudShadows;         // Step 23: this planet has cascades (primary planet) and they light its clouds
};

/** Light steps for a cloud sample at distance T out of FullSteps (light-march LOD, see LightLODEnable). */
int PA_LightStepsLOD(int FullSteps, FPACloudLayer Layer, FPACloudLightingContext Light, float T)
{
	FullSteps = max(FullSteps, 1);
	if (LightLODEnable == 0)
	{
		return FullSteps;
	}
	const int MinSteps = clamp(LightLODMinSteps, 1, FullSteps);
	const float PixelFootprint = T * Light.PixelFootprintPerUnitDistance;
	const float FullFootprint = max(LightLODFullFootprint * Layer.Thickness, 1.0);
	const float MinFootprint = max(LightLODMinFootprint * Layer.Thickness, FullFootprint * 1.01);
	const float Detail = 1.0 - saturate(log2(max(PixelFootprint, 1.0) / FullFootprint) / log2(MinFootprint / FullFootprint));
	return clamp((int)round(lerp((float)MinSteps, (float)FullSteps, Detail)), MinSteps, FullSteps);
}

/** Light steps of the full light march for a cloud sample at distance T (the planet's LightSteps after screen LOD). */
int PA_GetLightSteps(FPAAtmosphere A, FPACloudLayer Layer, FPACloudLightingContext Light, float T)
{
	return PA_LightStepsLOD(A.LightSteps, Layer, Light, T);
}

// A sample whose contribution to the pixel (transmittance before it * its opacity) is below this
// does not run the light march (Step 9 early exit; error <= this x the sample radiance).
static const float PA_MIN_LIGHTING_CONTRIBUTION = 1e-4;

// DebugMode 7: Psi_ms is radiance per unit sun illuminance (daytime ~1e-3..4e-2); scaled to be visible.
static const float PA_MS_LUT_DEBUG_SCALE = 25.0;

// Empty-space skipping: back to coarse probes after this many consecutive empty fine samples.
static const int PA_EMPTY_SPACE_RESUME = 2;

/** Everything accumulated along one view ray (final image + debug views). */
struct FPACloudMarchState
{
	float3 Accum;            // in-scattered radiance (absolute, not pre-exposed)
	float Transmittance;     // of clouds and the placeholder surface
	float3 AtmosphereTransmittance;   // of the atmospheres composited so far (nearer planets); colors everything behind
	float OpticalDepth;      // clouds only (Density view)
	float HeightSum;         // sum of height fraction * contribution weight (Cloud Height view)
	float HeightWeight;      // sum of contribution weights
	float DepthSum;          // sum of distance * contribution weight, current planet only (Step 15 atmosphere split)
	float DepthWeight;       // sum of contribution weights, current planet only
	uint DensitySamples;     // PA_SampleCloudDensity() calls: primary + empty-space probes + light march (Ray Steps view)
	uint ShadowCascadeSamples;    // lit samples lit through the cascades (Cloud Shadow Usage view)
	uint ShadowFallbackSamples;   // lit samples of the primary planet that needed the full light march
	// Step 24, the visible surface point of this pixel (debug views 12 / 13).
	float SurfaceCloudShadow;     // cloud transmittance of its sun path; -1 = no surface, -2 = surface without direct sun
	float SurfaceShadowMarchWeight;   // 0 = cascades, 1 = march through the layer, between = blend band at a window edge
	uint SurfaceShadowMissing;    // 1 = the cascade texels were not generated yet (march instead)
};

/** Cloud density at distance T along the ray (one density call). Outputs the planet-relative position and altitude. */
float PA_SampleCloudAlongRay(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, float T,
	out float3 P, out float Altitude, inout FPACloudMarchState State)
{
	P = A.CameraRel + Ray.Dir * T;           // planet-relative, world axes
	Altitude = length(P) - A.PlanetRadius;
	const float Footprint = T * Ray.FootprintPerUnitDistance;
	State.DensitySamples += 1u;
	return PA_SampleCloudDensity(Layer, PA_ToPlanetLocal(A, P), Altitude, Footprint);
}

/**
 * Phase 4 / Step 23 (hybrid, AD-25): sunlight transmittance at P = short local march (CloudShadowLocalSteps samples over
 * at most CloudShadowLocalLength toward the sun: fine self-shadowing, cloud edges) x the cascades from the end of that
 * march on (long sun paths). Returns -1 if the cascades cannot serve P (outside every window, tile not generated yet).
 * The lookup comes first (4 texel loads, no density samples), so a fallback sample does not pay for the local march
 * and a sample shadowed from farther away skips it. The local march uses the same pixel-footprint LOD as the full light
 * march (r.PlanetAtmosphere.LightLOD: self-shadow detail smaller than a pixel is invisible; UE measurement: with fixed
 * steps the hybrid cost more in orbit than the old LOD'd march).
 */
float PA_CloudSunTransmittanceHybrid(
	FPAAtmosphere A, FPACloudLayer Layer, FPACloudLightingContext Light, float3 P, float Altitude, float T, float Footprint,
	inout uint NumDensitySamples)
{
	const float LocalLength = PA_CloudSunMarchLength(A, P, Altitude, Light.SunDirection, CloudShadowLocalLength);
	const float3 Q = P + Light.SunDirection * LocalLength;
	const float CascadeTransmittance = PA_CloudShadowTransmittance(
		CloudShadowAtlas, PA_ToPlanetLocal(A, Q), A.PlanetRadius, A.CloudBottom, A.CloudTop);
	if (CascadeTransmittance < 0.0)
	{
		return -1.0;
	}
	if (CascadeTransmittance <= 1e-6)
	{
		return 0.0;   // fully shadowed from farther away: the local march cannot change it
	}
	const float LocalOpticalDepth = PA_CloudSunOpticalDepth(
		A, Layer, P, Light.SunDirection, Footprint, PA_LightStepsLOD(CloudShadowLocalSteps, Layer, Light, T), LocalLength,
		NumDensitySamples);
	return exp(-LocalOpticalDepth) * CascadeTransmittance;
}

/**
 * Phase 4 / Step 24 (AD-27): cloud transmittance of the sun path from the surface point P (planet-relative, world axes,
 * altitude 0) at view distance T. Primary planet: the cascades where their texel is at most CloudShadowSurfaceMaxTexel x
 * the shape scale, the march through the whole layer crossing elsewhere, blended over the last tile of the last usable
 * window (PA_CloudShadowSurfaceTransmittance); other planets and texels not generated yet: the march, steps of at most
 * CloudShadowSurfaceMaxStep x the shape scale (CloudShadowSurfaceSteps..CloudShadowSurfaceMaxSteps), jittered per pixel.
 * Prototype p24b (pixel-averaged mean |dT| x 100, 12 scenes from the ground to 2000 km): cascades only 0.5-27,
 * this rule with 12 steps 0.5-3.5.
 */
float PA_SurfaceCloudShadow(FPAAtmosphere A, FPACloudLayer Layer, int Index, float3 P, float T, FPAPixelRay Ray, float3 Sun,
	float Jitter, inout FPACloudMarchState State)
{
	State.SurfaceShadowMarchWeight = 1.0;
	State.SurfaceShadowMissing = 0u;
	if (Layer.Coverage <= 0.0)
	{
		return 1.0;   // exactly no clouds (CloudDensity.ush)
	}
	// Step 25: front set, during a crossfade also the back set (each with its own march weight); the march runs once if
	// either needs it.
	float FrontWeight = 1.0;
	float BackWeight = 1.0;
	float FrontTransmittance = -1.0;
	float BackTransmittance = -1.0;
	const bool bCrossfade = Index == CloudShadowPlanet && CloudShadowBlend > 0.0;
	if (Index == CloudShadowPlanet)
	{
		const float3 PLocal = PA_ToPlanetLocal(A, P);
		const float MaxTexel = CloudShadowSurfaceMaxTexel * Layer.ShapeScale;
		bool bFrontMissing;
		FrontTransmittance = PA_CloudShadowSurfaceTransmittance(CloudShadowAtlas, CloudShadowFrontBase, PLocal, A.PlanetRadius,
			A.CloudBottom, A.CloudTop, MaxTexel, FrontWeight, bFrontMissing);
		State.SurfaceShadowMissing = bFrontMissing ? 1u : 0u;
		if (bCrossfade)
		{
			bool bBackMissing;
			BackTransmittance = PA_CloudShadowSurfaceTransmittance(CloudShadowAtlas, CloudShadowBackBase, PLocal, A.PlanetRadius,
				A.CloudBottom, A.CloudTop, MaxTexel, BackWeight, bBackMissing);
		}
	}
	State.SurfaceShadowMarchWeight = bCrossfade ? lerp(FrontWeight, BackWeight, CloudShadowBlend) : FrontWeight;
	float MarchTransmittance = 1.0;
	if (FrontWeight > 0.0 || (bCrossfade && BackWeight > 0.0))
	{
		MarchTransmittance = exp(-PA_CloudLayerCrossingOpticalDepth(
			A, Layer, P, 0.0, Sun, T * Ray.FootprintPerUnitDistance, CloudShadowSurfaceSteps, CloudShadowSurfaceMaxSteps,
			CloudShadowSurfaceMaxStep * Layer.ShapeScale, CloudShadowSurfaceJitter != 0 ? Jitter : 0.5, State.DensitySamples));
	}
	const float Front = FrontWeight >= 1.0 ? MarchTransmittance : lerp(FrontTransmittance, MarchTransmittance, FrontWeight);
	if (!bCrossfade)
	{
		return Front;
	}
	const float Back = BackWeight >= 1.0 ? MarchTransmittance : lerp(BackTransmittance, MarchTransmittance, BackWeight);
	return lerp(Front, Back, CloudShadowBlend);
}

/** Integrates one step: sample at T representing the step width Dt. Returns the density of the sample. */
float PA_IntegrateCloudStep(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, FPACloudLightingContext Light,
	float T, float Dt,
	inout FPACloudMarchState State)
{
	float3 P;
	float Altitude;
	const float Density = PA_SampleCloudAlongRay(A, Layer, Ray, T, P, Altitude, State);
	if (Density <= 0.0)
	{
		return Density;
	}

	const float Sigma = Density * A.CloudExtinction;
	const float StepTransmittance = exp(-Sigma * Dt);
	// Energy-conserving integration over the step: S * (1 - exp(-sigma dt)) / sigma * sigma.
	const float Contribution = State.Transmittance * (1.0 - StepTransmittance);
	const float HeightFraction = saturate(PA_CloudHeightFraction(Layer, Altitude));

	// In-scattered radiance at this sample (single-scattering albedo 1).
	float3 Radiance = 0.0;
	if (Contribution > PA_MIN_LIGHTING_CONTRIBUTION)
	{
		// Step 15: altitude above the atmosphere bottom and sun cos zenith for the atmosphere LUTs. Cloud samples above
		// the medium's effective top are clamped onto it (the LUTs clamp H): negligible air above.
		const float AtmosphereH = Altitude - Light.Scattering.BottomAltitude;
		const float SunMu = dot(P, Light.SunDirection) / max(length(P), 1.0);

		if (Light.bHasSun)
		{
			// Sun visibility: through the atmosphere (LUT x the atmosphere's horizon), else the Step 7 soft planet shadow.
			float3 SunVisibility;
			if (Light.bAtmosphereLighting)
			{
				SunVisibility = PA_AtmosphereSunTransmittance(Light.PlanetIndex, Light.Scattering, AtmosphereH, SunMu);
			}
			else
			{
				SunVisibility = PA_PlanetShadow(P, Light.SunDirection, A.PlanetRadius);
			}
			// The light march only runs where the sun is visible at all (night side: skipped).
			if (max(SunVisibility.r, max(SunVisibility.g, SunVisibility.b)) > 1e-4)
			{
				const float Footprint = T * Ray.FootprintPerUnitDistance;
				float SunTransmittance = -1.0;
				if (Light.bCloudShadows)
				{
					SunTransmittance = PA_CloudSunTransmittanceHybrid(A, Layer, Light, P, Altitude, T, Footprint, State.DensitySamples);
					State.ShadowCascadeSamples += SunTransmittance >= 0.0 ? 1u : 0u;
					State.ShadowFallbackSamples += SunTransmittance >= 0.0 ? 0u : 1u;
				}
				if (SunTransmittance < 0.0)
				{
					SunTransmittance = PA_CloudSunTransmittance(A, Layer, P, Altitude, Light.SunDirection, Footprint, PA_GetLightSteps(A, Layer, Light, T), State.DensitySamples);
				}
				Radiance += Light.SunIlluminance * SunVisibility * (Light.Phase * SunTransmittance);
			}
		}

		if (Light.bSkyAmbient)
		{
			// Sky ambient: Psi_ms = mean sky radiance around the point (sun illuminance 1), colored by the atmosphere,
			// dark at night; x SkyAmbientScale (temporary compensation until Phase 7, see CloudSkyAmbientScale).
			Radiance += Light.SunIlluminance * PA_SampleMultipleScatteringLut(Light.PlanetIndex, Light.Scattering, AtmosphereH, SunMu)
				* ((0.5 + 0.5 * HeightFraction) * Light.SkyAmbientScale);
		}
		else
		{
			const float Daylight = Light.bHasSun ? PA_DaylightFactor(P, Light.SunDirection) : 1.0;
			Radiance += Light.AmbientIlluminance * ((0.5 + 0.5 * HeightFraction) * Daylight);
		}
	}

	State.Accum += Radiance * (Contribution * State.AtmosphereTransmittance);
	State.HeightSum += HeightFraction * Contribution;
	State.HeightWeight += Contribution;
	State.DepthSum += T * Contribution;
	State.DepthWeight += Contribution;
	State.Transmittance *= StepTransmittance;
	State.OpticalDepth += Sigma * Dt;
	return Density;
}

/**
 * Marches all steps of the schedule (both segments, one loop).
 * Empty-space skipping (EmptySpaceSkipSpan > 1): while the ray is in empty space one coarse probe covers
 * EmptySpaceSkipSpan steps; if the probe finds density, the same steps are marched finely (step back).
 * After PA_EMPTY_SPACE_RESUME empty fine samples the march returns to coarse probes.
 * Note: a probe only sees one point of its span, so thin structures inside a span can be missed
 * (CPU prototype: clearly measurable loss) -> off by default.
 */
void PA_MarchClouds(
	FPAAtmosphere A, FPACloudLayer Layer, FPAPixelRay Ray, FPACloudLightingContext Light,
	FPAMarchSchedule Sch, float Jitter,
	inout FPACloudMarchState State)
{
	const int Span = EmptySpaceSkipSpan;
	bool bCoarse = Span > 1;
	int EmptyRun = 0;
	int Bin = 0;
	const int MaxIterations = 2 * Sch.NumBins + 2;
	for (int Iteration = 0; Iteration < MaxIterations && Bin < Sch.NumBins; ++Iteration)
	{
		float T;
		float Dt;
		if (bCoarse)
		{
			const int ProbeBin = min(Bin + Span - 1, Sch.NumBins - 1);
			PA_GetMarchBin(Sch, ProbeBin, Jitter, T, Dt);
			float3 ProbeP;
			float ProbeAltitude;
			if (PA_SampleCloudAlongRay(A, Layer, Ray, T, ProbeP, ProbeAltitude, State) <= 0.0)
			{
				Bin = ProbeBin + 1;   // the whole span is treated as empty
				continue;
			}
			bCoarse = false;          // step back: march this span finely, starting at Bin
			EmptyRun = 0;
		}

		PA_GetMarchBin(Sch, Bin, Jitter, T, Dt);
		const float Density = PA_IntegrateCloudStep(A, Layer, Ray, Light, T, Dt, State);
		++Bin;

		if (State.Transmittance < MinTransmittance)
		{
			break;
		}
		if (Span > 1)
		{
			EmptyRun = Density > 0.0 ? 0 : EmptyRun + 1;
			bCoarse = EmptyRun >= PA_EMPTY_SPACE_RESUME;
		}
	}
}

/** Black -> red -> yellow -> white. */
float3 PA_HeatColor(float X)
{
	X = saturate(X);
	return float3(saturate(X * 3.0), saturate(X * 3.0 - 1.0), saturate(X * 3.0 - 2.0));
}

/** Blue (layer bottom) -> green (middle) -> red (layer top). */
float3 PA_HeightColor(float H)
{
	H = saturate(H);
	return float3(saturate(2.0 * H - 1.0), 1.0 - abs(2.0 * H - 1.0), saturate(1.0 - 2.0 * H));
}

/** Piecewise-linear colour ramp through 5 stops (X0 < X1 < X2 < X3 < X4), clamped at both ends. */
float3 PA_Ramp5(float X, float X0, float X1, float X2, float X3, float X4, float3 C0, float3 C1, float3 C2, float3 C3, float3 C4)
{
	if (X <= X1)
	{
		return lerp(C0, C1, saturate((X - X0) / (X1 - X0)));
	}
	if (X <= X2)
	{
		return lerp(C1, C2, (X - X1) / (X2 - X1));
	}
	if (X <= X3)
	{
		return lerp(C2, C3, (X - X2) / (X3 - X2));
	}
	return lerp(C3, C4, saturate((X - X3) / (X4 - X3)));
}

/**
 * DebugMode 16 (Step 28): is Direction (planet local, unit) on the arrow of its 5-degree cell? Cells: latitude bands of
 * 5 deg, each split into round(72 cos(band latitude)) longitude cells (about square). The arrow is centred on the cell
 * centre, points downwind (wind sampled at the centre), half length 0.45 x cell x clamp(speed / 25 m/s, 0.25, 1), with a
 * head over its last 40 %; a dot where the wind is below 1 m/s. PixelDeg keeps the lines at least a pixel wide.
 */
bool PA_WindArrow(int Index, float3 Direction, float PixelDeg)
{
	const float CellDeg = 5.0;
	const float ToDeg = 180.0 / PA_PI;
	const float LatitudeDeg = asin(clamp(Direction.z, -1.0, 1.0)) * ToDeg;
	const float LongitudeDeg = atan2(Direction.y, Direction.x) * ToDeg;
	const float CentreLatDeg = -90.0 + (floor((LatitudeDeg + 90.0) / CellDeg) + 0.5) * CellDeg;
	const float NumCells = max(1.0, round(360.0 / CellDeg * cos(CentreLatDeg / ToDeg)));
	const float CellLonDeg = 360.0 / NumCells;
	const float CentreLonDeg = -180.0 + (floor((LongitudeDeg + 180.0) / CellLonDeg) + 0.5) * CellLonDeg;

	const float CentreLat = CentreLatDeg / ToDeg;
	const float CentreLon = CentreLonDeg / ToDeg;
	const float3 Centre = float3(cos(CentreLat) * cos(CentreLon), cos(CentreLat) * sin(CentreLon), sin(CentreLat));
	const float3 East = float3(-sin(CentreLon), cos(CentreLon), 0.0);
	const float3 North = cross(Centre, East);
	const float2 Offset = float2(dot(Direction, East), dot(Direction, North)) * ToDeg;   // degrees of arc from the centre

	const float2 Wind = PA_SampleWeather(Index, Centre).zw;
	const float Speed = length(Wind);
	const float Width = max(0.05 * CellDeg, PixelDeg);
	if (Speed < 1.0)
	{
		return length(Offset) < 2.0 * Width;
	}
	const float2 Downwind = Wind / Speed;
	const float HalfLength = 0.45 * CellDeg * clamp(Speed / 25.0, 0.25, 1.0);
	const float Along = dot(Offset, Downwind);
	const float Across = abs(Offset.x * Downwind.y - Offset.y * Downwind.x);
	const bool bShaft = abs(Along) <= HalfLength && Across <= Width;
	const float HeadLength = 0.4 * HalfLength;
	const bool bHead = Along >= HalfLength - HeadLength && Along <= HalfLength && Across <= (HalfLength - Along) * 0.7 + 0.5 * Width;
	return bShaft || bHead;
}

/**
 * Weather debug views (Phase 5): the weather of the nearest planet on the sphere in the middle of its cloud layer, unlit.
 *  14 (Step 27) cloud water: dark blue = 0 .. white = 1
 *  15 (Step 28) effective relative humidity: brown 0, tan 0.4, pale green 0.6, blue 0.8, deep blue 1
 *  16 (Step 28) wind speed: dark blue 0, teal 10, yellow-green 20, orange 30, red 40 m/s + white arrows downwind (PA_WindArrow)
 *  17 (Step 28) zonal temperature: blue -40 C, light blue -10, white 0, yellow 15, red 35 C; isotherms every 10 C (0 C black)
 * Latitude lines every 30 deg (equator orange); magenta checker = this planet has no weather this frame. Returns false
 * where the ray misses every such sphere (or scene geometry is closer): the caller then shows the darkened image.
 */
bool PA_WeatherDebugView(FPAPixelRay Ray, int Mode, out float3 Luminance)
{
	Luminance = 0.0;
	for (int Index = 0; Index < NumAtmospheres && Index < PA_MAX_ATMOSPHERES; ++Index)
	{
		const FPAAtmosphere A = PA_LoadAtmosphere(Index);
		const float MidAltitude = 0.5 * (A.CloudBottom + A.CloudTop);
		const float2 Hit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, MidAltitude);
		if (Hit.x > Hit.y || Hit.y <= 0.0)
		{
			continue;
		}
		const float T = Hit.x > 0.0 ? Hit.x : Hit.y;   // from below the sphere: the layer overhead
		if (T > Ray.SceneDistance)
		{
			continue;
		}
		const float3 Local = PA_ToPlanetLocal(A, A.CameraRel + Ray.Dir * T);
		const float3 Direction = normalize(Local);
		const float Latitude = asin(clamp(Direction.z, -1.0, 1.0));
		const float LatitudeDeg = Latitude * (180.0 / PA_PI);
		const float PixelDeg = Ray.FootprintPerUnitDistance * T / max(A.PlanetRadius + MidAltitude, 1.0) * (180.0 / PA_PI);
		if (PA_HasWeather(Index))
		{
			const float4 Weather = PA_SampleWeather(Index, Direction);
			if (Mode == 15)
			{
				Luminance = PA_Ramp5(Weather.y, 0.0, 0.4, 0.6, 0.8, 1.0,
					float3(0.45, 0.28, 0.10), float3(0.85, 0.75, 0.50), float3(0.75, 0.90, 0.75), float3(0.30, 0.60, 0.90), float3(0.05, 0.15, 0.60));
			}
			else if (Mode == 16)
			{
				Luminance = PA_Ramp5(length(Weather.zw), 0.0, 10.0, 20.0, 30.0, 40.0,
					float3(0.02, 0.04, 0.15), float3(0.0, 0.45, 0.50), float3(0.60, 0.75, 0.10), float3(0.95, 0.50, 0.05), float3(0.80, 0.05, 0.05));
				if (PA_WindArrow(Index, Direction, PixelDeg))
				{
					Luminance = 1.0;
				}
			}
			else if (Mode == 17)
			{
				const float4 Climate = AtmosphereWeatherClimate[Index];
				const float CelsiusTemperature = PA_WeatherTemperature(Latitude, Climate.z, Climate.x, Climate.y) - 273.15;
				Luminance = PA_Ramp5(CelsiusTemperature, -40.0, -10.0, 0.0, 15.0, 35.0,
					float3(0.10, 0.20, 0.80), float3(0.50, 0.75, 1.00), float3(0.95, 0.95, 0.95), float3(1.00, 0.85, 0.40), float3(0.80, 0.10, 0.05));
				// Isotherms: |T - nearest multiple of 10| below the temperature change across one pixel.
				const float KelvinPerDegree = abs(Climate.y * sin(2.0 * (Latitude - 0.8 * Climate.z))) * (PA_PI / 180.0);
				const float Isotherm = round(CelsiusTemperature / 10.0);
				if (abs(CelsiusTemperature - 10.0 * Isotherm) < max(KelvinPerDegree * PixelDeg, 0.02))
				{
					Luminance = abs(Isotherm) < 0.5 ? 0.0 : 0.25;
				}
			}
			else
			{
				Luminance = lerp(float3(0.02, 0.04, 0.15), float3(1.0, 1.0, 1.0), saturate(Weather.x));
			}
		}
		else
		{
			const float2 Cell = floor(float2(atan2(Direction.y, Direction.x), Latitude) * (36.0 / PA_PI));
			Luminance = fmod(abs(Cell.x + Cell.y), 2.0) > 0.5 ? float3(1.0, 0.0, 1.0) : float3(0.25, 0.0, 0.25);
		}

		// Latitude lines every 30 deg, about one pixel wide at any distance.
		const float LineDistance = abs(LatitudeDeg - 30.0 * round(LatitudeDeg / 30.0));
		if (LineDistance < max(PixelDeg, 0.05))
		{
			Luminance = abs(LatitudeDeg) < 15.0 ? float3(1.0, 0.45, 0.0) : float3(0.5, 0.5, 0.5);
		}
		return true;
	}
	return false;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int Factor = max(InterleaveFactor, 1);
	const uint2 Block = DispatchThreadId.xy;
	if (Block.x * (uint)Factor >= (uint)ViewRectMinAndSize.z || Block.y * (uint)Factor >= (uint)ViewRectMinAndSize.w)
	{
		return;
	}
	const uint2 LocalPixel = min(Block * (uint)Factor + uint2(InterleaveOffsetX, InterleaveOffsetY), (uint2)ViewRectMinAndSize.zw - 1u);

	FPAPixelRay Ray;
	if (!PA_SetupPixelRay(LocalPixel, Ray))
	{
		return;
	}
	const uint2 OutputTexel = Factor == 1 ? Ray.Pixel : Block;

	// Weather views (Steps 27-28): no march, the weather atlas only (never temporally accumulated: Factor = 1).
	if (DebugMode >= 14 && DebugMode <= 17)
	{
		float3 WeatherLuminance;
		const bool bWeatherHit = PA_WeatherDebugView(Ray, DebugMode, WeatherLuminance);
		OutLuminance[OutputTexel] = float4(WeatherLuminance, -1.0);
		OutTransmittance[OutputTexel] = float4(bWeatherHit ? 0.0 : 0.25, bWeatherHit ? 0.0 : 0.25, bWeatherHit ? 0.0 : 0.25, (float)PA_REPROJ_NO_PLANET);
		return;
	}
	// Footprint used for noise LOD only (density + light march). See NoiseFootprintScale.
	const float PixelFootprintPerUnitDistance = Ray.FootprintPerUnitDistance;
	Ray.FootprintPerUnitDistance *= NoiseFootprintScale;

	FPACloudMarchState State;
	State.Accum = 0.0;
	State.Transmittance = 1.0;
	State.AtmosphereTransmittance = 1.0;
	State.OpticalDepth = 0.0;
	State.HeightSum = 0.0;
	State.HeightWeight = 0.0;
	State.DepthSum = 0.0;
	State.DepthWeight = 0.0;
	State.DensitySamples = 0u;
	State.ShadowCascadeSamples = 0u;
	State.ShadowFallbackSamples = 0u;
	State.SurfaceCloudShadow = -1.0;
	State.SurfaceShadowMarchWeight = 1.0;
	State.SurfaceShadowMissing = 0u;

	FPACloudLightingContext Light;
	Light.SunDirection = SunDirection;
	Light.SunIlluminance = SunIlluminance;
	Light.AmbientIlluminance = AmbientIlluminance;
	Light.Phase = PA_CloudPhase(dot(Ray.Dir, SunDirection));
	Light.bHasSun = bHasSun != 0;
	Light.PixelFootprintPerUnitDistance = PixelFootprintPerUnitDistance;
	Light.bAtmosphereLighting = false;
	Light.bSkyAmbient = false;
	Light.SkyAmbientScale = 0.0;
	Light.PlanetIndex = 0;
	Light.Scattering = (FPAScattering)0;
	Light.bCloudShadows = false;

	// Same jitter for every planet of this pixel; animated jitter changes every frame (StateFrameIndex).
	// Interleaved (N > 1): the noise is evaluated on the BLOCK coordinate. Evaluated at the traced pixel it is sampled on a
	// lattice of stride N, where the interleaved gradient noise aliases into a near-linear phase field (N = 3: phase step
	// 0.667 per block in x, 0.928 in y), and since its animation is a translation, every pixel pair keeps the same jitter
	// difference forever: the step-position error of the 16 raymarch steps stays as persistent screen-space stripes, and
	// on far clouds the stripe pattern crawls frame to frame (UE test after Step 22; simulation s22_stripes.py: share of the
	// residual at low frequency 17.7 % -> 5.5 %, N = 1 has 1.3 %). On the block lattice the noise keeps its designed
	// high-frequency structure; N = 1 is unchanged.
	const float Jitter = PA_GetRayJitter(Factor > 1 ? Block : Ray.Pixel, JitterMode, View.StateFrameIndex);

	// Step 18: reprojection depth of this pixel for the temporal pass (prototype variant "D3"): the first planet
	// (near -> far) whose clouds are visibly there -> their contribution-weighted depth, or whose surface is hit -> the
	// surface; otherwise the scene geometry; otherwise the middle of the first atmosphere crossed; otherwise infinity.
	float ReprojDepth = -1.0;
	int ReprojPlanet = PA_REPROJ_NO_PLANET;
	bool bReprojFound = false;
	float AtmosphereDepth = -1.0;
	int AtmospherePlanet = PA_REPROJ_NO_PLANET;

	const bool bCloudDebugView = DebugMode >= 2 && DebugMode <= 4;
	const bool bDrawClouds = DebugMode != 5;
	const bool bDrawAtmosphere = bAtmosphereEnabled != 0 && !bCloudDebugView;

	for (int Index = 0; Index < NumAtmospheres && Index < PA_MAX_ATMOSPHERES; ++Index)
	{
		const FPAAtmosphere A = PA_LoadAtmosphere(Index);
		const FPACloudLayer Layer = PA_MakeCloudLayer(A);

		// Every shell of the planet is inside the atmosphere-top sphere, so missing it means missing everything.
		const float2 AtmosphereHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.AtmosphereTop);
		if (AtmosphereHit.x > AtmosphereHit.y || AtmosphereHit.y <= 0.0)
		{
			continue;
		}

		// The ray ends at the scene geometry or at the planet surface, whichever is closer.
		float TMax = Ray.SceneDistance;
		bool bSurfaceVisible = false;
		float SurfaceT = 0.0;
		const float2 PlanetHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, 0.0);
		if (PlanetHit.x <= PlanetHit.y && PlanetHit.y > 0.0)
		{
			SurfaceT = max(PlanetHit.x, 0.0);
			if (SurfaceT < TMax)
			{
				TMax = SurfaceT;
				bSurfaceVisible = true;
			}
		}

		const float2 TopHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.CloudTop);
		const bool bCloudShellHit = bDrawClouds && TopHit.x <= TopHit.y && TopHit.y > 0.0;

		// Step 15: this planet's atmosphere lights its clouds (in every view mode, so the cloud debug views keep
		// the same light-march gating as the final image).
		const FPAScattering Scattering = PA_LoadScattering(Index);
		Light.PlanetIndex = Index;
		Light.Scattering = Scattering;
		Light.bAtmosphereLighting = bAtmosphereEnabled != 0;
		// Without a Directional Light there is no sky: the neutral fallback ambient (AmbientIlluminance) stays.
		Light.bSkyAmbient = bAtmosphereEnabled != 0 && bMultipleScattering != 0 && Light.bHasSun;
		Light.SkyAmbientScale = A.CloudSkyAmbientScale * CloudSkyAmbientScaleMultiplier;
		Light.bCloudShadows = CloudShadowLighting != 0 && Index == CloudShadowPlanet;

		// Radiance of this planet's clouds is collected separately, so the atmosphere in front of them can attenuate it.
		const float3 AccumBeforeClouds = State.Accum;
		const float TransmittanceBeforeClouds = State.Transmittance;
		const float OpticalDepthBeforeClouds = State.OpticalDepth;
		State.DepthSum = 0.0;
		State.DepthWeight = 0.0;

		// Cloud shell segments: inside the top sphere and outside the bottom sphere.
		float Seg1Start = max(TopHit.x, 0.0);
		float Seg1End = TopHit.y;
		float Seg2Start = 0.0;
		float Seg2End = 0.0;
		const float2 BottomHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude, A.CloudBottom);
		if (BottomHit.x <= BottomHit.y && BottomHit.y > 0.0)
		{
			// The bottom sphere is crossed ahead of the camera: [top entry, bottom entry] and [bottom exit, top exit].
			Seg1End = BottomHit.x;                  // <= 0 when the camera is below the cloud layer -> empty
			Seg2Start = max(BottomHit.y, 0.0);
			Seg2End = TopHit.y;
		}
		Seg1End = min(Seg1End, TMax);
		Seg2End = min(Seg2End, TMax);
		if (bCloudShellHit && (Seg1End > Seg1Start || Seg2End > Seg2Start))
		{
			const FPAMarchSchedule Schedule = PA_MakeMarchSchedule(
				Seg1Start, Seg1End, Seg2Start, Seg2End,
				A.RaymarchSteps,
				StepDistribution != 0,
				StepNearDistanceScale * Layer.Thickness,
				StepRatioMax);
			PA_MarchClouds(A, Layer, Ray, Light, Schedule, Jitter, State);
		}

		if (!bReprojFound)
		{
			const float PlanetCloudOpacity = 1.0 - exp(-(State.OpticalDepth - OpticalDepthBeforeClouds));
			if (PlanetCloudOpacity > PA_REPROJ_MIN_CLOUD_OPACITY && State.DepthWeight > 1e-6)
			{
				ReprojDepth = State.DepthSum / State.DepthWeight;
				ReprojPlanet = Index;
				bReprojFound = true;
			}
			else if (bSurfaceVisible)
			{
				ReprojDepth = SurfaceT;
				ReprojPlanet = Index;
				bReprojFound = true;
			}
			else if (AtmospherePlanet == PA_REPROJ_NO_PLANET && bDrawAtmosphere)
			{
				// Middle of the part of the ray inside this planet's effective medium (Step 13 effective top).
				const float2 MediumHit = PA_RaySphereIntersect(A.CameraRel, Ray.Dir, A.PlanetRadius, A.CameraAltitude,
					Scattering.BottomAltitude + Scattering.Thickness);
				const float MediumStart = max(MediumHit.x, 0.0);
				const float MediumEnd = min(MediumHit.y, TMax);
				if (MediumHit.x <= MediumHit.y && MediumEnd > MediumStart)
				{
					AtmosphereDepth = 0.5 * (MediumStart + MediumEnd);
					AtmospherePlanet = Index;
				}
			}
		}

		// Atmosphere (Steps 13-15), split at the clouds' contribution-weighted mean depth (no clouds: all in front).
		//   front: [camera, split]  -> added in front of the clouds, attenuates them (aerial perspective)
		//   back:  [split, TMax]    -> seen through the clouds and through the front part
		if (bDrawAtmosphere)
		{
			const float SplitT = State.DepthWeight > 1e-6 ? State.DepthSum / State.DepthWeight : PA_INFINITY;
			FPAAtmosphereSegment Front;
			FPAAtmosphereSegment Back;
			PA_IntegrateAtmosphereSplit(
				Index, A, Scattering, Ray.Dir, TMax, SplitT, AtmosphereSteps,
				Light.SunDirection, Light.SunIlluminance, Light.bHasSun, Front, Back);
			const float3 CloudRadiance = State.Accum - AccumBeforeClouds;   // already x transmittance of nearer planets
			State.Accum = AccumBeforeClouds
				+ Front.Luminance * (TransmittanceBeforeClouds * State.AtmosphereTransmittance)
				+ CloudRadiance * Front.Transmittance
				+ Back.Luminance * (State.Transmittance * State.AtmosphereTransmittance * Front.Transmittance);
			State.AtmosphereTransmittance *= Front.Transmittance * Back.Transmittance;
		}

		// Debug placeholder surface (behind this planet's clouds and atmosphere). Opaque: hides everything farther away.
		if (bSurfaceVisible && bDrawPlanetSurface != 0)
		{
			// Lambertian placeholder (albedo = component SurfaceAlbedo), lit by the sun and the cloud ambient.
			const float3 SurfaceP = A.CameraRel + Ray.Dir * SurfaceT;
			const float3 SurfaceNormal = normalize(SurfaceP);
			const float3 SurfaceAlbedo = AtmosphereSurface[Index].xyz;
			float3 SurfaceRadiance = Light.AmbientIlluminance * (Light.bHasSun ? PA_DaylightFactor(SurfaceP, Light.SunDirection) : 1.0);
			const float3 SurfaceVisibility = State.Transmittance * State.AtmosphereTransmittance;
			State.SurfaceCloudShadow = -2.0;
			if (Light.bHasSun)
			{
				const float SunCos = dot(SurfaceNormal, Light.SunDirection);
				float3 SunAtSurface = Light.SunIlluminance;
				if (bDrawAtmosphere)
				{
					// Sunlight reaching the ground through the atmosphere (reddened near the terminator).
					// The surface is at or below the atmosphere bottom -> LUT at H = 0.
					SunAtSurface *= PA_SampleTransmittanceLut(Index, Scattering, 0.0, SunCos);
				}
				// Step 24: shadows of this planet's clouds on the direct sunlight (ambient / sky light unchanged until Phase 7).
				// Only where the sun is above the horizon and the surface is visible at all (debug view 13: always).
				if (SunCos > 0.0 && CloudShadowSurface != 0 && bDrawClouds
					&& (max(SurfaceVisibility.r, max(SurfaceVisibility.g, SurfaceVisibility.b)) > PA_MIN_LIGHTING_CONTRIBUTION || DebugMode == 13))
				{
					State.SurfaceCloudShadow = PA_SurfaceCloudShadow(A, Layer, Index, SurfaceP, SurfaceT, Ray, Light.SunDirection, Jitter, State);
					SunAtSurface *= State.SurfaceCloudShadow;
				}
				SurfaceRadiance += SunAtSurface * saturate(SunCos);
			}
			State.Accum += SurfaceVisibility * SurfaceAlbedo / PA_PI * SurfaceRadiance;
			State.Transmittance = 0.0;
		}

		if (State.Transmittance < MinTransmittance)
		{
			break;
		}
	}

	if (!bReprojFound)
	{
		if (Ray.SceneDistance < PA_INFINITY)
		{
			ReprojDepth = Ray.SceneDistance;
			ReprojPlanet = PA_REPROJ_NO_PLANET;   // scene geometry: camera motion only
		}
		else if (AtmospherePlanet != PA_REPROJ_NO_PLANET)
		{
			ReprojDepth = AtmosphereDepth;
			ReprojPlanet = AtmospherePlanet;
		}
	}
	const float ReprojDepthKm = (ReprojDepth >= 0.0 && ReprojDepth * 1e-5 < PA_REPROJ_MAX_DEPTH_KM) ? ReprojDepth * 1e-5 : -1.0;

	// Step 17: the scene color is not read here. Every mode is written as luminance + transmittance, and
	// AtmosphereComposite.usf produces  final = SceneColor x Transmittance + Luminance.
	// Luminance is pre-exposed (x View.PreExposure) like the scene color. Alpha channels (Step 18): luminance.a = reprojection
	// depth in km along the ray (-1 = infinity), transmittance.a = reprojection planet (PA_REPROJ_NO_PLANET = camera only).
	const float DebugSceneScale = 0.15;   // darkened scene under the debug views 2-4
	const float CloudOpacity = 1.0 - exp(-State.OpticalDepth);
	float3 Luminance;
	float3 Transmittance;
	if (DebugMode == 2)
	{
		// Density: optical depth of the clouds along the ray as a heat map.
		Transmittance = DebugSceneScale;
		Luminance = PA_HeatColor(CloudOpacity);
	}
	else if (DebugMode == 3)
	{
		// Cloud Height: where inside the layer the visible cloud matter is (contribution-weighted).
		// = lerp(darkened scene, height color, opacity)
		const float MeanHeight = State.HeightWeight > 1e-4 ? State.HeightSum / State.HeightWeight : 0.0;
		Transmittance = DebugSceneScale * (1.0 - CloudOpacity);
		Luminance = PA_HeightColor(MeanHeight) * CloudOpacity;
	}
	else if (DebugMode == 4)
	{
		// Ray Steps: density-function calls for this pixel (primary + light march), i.e. the cost map.
		// White = 64 x (1 + LightSteps) calls or more.
		const float Budget = 64.0 * (1.0 + (float)max(LightSteps, 0));
		Transmittance = DebugSceneScale;
		Luminance = PA_HeatColor((float)State.DensitySamples / Budget);
	}
	else
	{
		// Final (0), Atmosphere Only (5), Transmittance LUT (6), MS LUT (7). Scene color is pre-exposed; bring our
		// absolute radiance into the same space.
		Transmittance = State.Transmittance * State.AtmosphereTransmittance;
		Luminance = State.Accum * View.PreExposure;

		// Transmittance LUT: the atlas in the top-left corner at 2x (planet 0 at the top), over the final image.
		if (DebugMode == 6)
		{
			const uint2 LutTexel = (Ray.Pixel - (uint2)ViewRectMinAndSize.xy) / 2u;
			if (LutTexel.x < PA_TRANSMITTANCE_LUT_WIDTH && LutTexel.y < (uint)(PA_TRANSMITTANCE_LUT_HEIGHT * NumAtmospheres))
			{
				const uint LutBlock = LutTexel.y / PA_TRANSMITTANCE_LUT_HEIGHT;   // planet in view order -> its pool slot
				const uint Row = (uint)PA_GetLutSlot((int)LutBlock) * PA_TRANSMITTANCE_LUT_HEIGHT + LutTexel.y % PA_TRANSMITTANCE_LUT_HEIGHT;
				Transmittance = 0.0;
				Luminance = TransmittanceLutAtlas.Load(int3(LutTexel.x, Row, 0)).rgb;
			}
		}
		// Cloud Shadow Usage (Phase 4 / Step 23): which lit cloud samples of the primary planet got their sunlight from the
		// cascades (green) and which needed the full light march (red: outside the windows / tile not generated yet), over
		// the darkened image. Step 24: pixels without such cloud samples show the surface shadow source instead: green =
		// cascades, blue = march through the layer (texel too coarse, other planets; blend band in between), red = march
		// because the cascade texels are not generated yet. Otherwise the darkened image.
		if (DebugMode == 12)
		{
			const float Total = (float)(State.ShadowCascadeSamples + State.ShadowFallbackSamples);
			Luminance *= 0.25;
			Transmittance *= 0.25;
			if (Total > 0.0)
			{
				const float Cascade = (float)State.ShadowCascadeSamples / Total;
				Luminance += float3(1.0 - Cascade, Cascade, 0.0) * 0.5;
			}
			else if (State.SurfaceCloudShadow >= 0.0)
			{
				Luminance += (State.SurfaceShadowMissing != 0u ? float3(1.0, 0.0, 0.0)
					: lerp(float3(0.0, 1.0, 0.0), float3(0.0, 0.3, 1.0), State.SurfaceShadowMarchWeight)) * 0.5;
			}
		}
		// Surface Cloud Shadow (Step 24): the cloud transmittance of the sun path at the visible surface point, white = lit,
		// black = shadowed, in front of any clouds; dark blue = surface without direct sun (night side, or Surface 0);
		// elsewhere the darkened image.
		if (DebugMode == 13)
		{
			Luminance *= 0.25;
			Transmittance *= 0.25;
			if (State.SurfaceCloudShadow >= 0.0)
			{
				Transmittance = 0.0;
				Luminance = State.SurfaceCloudShadow;
			}
			else if (State.SurfaceCloudShadow < -1.5)
			{
				Transmittance = 0.0;
				Luminance = float3(0.02, 0.04, 0.15);
			}
		}
		// Shadow cascade 0 / 1 / 2 (Phase 4 / Step 22): the cascade window in the top-left corner, north = +V, centred on
		// the sub-camera point (red ring). White = column fully lit, dark blue = column fully shadowed (exp(-optical depth
		// of the whole cloud-shell segment)), magenta checker = tile not generated yet (the light march is used there).
		// Downscaled by an integer factor when the cascade does not fit. A red square = no cascades this frame.
		if (DebugMode >= 9 && DebugMode <= 11)
		{
			const int Cascade = DebugMode - 9;
			const int Slot = CloudShadowFrontBase + Cascade;   // Step 25: the set in use (front)
			const int2 LocalPixel = int2(Ray.Pixel) - int2(ViewRectMinAndSize.xy);
			const int Res = CloudShadowResolution;
			if (CloudShadowPlanet < 0 || CloudShadowSun[Slot].w < 0.5)
			{
				if (all(LocalPixel < 24))
				{
					Transmittance = 0.0;
					Luminance = float3(1.0, 0.0, 0.0);
				}
			}
			else
			{
				const int Fit = max((int)(0.9 * min(ViewRectMinAndSize.z, ViewRectMinAndSize.w)), 1);
				const int Scale = max((Res + Fit - 1) / Fit, 1);
				const int2 WindowTexel = int2(LocalPixel.x, Res / Scale - 1 - LocalPixel.y) * Scale;   // +V up
				if (all(LocalPixel < Res / Scale) && all(WindowTexel >= 0) && all(WindowTexel < Res))
				{
					const int2 GlobalTexel = int2(CloudShadowWindow[Slot].xy) + WindowTexel;
					const float4 Texel = CloudShadowAtlas.Load(int3(PA_ShadowStorageTexel(Slot, GlobalTexel), 0));
					Transmittance = 0.0;
					if (Texel.a < 0.5)
					{
						Luminance = ((WindowTexel.x / 8 + WindowTexel.y / 8) & 1) != 0 ? float3(1.0, 0.0, 1.0) : float3(0.25, 0.0, 0.25);
					}
					else
					{
						Luminance = lerp(float3(0.02, 0.04, 0.15), float3(1.0, 1.0, 1.0), exp(-Texel.b));
					}
					const float2 ToCamera = float2(WindowTexel) - CloudShadowWindow[Slot].zw;
					const float Ring = abs(length(ToCamera) - 6.0 * (float)Scale);
					if (Ring < (float)Scale)
					{
						Luminance = float3(1.0, 0.0, 0.0);
					}
				}
			}
		}
		// Multiple-scattering LUT: the atlas at 4x (planet 0 at the top; x = sun cos zenith -1..1, y = altitude),
		// Psi_ms for a unit sun x PA_MS_LUT_DEBUG_SCALE.
		if (DebugMode == 7 && bMultipleScattering != 0)   // otherwise the slot holds the transmittance atlas
		{
			const uint2 LutTexel = (Ray.Pixel - (uint2)ViewRectMinAndSize.xy) / 4u;
			if (LutTexel.x < PA_MS_LUT_WIDTH && LutTexel.y < (uint)(PA_MS_LUT_HEIGHT * NumAtmospheres))
			{
				const uint LutBlock = LutTexel.y / PA_MS_LUT_HEIGHT;
				const uint Row = (uint)PA_GetLutSlot((int)LutBlock) * PA_MS_LUT_HEIGHT + LutTexel.y % PA_MS_LUT_HEIGHT;
				Transmittance = 0.0;
				Luminance = MultipleScatteringLutAtlas.Load(int3(LutTexel.x, Row, 0)).rgb * PA_MS_LUT_DEBUG_SCALE;
			}
		}
	}
	OutLuminance[OutputTexel] = float4(Luminance, ReprojDepthKm);
	OutTransmittance[OutputTexel] = float4(Transmittance, (float)ReprojPlanet);
}
