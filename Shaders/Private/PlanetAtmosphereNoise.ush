#pragma once

// Noise primitives used by CloudDensity.ush.
//
// Two sources behind the same entry points (PA_SampleBaseShapeNoise / PA_SampleErosionNoise), chosen by
// r.PlanetAtmosphere.NoiseSource:
//   0 = procedural PA_Fbm, exactly the Phase 1 noise (reference and fallback, unchanged);
//   1 = baked tileable 3D textures (Phase 2 / Step 10), generated once on the GPU by NoiseBake.usf from
//       PA_FbmPeriodic below. Mip m holds the same noise with the octaves that survive a footprint of one
//       mip-m texel, so SampleLevel(LOD = log2(footprint in texels)) replaces the per-octave fade of PA_Fbm.
// CloudDensity.ush (the single source of truth for density) only calls the entry points.
//
// Value ranges (measured): PA_GradientNoise ~[-1, 1]; PA_Fbm has std ~0.19-0.23 (95% within +-0.33),
// which CloudDensity.ush stretches to an approximately uniform [0, 1].

/** PCG3D hash (Jarzynski & Olano, "Hash Functions for GPU Rendering", 2020). */
uint3 PA_Pcg3d(uint3 V)
{
	V = V * 1664525u + 1013904223u;
	V.x += V.y * V.z;
	V.y += V.z * V.x;
	V.z += V.x * V.y;
	V ^= V >> 16u;
	V.x += V.y * V.z;
	V.y += V.z * V.x;
	V.z += V.x * V.y;
	return V;
}

/** Pseudo-random gradient in [-1, 1]^3 for an integer lattice cell. */
float3 PA_LatticeGradient(int3 Cell)
{
	const uint3 H = PA_Pcg3d(asuint(Cell));
	return float3(H) * (2.0 / 4294967296.0) - 1.0;
}

/** 3D gradient (Perlin-style) noise with quintic interpolation, ~[-1, 1]. */
float PA_GradientNoise(float3 P)
{
	const float3 CellF = floor(P);
	const int3 Cell = int3(CellF);
	const float3 F = P - CellF;
	const float3 U = F * F * F * (F * (F * 6.0 - 15.0) + 10.0);

	const float N000 = dot(PA_LatticeGradient(Cell + int3(0, 0, 0)), F - float3(0, 0, 0));
	const float N100 = dot(PA_LatticeGradient(Cell + int3(1, 0, 0)), F - float3(1, 0, 0));
	const float N010 = dot(PA_LatticeGradient(Cell + int3(0, 1, 0)), F - float3(0, 1, 0));
	const float N110 = dot(PA_LatticeGradient(Cell + int3(1, 1, 0)), F - float3(1, 1, 0));
	const float N001 = dot(PA_LatticeGradient(Cell + int3(0, 0, 1)), F - float3(0, 0, 1));
	const float N101 = dot(PA_LatticeGradient(Cell + int3(1, 0, 1)), F - float3(1, 0, 1));
	const float N011 = dot(PA_LatticeGradient(Cell + int3(0, 1, 1)), F - float3(0, 1, 1));
	const float N111 = dot(PA_LatticeGradient(Cell + int3(1, 1, 1)), F - float3(1, 1, 1));

	const float X00 = lerp(N000, N100, U.x);
	const float X10 = lerp(N010, N110, U.x);
	const float X01 = lerp(N001, N101, U.x);
	const float X11 = lerp(N011, N111, U.x);
	const float Y0 = lerp(X00, X10, U.y);
	const float Y1 = lerp(X01, X11, U.y);
	return lerp(Y0, Y1, U.z) * 1.6;
}

/**
 * Fractal sum of PA_GradientNoise, normalized to the same range as one octave.
 * FootprintInNoiseUnits = size of the screen pixel at this sample, in the units of P.
 * Octaves whose features are smaller than ~1/2..1/4 of the pixel fade out (anti-aliasing / LOD),
 * which also skips their cost.
 */
float PA_Fbm(float3 P, int Octaves, float FootprintInNoiseUnits)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Norm = 0.0;
	float Frequency = 1.0;
	for (int Octave = 0; Octave < Octaves; ++Octave)
	{
		const float Weight = saturate(2.0 - 4.0 * FootprintInNoiseUnits * Frequency);
		if (Weight > 0.0)
		{
			Sum += Amplitude * Weight * PA_GradientNoise(P);
		}
		Norm += Amplitude;
		Amplitude *= 0.5;
		P = P * 2.03 + 17.13;
		Frequency *= 2.03;
	}
	return Sum / Norm;
}

// ---- Tileable (periodic) noise — content of the baked textures (Step 10) -----------------------
//
// The lattice of octave k wraps with period PA_NOISE_TILE * 2^k cells, i.e. every octave repeats after
// PA_NOISE_TILE noise units. Lacunarity is exactly 2 (instead of 2.03) so that all octaves tile together;
// integer per-octave offsets keep the lattice periodic. Same gradient hash, interpolation, x1.6 scale,
// octave fade and normalization as PA_GradientNoise / PA_Fbm. Validated against the CPU prototype.

#define PA_NOISE_TILE 4.0

// Texture layout. Must match PlanetAtmosphere::NoiseTextures in AtmosphereNoiseTextures.h.
#define PA_BASE_NOISE_SIZE 128       // texels per side of mip 0, covering PA_NOISE_TILE units
#define PA_BASE_NOISE_OCTAVES 4
#define PA_BASE_NOISE_MAX_MIP 4      // mips 0..4 (128..8); mip 4 = all octaves faded (zeros)
#define PA_EROSION_NOISE_SIZE 64
#define PA_EROSION_NOISE_OCTAVES 2
#define PA_EROSION_NOISE_MAX_MIP 3   // mips 0..3 (64..8); mip 3 = zeros
#define PA_DETAIL_NOISE_SIZE 64      // Step 32: Worley detail (billows), PA_WorleyFbmPeriodic
#define PA_DETAIL_NOISE_MAX_MIP 3    // mips 0..3 (64..8); mips 2..3 = zeros

// Step 32: standard deviation of the baked base noise per mip (measured on the bake; CPU prototype p31). The density uses
// the part removed by the LOD (sqrt(std0^2 - std(lod)^2)) to keep the cloud fraction at every distance.
static const float PA_BASE_NOISE_MIP_STD[5] = { 0.183483, 0.182397, 0.178090, 0.157111, 0.0 };

float PA_GradientNoisePeriodic(float3 P, int Period)
{
	const float3 CellF = floor(P);
	const int3 Cell = int3(CellF);
	const float3 F = P - CellF;
	const float3 U = F * F * F * (F * (F * 6.0 - 15.0) + 10.0);

	// P >= 0 for the bake (texel centers + positive offsets), so the cells are non-negative.
	#define PA_PERIODIC_CORNER(O) dot(PA_LatticeGradient((Cell + int3 O) % Period), F - float3 O)
	const float N000 = PA_PERIODIC_CORNER((0, 0, 0));
	const float N100 = PA_PERIODIC_CORNER((1, 0, 0));
	const float N010 = PA_PERIODIC_CORNER((0, 1, 0));
	const float N110 = PA_PERIODIC_CORNER((1, 1, 0));
	const float N001 = PA_PERIODIC_CORNER((0, 0, 1));
	const float N101 = PA_PERIODIC_CORNER((1, 0, 1));
	const float N011 = PA_PERIODIC_CORNER((0, 1, 1));
	const float N111 = PA_PERIODIC_CORNER((1, 1, 1));
	#undef PA_PERIODIC_CORNER

	const float X00 = lerp(N000, N100, U.x);
	const float X10 = lerp(N010, N110, U.x);
	const float X01 = lerp(N001, N101, U.x);
	const float X11 = lerp(N011, N111, U.x);
	const float Y0 = lerp(X00, X10, U.y);
	const float Y1 = lerp(X01, X11, U.y);
	return lerp(Y0, Y1, U.z) * 1.6;
}

/** Periodic fBm (period PA_NOISE_TILE in P). FootprintInNoiseUnits fades octaves exactly like PA_Fbm. */
float PA_FbmPeriodic(float3 P, int Octaves, float FootprintInNoiseUnits)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Norm = 0.0;
	int Frequency = 1;
	for (int Octave = 0; Octave < Octaves; ++Octave)
	{
		const float Weight = saturate(2.0 - 4.0 * FootprintInNoiseUnits * (float)Frequency);
		if (Weight > 0.0)
		{
			const float3 OctaveP = P * (float)Frequency + 17.0 * (float)Octave;
			Sum += Amplitude * Weight * PA_GradientNoisePeriodic(OctaveP, (int)PA_NOISE_TILE * Frequency);
		}
		Norm += Amplitude;
		Amplitude *= 0.5;
		Frequency *= 2;
	}
	return Sum / Norm;
}

// ---- Periodic Worley fBm (Step 32: billows of the cloud edges) ----------------------------------
//
// 3 octaves of 1 - F1 (distance to the nearest feature point, in cells) with 2 / 4 / 8 cells per noise unit; the lattice
// of each octave wraps every PA_NOISE_TILE units; feature point of a cell = cell + PA_Pcg3d hash. Octaves fade with the
// footprint like PA_Fbm (toward their mean); the result is centred and scaled to a std of ~0.2 (same convention as the
// fBm textures: CloudDensity.ush stretches 0.5 + 1.5 x). Constants measured by the CPU prototype p31 (worleystats).

#define PA_WORLEY_MEAN 0.479579
#define PA_WORLEY_GAIN 1.694756

int3 PA_WrapCell(int3 C, int Period)
{
	return ((C % Period) + Period) % Period;
}

/** Distance from P (in cells) to the nearest feature point of a lattice that wraps every Period cells. */
float PA_WorleyF1Periodic(float3 P, int Period)
{
	const float3 CellF = floor(P);
	const int3 Cell = int3(CellF);
	float Best = 9.0;
	for (int Z = -1; Z <= 1; ++Z)
	{
		for (int Y = -1; Y <= 1; ++Y)
		{
			for (int X = -1; X <= 1; ++X)
			{
				const int3 C = Cell + int3(X, Y, Z);
				const uint3 H = PA_Pcg3d(asuint(PA_WrapCell(C, Period)) + uint3(0x9E37u, 0u, 0u));
				const float3 Feature = float3(C) + float3(H) * (1.0 / 4294967296.0);
				const float3 D = Feature - P;
				Best = min(Best, dot(D, D));
			}
		}
	}
	return sqrt(Best);
}

/** Periodic Worley fBm (period PA_NOISE_TILE in P, noise units), centred, std ~0.2; octaves fade with the footprint. */
float PA_WorleyFbmPeriodic(float3 P, float FootprintInNoiseUnits)
{
	float Sum = 0.0;
	float Norm = 0.0;
	float Amplitude = 0.625;
	int Cells = 2;
	for (int Octave = 0; Octave < 3; ++Octave)
	{
		const float Weight = saturate(2.0 - 4.0 * FootprintInNoiseUnits * (float)Cells);
		float Value = PA_WORLEY_MEAN;
		if (Weight > 0.0)
		{
			Value = lerp(PA_WORLEY_MEAN, 1.0 - saturate(PA_WorleyF1Periodic(P * (float)Cells, (int)PA_NOISE_TILE * Cells)), Weight);
		}
		Sum += Amplitude * Value;
		Norm += Amplitude;
		Amplitude = Octave == 0 ? 0.25 : 0.125;
		Cells *= 2;
	}
	return (Sum / Norm - PA_WORLEY_MEAN) * PA_WORLEY_GAIN;
}

// ---- Entry points used by CloudDensity.ush -----------------------------------------------------

#ifndef PA_NOISE_BAKE_PASS   // the bake pass itself has no noise textures bound

Texture3D<float> BaseNoiseTexture;      // PA_FbmPeriodic(4 octaves), PA_BASE_NOISE_SIZE^3, R16F, mips 0..PA_BASE_NOISE_MAX_MIP
Texture3D<float> ErosionNoiseTexture;   // PA_FbmPeriodic(2 octaves), PA_EROSION_NOISE_SIZE^3, R16F, mips 0..PA_EROSION_NOISE_MAX_MIP
Texture3D<float> DetailNoiseTexture;    // Step 32: PA_WorleyFbmPeriodic, PA_DETAIL_NOISE_SIZE^3, R16F, mips 0..PA_DETAIL_NOISE_MAX_MIP
SamplerState NoiseSampler;              // trilinear, wrap
int NoiseSource;                        // 0 = procedural (Phase 1), 1 = baked textures

/** P and Footprint in noise units. LOD = log2(footprint in mip-0 texels). */
float PA_SampleNoiseTexture(Texture3D<float> Tex, float3 P, float FootprintInNoiseUnits, float Size, float MaxMip)
{
	const float TexelsPerUnit = Size / PA_NOISE_TILE;
	const float Lod = clamp(log2(max(FootprintInNoiseUnits * TexelsPerUnit, 1e-6)), 0.0, MaxMip);
	return Tex.SampleLevel(NoiseSampler, P / PA_NOISE_TILE, Lod);
}

/** Base cloud shape noise: 4-octave fBm, range and statistics of PA_Fbm(P, 4, Footprint). */
float PA_SampleBaseShapeNoise(float3 P, float FootprintInNoiseUnits)
{
	if (NoiseSource != 0)
	{
		return PA_SampleNoiseTexture(BaseNoiseTexture, P, FootprintInNoiseUnits, PA_BASE_NOISE_SIZE, PA_BASE_NOISE_MAX_MIP);
	}
	return PA_Fbm(P, 4, FootprintInNoiseUnits);
}

/**
 * Step 32: base noise + the standard deviation of the octaves removed by the footprint LOD (MissingStd, ~0 at fine
 * footprints, ~0.18 when the footprint exceeds half a noise unit). Procedural source: same LOD rule as the texture.
 */
float PA_SampleBaseShapeNoiseLod(float3 P, float FootprintInNoiseUnits, out float MissingStd)
{
	const float TexelsPerUnit = PA_BASE_NOISE_SIZE / PA_NOISE_TILE;
	const float Lod = clamp(log2(max(FootprintInNoiseUnits * TexelsPerUnit, 1e-6)), 0.0, (float)PA_BASE_NOISE_MAX_MIP);
	const int Lod0 = (int)Lod;
	const int Lod1 = min(Lod0 + 1, PA_BASE_NOISE_MAX_MIP);
	const float Std = lerp(PA_BASE_NOISE_MIP_STD[Lod0], PA_BASE_NOISE_MIP_STD[Lod1], Lod - (float)Lod0);
	MissingStd = sqrt(max(PA_BASE_NOISE_MIP_STD[0] * PA_BASE_NOISE_MIP_STD[0] - Std * Std, 0.0));
	if (NoiseSource != 0)
	{
		return BaseNoiseTexture.SampleLevel(NoiseSampler, P / PA_NOISE_TILE, Lod);
	}
	return PA_Fbm(P, 4, FootprintInNoiseUnits);
}

/** Step 32: Worley detail noise (billows), centred, std ~0.2. Procedural source: PA_WorleyFbmPeriodic itself. */
float PA_SampleDetailNoise(float3 P, float FootprintInNoiseUnits)
{
	if (NoiseSource != 0)
	{
		return PA_SampleNoiseTexture(DetailNoiseTexture, P, FootprintInNoiseUnits, PA_DETAIL_NOISE_SIZE, PA_DETAIL_NOISE_MAX_MIP);
	}
	return PA_WorleyFbmPeriodic(P, FootprintInNoiseUnits);
}

/** Erosion noise: 2-octave fBm, range and statistics of PA_Fbm(P, 2, Footprint). */
float PA_SampleErosionNoise(float3 P, float FootprintInNoiseUnits)
{
	if (NoiseSource != 0)
	{
		return PA_SampleNoiseTexture(ErosionNoiseTexture, P, FootprintInNoiseUnits, PA_EROSION_NOISE_SIZE, PA_EROSION_NOISE_MAX_MIP);
	}
	return PA_Fbm(P, 2, FootprintInNoiseUnits);
}

#endif // PA_NOISE_BAKE_PASS
