// Phase 4 / Step 22 — cloud shadow cascades of the primary planet (Beer Shadow Map, see CloudShadowCommon.ush).
//
// GenerateCS: one 32 x 32 tile of cascade texels per group z (z = slot of either set, Step 25) (tile list from AtmosphereCloudShadows.cpp). Mode 1: per
//   texel, uniform samples (at least GenerationSteps, Step 32a: steps <= 0.1 x shape scale up to 128, static per-texel
//   jitter) along the cloud-shell segment of the texel ray (from the sun side), density
//   ONLY from PA_SampleCloudDensity (AD-1) with the noise octaves faded at NoiseFootprintScale x the texel size (Step 21
//   prototype: 1/4 texel; a footprint of the step length loses clouds, AD-14). Writes
//     r = front: first sample interval with density, as a fraction of the segment (1 = no cloud)
//     g = back: end of the last sample interval with density (fraction)
//     b = optical depth of the segment (stops at PA_SHADOW_MAX_OPTICAL_DEPTH)
//     a = 1 (valid)
//   Mode 0: invalidates the tile (alpha 0) - the window moved and the storage now belongs to another tile.
// ClearCS: invalidates whole cascade slots (new atlas / a set configured anew).

#include "/Engine/Private/Common.ush"
#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"
#include "/Plugin/PlanetAtmosphere/Private/CloudShadowCommon.ush"

RWTexture2D<float4> OutShadowAtlas;

float4 ShadowTiles[PA_SHADOW_MAX_TILES_PER_PASS];   // xy = global tile, z = slot (set x 3 + cascade), w = 1 generate / 0 invalidate
int NumShadowTiles;
int ShadowGenerationSteps;
float NoiseFootprintScale;

static const float PA_SHADOW_GENERATION_MAX_STEP = 0.1;   // x CloudShapeScale (Step 32a)
static const int PA_SHADOW_GENERATION_MAX_STEPS = 128;

int ShadowAtlasResolution;                          // ClearCS
int ClearCascadeMask;                               // ClearCS: bit s = slot s

float4 PA_GenerateShadowTexel(int Slot, int2 GlobalTexel)
{
	const FPAAtmosphere A = PA_LoadAtmosphere(CloudShadowPlanet);
	const FPACloudLayer Layer = PA_MakeCloudLayer(A);

	const float Texel = CloudShadowAxisU[Slot].w;
	const float3 AxisU = CloudShadowAxisU[Slot].xyz;
	const float3 AxisV = CloudShadowAxisV[Slot].xyz;
	const float3 Sun = CloudShadowSun[Slot].xyz;
	const float U = ((float)GlobalTexel.x + 0.5) * Texel;
	const float V = ((float)GlobalTexel.y + 0.5) * Texel;
	const float Rho = sqrt(U * U + V * V);

	float WEntry;
	float Length;
	if (!PA_ShadowRaySegment(Rho, A.PlanetRadius, A.CloudBottom, A.CloudTop, WEntry, Length))
	{
		return float4(1.0, 1.0, 0.0, 1.0);   // no cloud layer on this ray: fully lit
	}

	const float3 PlaneOffset = U * AxisU + V * AxisV;

	// Step 32: only the part of the segment below the deepest clouds the weather allows (PA_CloudMaxTopAltitude at points
	// at most half a weather texel apart, PA_CloudTopSampleCount), as fractions [SegmentStart, SegmentEnd] of the full segment: the stored
	// front / back stay fractions of the full segment, so the lookup (CloudShadowCommon.ush) is unchanged.
	float SegmentStart = 0.0;
	float SegmentEnd = 1.0;
	const int NumTopPoints = CloudTopClamp != 0 ? PA_CloudTopSampleCount(Layer, Length) : 0;
	if (NumTopPoints > 0)   // Step 32a: 0 = segment too long to bound safely (grazing sun): the whole layer
	{
		const int NumPoints = NumTopPoints;
		const float InvSegments = 1.0 / (float)max(NumPoints - 1, 1);
		float TopAltitude = A.CloudBottom;
		for (int Point = 0; Point < NumPoints; ++Point)
		{
			const float3 Q = PlaneOffset + (WEntry - Length * (float)Point * InvSegments) * Sun;
			TopAltitude = max(TopAltitude, PA_CloudMaxTopAltitude(Layer, Q / max(length(Q), 1.0)));
		}
		TopAltitude = min(A.CloudTop, A.CloudBottom + (TopAltitude - A.CloudBottom) * 1.05);
		float WEntryClamped;
		float LengthClamped;
		if (!PA_ShadowRaySegment(Rho, A.PlanetRadius, A.CloudBottom, TopAltitude, WEntryClamped, LengthClamped))
		{
			return float4(1.0, 1.0, 0.0, 1.0);
		}
		SegmentStart = saturate((WEntry - WEntryClamped) / Length);
		SegmentEnd = saturate((WEntry - (WEntryClamped - LengthClamped)) / Length);
	}
	const float Span = max(SegmentEnd - SegmentStart, 0.0);

	// Step 32a: steps of at most PA_SHADOW_GENERATION_MAX_STEP x the cloud shape scale (ShadowGenerationSteps..128) at a
	// fixed per-texel jitter. With fixed step centres every sample sat at the same altitudes in neighbouring texels, so the
	// shadow of a small cloud was a stack of its horizontal slices with light leaking between them: horizontal bands
	// inside the clouds, worst at low sun (UE test: gone with CloudShadows.Lighting 0, finer and weaker with
	// GenerationSteps 128; 0.7 km clouds, sunset span ~4.7 km -> 147 m steps). The jitter is static (the cascade is cached):
	// neighbouring texels sample different altitudes and the 2 x 2 lookup blends them.
	const float SpanLength = Length * Span;
	const int MinSteps = max(ShadowGenerationSteps, 1);
	const float StepsForLength = ceil(SpanLength / max(PA_SHADOW_GENERATION_MAX_STEP * Layer.ShapeScale, 1.0));
	const int NumSteps = clamp((int)min(StepsForLength, (float)PA_SHADOW_GENERATION_MAX_STEPS), MinSteps, max(MinSteps, PA_SHADOW_GENERATION_MAX_STEPS));
	const float Ds = SpanLength / (float)NumSteps;
	const float Jitter = (float)(PA_Pcg3d(uint3(asuint(GlobalTexel.x), asuint(GlobalTexel.y), 0x5A3Du)).x >> 8) * (1.0 / 16777216.0);
	const float Footprint = Texel * NoiseFootprintScale;

	float OpticalDepth = 0.0;
	int First = -1;
	int Last = -1;
	for (int Step = 0; Step < NumSteps; ++Step)
	{
		const float W = WEntry - Length * SegmentStart - ((float)Step + Jitter) * Ds;
		const float3 P = PlaneOffset + W * Sun;
		// Same altitude precision as the per-sample light march (|P| at ~64 cm granularity at Earth scale).
		const float Altitude = sqrt(Rho * Rho + W * W) - A.PlanetRadius;
		const float Density = PA_SampleCloudDensity(Layer, P, Altitude, Footprint);
		if (Density > 0.0)
		{
			First = First < 0 ? Step : First;
			Last = Step;
			OpticalDepth += Density * A.CloudExtinction * Ds;
			if (OpticalDepth > PA_SHADOW_MAX_OPTICAL_DEPTH)
			{
				break;
			}
		}
	}

	if (First < 0)
	{
		return float4(1.0, 1.0, 0.0, 1.0);
	}
	const float InvSteps = Span / (float)NumSteps;
	return float4(SegmentStart + (float)First * InvSteps, SegmentStart + (float)(Last + 1) * InvSteps,
		min(OpticalDepth, PA_SHADOW_MAX_OPTICAL_DEPTH), 1.0);
}

[numthreads(8, 8, 1)]
void GenerateCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID)
{
	const int TileIndex = (int)GroupId.z;
	if (TileIndex >= NumShadowTiles || CloudShadowPlanet < 0)
	{
		return;
	}
	const float4 Tile = ShadowTiles[TileIndex];
	const int Slot = clamp((int)Tile.z, 0, PA_SHADOW_SLOTS - 1);
	const int2 LocalTexel = int2(GroupId.xy) * 8 + int2(GroupThreadId.xy);
	const int2 GlobalTexel = int2(Tile.xy) * PA_SHADOW_TILE + LocalTexel;
	const int2 StorageTexel = PA_ShadowStorageTexel(Slot, GlobalTexel);

	// Explicit branch: with HLSL 2018 the ?: operator evaluates both sides (an invalidated tile would pay the march).
	[branch]
	if (Tile.w > 0.5)
	{
		OutShadowAtlas[StorageTexel] = PA_GenerateShadowTexel(Slot, GlobalTexel);
	}
	else
	{
		OutShadowAtlas[StorageTexel] = PA_SHADOW_INVALID;
	}
}

[numthreads(8, 8, 1)]
void ClearCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int Res = ShadowAtlasResolution;
	if ((int)DispatchThreadId.x >= Res || (int)DispatchThreadId.y >= Res * PA_SHADOW_SLOTS)
	{
		return;
	}
	const int Slot = (int)DispatchThreadId.y / Res;
	if (((uint)ClearCascadeMask & (1u << (uint)Slot)) != 0u)
	{
		OutShadowAtlas[DispatchThreadId.xy] = PA_SHADOW_INVALID;
	}
}
