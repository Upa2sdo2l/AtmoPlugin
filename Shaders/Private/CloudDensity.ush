#pragma once

// ============================================================================================
//  SINGLE SOURCE OF TRUTH FOR CLOUD DENSITY  (architecture decision AD-1)
//
//  This file is the ONLY place where the cloud density formula exists.
//  Raymarch, debug views and (Phase 4) cloud shadows MUST call PA_SampleCloudDensity()
//  and PA_CloudHeightFraction() — never copy, simplify or re-derive any part of the formula
//  in another file. Cheaper variants are expressed through the Footprint (LOD) argument
//  or a future quality argument of THIS function, never as a separate copy.
// ============================================================================================
//
// Phase 6 / Step 32 (AD-36, prototype p31): multi-scale density. Every level only changes the cloud FRACTION at the
// distances where it is not resolved, so each distance shows its own scale (visual-target.md, multi-scale principle):
//   weather   (atlas, hundreds-thousands km): contrast curve cloud water -> cloud fraction; fair weather (shallow
//             cumulus) -> deep storm clouds;
//   clusters  (ClusterScale, ~100 km): a soft LOCAL cloud fraction (clouds thin out toward the edge, never sliced);
//   meso      (MesoScale, ~12 km): top relief and open / closed cells, faded before it reaches the pixel size;
//   clouds    (ShapeScale, ~0.7 km): vertically coherent noise, flat bases, domed tops, ragged storm bases; Step 32b:
//             Worley CELLS + Perlin distortion (separate compact cumulus instead of a crumpled fBm sheet, UE test of 32);
//   billows   (~0.25 x ShapeScale): Worley detail (128^3, finest ~45 m), billowy at the base, wispy toward the top; Step
//             32b: stronger, varying per region (billowy / ragged), coordinates warped (torn fringes, reference 3).
// Thresholds come from quantile tables of the noise, so the cloud fraction is what the weather asks for. Where the cloud
// level is smaller than the footprint, the sample returns the density of an EFFECTIVE MEDIUM: a fraction f of clouds
// with optical depth tau over the local cloud depth -> sigma = -ln(1 - f (1 - e^-tau)) / depth, distributed over the
// height like the cover; the cloud amount then stays the same from 50 m to 16 km pixels (prototype: <= 0.05, Phase 5
// up to 0.27) and the far image has no "salt".

#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereNoise.ush"
#include "/Plugin/PlanetAtmosphere/Private/WeatherAtlas.ush"

/** Everything the density function needs about one planet's cloud layer (planet-local, cm). */
struct FPACloudLayer
{
	float PlanetRadius;    // cm
	float BottomAltitude;  // cm above the planet radius
	float Thickness;       // cm (> 0): room for the deepest (storm) clouds
	float Coverage;        // [0, 1]: with weather 0.5 = the weather as it is; without weather = the cloud fraction
	float ShapeScale;      // cm, size of the individual clouds
	float Erosion;         // [0, 1]: billows eating into the cloud edges
	float Extinction;      // 1/cm at normalized density 1 (effective medium)
	float ClusterScale;    // cm, Step 32 cluster level
	float MesoScale;       // cm, Step 32 meso cells
	float FairDepth;       // cm, depth of fair-weather clouds
	// Phase 5 / Step 29: the planet's weather (AtmosphereWeatherInfo).
	int WeatherEnabled;    // 0 = no weather for this planet: Coverage is the cloud fraction everywhere
	float WeatherRowA;     // first atlas rows of the two snapshots around the weather time, interpolation weight
	float WeatherRowB;
	float WeatherBlend;
};

// ---- Constants of the Step 32 model (prototype p31) -----------------------------------------------
static const float PA_CLOUD_CONTRAST_LOW = 0.22;     // local cloud water -> cloud fraction (smoothstep)
static const float PA_CLOUD_CONTRAST_HIGH = 0.52;
// Step 34: inside a weather mass (humidity excess RHe, atlas channel y, shifted by Coverage): the mass edge is broken
// (fraction x 0.6) and shallow, the core overcast and deep.
static const float PA_CLOUD_INTERIOR_LOW = 0.64;      // RHe -> interior index (cloud fraction factor)
static const float PA_CLOUD_INTERIOR_HIGH = 0.90;
static const float PA_CLOUD_MASS_EDGE_FRACTION = 0.6; // cloud fraction factor at the edge of a mass
static const float PA_CLOUD_THICK_LOW = 0.70;         // RHe -> storm factor (depth, top height, density)
static const float PA_CLOUD_THICK_HIGH = 1.0;
static const float PA_CLOUD_HUMIDITY_COVERAGE = 0.4;  // RHe shift per unit of (Coverage - 0.5) x 2
static const float PA_CLOUD_CLUSTER_EXPONENT = 0.35; // cluster fraction = fraction^0.35, clouds inside take the rest
static const float PA_CLOUD_CLUSTER_WIDTH = 0.15;    // soft width of the cluster fraction
static const float PA_CLOUD_EDGE_WIDTH = 0.07;       // soft width of the cloud edges (stretched noise units)
static const float PA_CLOUD_VERTICAL_STRETCH = 0.3;  // cloud-level noise: vertical coordinate x 0.3 (coherent columns)
static const float PA_CLOUD_DOME_EXPONENT = 2.0;     // threshold rises with (height in the local depth)^2: domed tops
static const float PA_CLOUD_EDGE_DENSITY = 0.12;     // density at the cloud edge ...
static const float PA_CLOUD_CORE_WIDTH = 0.6;        // ... rising to 1 over this much noise above the threshold (32b: 0.3 -> 0.6)
static const float PA_CLOUD_UNRESOLVED_DENSITY = 0.6;   // mean density inside unresolved clouds (effective medium)
static const float PA_CLOUD_BASE_RELIEF = 0.75;      // storms: only the denser parts reach the lowest part ...
static const float PA_CLOUD_BASE_ZONE = 0.15;        // ... of this fraction of the local depth
static const float PA_CLOUD_MESO_AMPLITUDE = 0.3;    // meso cells: +-30 % cloud fraction (not in overcast) ...
static const float PA_CLOUD_MESO_RELIEF = 0.3;       // ... and +-30 % local depth
static const float PA_CLOUD_MESO_FADE_START = 0.05;  // meso pattern fades between these footprint / MesoScale
static const float PA_CLOUD_MESO_FADE_END = 0.15;
static const float PA_CLOUD_DETAIL_SCALE = 0.25;     // billows = 0.25 x ShapeScale
static const float PA_CLOUD_EROSION_LOSS = 0.5;      // unresolved clouds: share of the cloud area eaten by the billows (x strength; 32c)
// ---- Step 32b (prototype p32b): cellular cumulus, heterogeneous edges ---------------------------------------------
static const float PA_CLOUD_CELL_PERLIN_WEIGHT = 0.5;   // cloud level = Perlin fBm (shape distortion) ...
static const float PA_CLOUD_CELL_WORLEY_WEIGHT = 0.85;  // ... + Worley cells (compact, separate clouds); linear: LOD exact
static const float PA_CLOUD_CELL_PERLIN_SCALE = 1.37;   // x ShapeScale (incommensurate with the cells: no 4-unit repeat)
static const float PA_CLOUD_CELL_WORLEY_SCALE = 1.5;    // x ShapeScale: one cell ~ one cloud
static const float PA_CLOUD_CELL_STD = 0.169024;        // std of the cell noise at mip 0 (noise units, measured on the bake; 32c)
static const float PA_CLOUD_BILLOW_WEIGHT = 0.3;     // 32c: billows as a third part of the cell noise: outward bulges ...
static const float PA_CLOUD_BILLOW_SCALE = 0.5;      // ... of this x ShapeScale (Worley, true 3D: round); 0.6+ = "popcorn"
static const float PA_CLOUD_EROSION_STRENGTH = 0.6;     // erosion of CloudErosion 1 (32b 1.5 tore the edges into "paper"; 32c 0.6)
static const float PA_CLOUD_EROSION_COMPENSATION = 0.8; // threshold fraction / (1 - this x erosion x (1 - f)^1.2): the
static const float PA_CLOUD_EROSION_COMPENSATION_EXPONENT = 1.2;   // ... resolved clouds keep the requested amount
static const float PA_CLOUD_EROSION_MAX_THRESHOLD = 0.9;   // erosion threshold cap: cores survive the stronger erosion
static const float PA_CLOUD_DECK_LOSS = 0.03;           // unresolved closed decks: share of thin domes / holes
static const float PA_CLOUD_EDGE_VARIATION = 0.7;       // erosion x (1 +- this), edge width x (0.58 .. 2.05) ...
static const float PA_CLOUD_EDGE_VARIATION_SCALE = 2.142857; // ... varying over this x ShapeScale (3 km at the 32c 1400 m)
static const float PA_CLOUD_WARP = 0.5;                 // billow coordinates warped by the cell / edge noises x this x ShapeScale (32c)
static const float PA_CLOUD_CLUSTER_RATIO = 2.37;    // second cluster sample: incommensurate scale (breaks the tiling)

// Quantile tables of the stretched noise value u = saturate(0.5 + 1.5 n) at mip 0 (Q[i]: a fraction i / 64 lies below):
// the cloud-level CELL noise (Step 32b, PA_CloudCellNoise) and the cluster noise; the CDF of the cell noise on the grid
// u = i / 64; the column profile: mean over the local depth of the domed cover / base cover for a base cover of i / 64.
// Generated by the CPU prototype p32b (mode "tables") from the same noise textures (base 128^3, Worley detail 128^3).
static const float PA_CLOUD_QUANTILE_CELL[65] =
{
	-0.010000, 0.000000, 0.011526, 0.058031, 0.094471, 0.123501, 0.149031, 0.171320,
	0.192068, 0.210828, 0.228050, 0.244378, 0.259928, 0.274910, 0.289342, 0.303209,
	0.317048, 0.330051, 0.342585, 0.355002, 0.366785, 0.378693, 0.390280, 0.401285,
	0.412439, 0.423001, 0.434017, 0.444817, 0.455751, 0.466173, 0.476587, 0.486964,
	0.497685, 0.508378, 0.519006, 0.529734, 0.540530, 0.551574, 0.562064, 0.573242,
	0.584605, 0.595774, 0.607373, 0.619526, 0.631685, 0.643816, 0.656779, 0.669821,
	0.682613, 0.696182, 0.710250, 0.725213, 0.740616, 0.756260, 0.773050, 0.791549,
	0.811255, 0.832466, 0.856507, 0.883654, 0.913111, 0.949105, 0.995632, 1.000000,
	1.010000
};
static const float PA_CLOUD_QUANTILE_CLUSTER[65] =
{
	-0.010000, 0.000000, 0.000000, 0.033994, 0.075086, 0.108483, 0.136621, 0.161985,
	0.184828, 0.205047, 0.223663, 0.241651, 0.258576, 0.274522, 0.289796, 0.304549,
	0.318563, 0.331869, 0.344700, 0.357238, 0.369473, 0.381466, 0.393237, 0.404996,
	0.416480, 0.427792, 0.438563, 0.449429, 0.460065, 0.470948, 0.481265, 0.492064,
	0.502657, 0.513554, 0.524334, 0.535112, 0.545833, 0.556640, 0.568066, 0.579346,
	0.590410, 0.602079, 0.613829, 0.625372, 0.637371, 0.649468, 0.661667, 0.674440,
	0.687641, 0.701364, 0.715594, 0.729911, 0.745477, 0.760839, 0.777703, 0.795450,
	0.815517, 0.836918, 0.860370, 0.888031, 0.918824, 0.956486, 1.000000, 1.000000,
	1.010000
};
static const float PA_CLOUD_CDF_CELL[65] =
{
	0.015625, 0.032627, 0.037877, 0.043127, 0.048791, 0.055491, 0.062191, 0.070522,
	0.079042, 0.088605, 0.098811, 0.109793, 0.121560, 0.134209, 0.147812, 0.162302,
	0.177524, 0.193441, 0.209989, 0.227238, 0.244865, 0.263310, 0.282716, 0.302674,
	0.323279, 0.344240, 0.366330, 0.388959, 0.411290, 0.433747, 0.456991, 0.480477,
	0.503382, 0.526279, 0.549069, 0.571477, 0.594360, 0.616089, 0.637793, 0.658824,
	0.678910, 0.699015, 0.718112, 0.736883, 0.755627, 0.773336, 0.790126, 0.806169,
	0.821873, 0.836840, 0.850676, 0.863598, 0.875917, 0.887427, 0.897959, 0.907901,
	0.916894, 0.925573, 0.933861, 0.941304, 0.948087, 0.954475, 0.959722, 0.964970,
	0.984375
};
static const float PA_CLOUD_COLUMN_PROFILE[65] =
{
	0.441479, 0.441479, 0.417355, 0.722181, 0.706000, 0.681723, 0.665397, 0.650053,
	0.635927, 0.625165, 0.615935, 0.606857, 0.599082, 0.593686, 0.589354, 0.584715,
	0.580601, 0.576344, 0.573894, 0.572106, 0.569447, 0.567703, 0.566520, 0.564835,
