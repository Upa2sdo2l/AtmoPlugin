// Linear interpolation in one of the tables (X in [0, 1], 65 entries). A macro, not a function with an array parameter:
// some shader compilers copy array arguments into a local array on every call.
#define PA_CLOUD_TABLE(Table, X) PA_CloudTableLerp(Table[min((int)(saturate(X) * 64.0), 63)], Table[min((int)(saturate(X) * 64.0), 63) + 1], saturate(X) * 64.0)

float PA_CloudTableLerp(float A, float B, float F)
{
	return lerp(A, B, F - (float)min((int)F, 63));
}

/** Noise value below which a fraction Fraction of the cell (cluster) noise lies. */
float PA_CloudQuantileCell(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_QUANTILE_CELL, Fraction); }
float PA_CloudQuantileCluster(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_QUANTILE_CLUSTER, Fraction); }
/** Fraction of the cell noise below the value U. */
float PA_CloudCdfCell(float U) { return U <= 0.0 ? 0.0 : (U >= 1.0 ? 1.0 : PA_CLOUD_TABLE(PA_CLOUD_CDF_CELL, U)); }
/** Column profile for a base cover Fraction. */
float PA_CloudColumnProfile(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_COLUMN_PROFILE, Fraction); }

float PA_Remap(float Value, float OldLow, float OldHigh, float NewLow, float NewHigh)
{
	return NewLow + (Value - OldLow) * (NewHigh - NewLow) / max(OldHigh - OldLow, 1e-5);
}

/** 0 at the cloud layer bottom, 1 at its top (unclamped). */
float PA_CloudHeightFraction(FPACloudLayer Layer, float Altitude)
{
	return (Altitude - Layer.BottomAltitude) / Layer.Thickness;
}

/**
 * Weather at Direction (planet local, unit): x = cloud fraction, y = storm factor (0 fair weather, 1 deep storm clouds).
 * Step 34: the storm factor and a broken mass edge come from the weather humidity (how deep inside a cloud mass).
 * Step 35: Footprint (cm) softens the mass edges for far views (0 = none; the storm factor does not depend on it).
 * Step 37: z = interior index (0 at the edge of a weather mass, 1 deep inside; 1 without weather).
 */
float3 PA_CloudWeather(FPACloudLayer Layer, float3 Direction, float Footprint)
{
	if (Layer.WeatherEnabled == 0)
	{
		// Without weather: Coverage is the cloud fraction; deeper clouds only near full coverage.
		return float3(Layer.Coverage, smoothstep(0.8, 1.0, Layer.Coverage), 1.0);
	}
	const float2 Sample = lerp(
		PA_SampleWeatherSnapshot(Direction, Layer.WeatherRowA).xy,
		PA_SampleWeatherSnapshot(Direction, Layer.WeatherRowB).xy,
		Layer.WeatherBlend);
	// Step 41 (prototype p41): Coverage moves the EDGES of the weather masses -- an offset of the cloud water, which the
	// flowmap weather stores unclamped (a signed margin around the mass edge) -- instead of scaling the cloud amount inside
	// them (Step 29: masses went translucent / dim instead of smaller). Coverage 0.5 = the weather as it is. The storm factor
	// (depth, top, density) no longer depends on Coverage; the interior index follows the moved edge (Step 34 shift).
	const float Shift = (Layer.Coverage - 0.5) * 2.0;
	const float LocalCoverage = Sample.x + PA_CLOUD_COVERAGE_SHIFT * Shift;
	const float Humidity = Sample.y;   // Step 34: how deep inside a weather mass (effective humidity, unclamped)
	const float Interior = smoothstep(PA_CLOUD_INTERIOR_LOW, PA_CLOUD_INTERIOR_HIGH, Humidity + PA_CLOUD_HUMIDITY_COVERAGE * Shift);
	const float Soft = PA_CLOUD_SOFT_FAR_STRENGTH * smoothstep(PA_CLOUD_SOFT_FAR_START, PA_CLOUD_SOFT_FAR_END, Footprint);
	return float3(
		smoothstep(lerp(PA_CLOUD_CONTRAST_LOW, PA_CLOUD_SOFT_CONTRAST_LOW, Soft), lerp(PA_CLOUD_CONTRAST_HIGH, PA_CLOUD_SOFT_CONTRAST_HIGH, Soft),
			LocalCoverage) * lerp(PA_CLOUD_MASS_EDGE_FRACTION, 1.0, Interior),
		smoothstep(PA_CLOUD_THICK_LOW, PA_CLOUD_THICK_HIGH, Humidity),
		Interior);
}

/** Step 39b: the 192 km level only exists with the far exaggeration (x1 near the planet -> 0, >= x5 -> full). */
float PA_CloudMacroLevelShare(FPACloudLayer Layer, int K)
{
	return K == 2 ? saturate((Layer.ReliefExaggeration - 1.0) / 4.0) : 1.0;
}

/** Step 39c: the highest the macro clouds can raise a top (cm) for the weather fraction Fraction (all excesses = 1). */
float PA_CloudMacroMaxHeight(FPACloudLayer Layer, float Fraction)
{
	return Layer.HeapAmplitude * Layer.ReliefExaggeration * lerp(Layer.HeapFairWeather, 1.0, saturate(Fraction * 1.5)) * Layer.HeapScale
		* (PA_CLOUD_MACRO_HEIGHT[0] * PA_CLOUD_MACRO_SCALE[0] + PA_CLOUD_MACRO_HEIGHT[1] * PA_CLOUD_MACRO_SCALE[1]
			+ PA_CLOUD_MACRO_HEIGHT[2] * PA_CLOUD_MACRO_SCALE[2] * PA_CloudMacroLevelShare(Layer, 2));
}

/**
 * Upper bound of the cloud-top altitude over Direction (planet local, unit): the deepest clouds the weather allows there.
 * Callers march only up to it (Step 32: a 0.6 km fair-weather field no longer shares its samples with 7 km of empty layer).
 */
float PA_CloudMaxTopAltitude(FPACloudLayer Layer, float3 Direction)
{
	const float3 Weather = PA_CloudWeather(Layer, Direction, 0.0);
	const float Base = lerp(Layer.FairDepth, Layer.Thickness, Weather.y) * (1.0 + PA_CLOUD_MESO_RELIEF);
	if (Layer.HeapAmplitude <= 0.0)
	{
		return Layer.BottomAltitude + min(Layer.Thickness, Base);
	}
	// Step 37b: the highest macro cloud (soft cap at the layer top, as in the density).
	const float Raw = Base + PA_CloudMacroMaxHeight(Layer, 1.0);
	return Layer.BottomAltitude + Layer.Thickness * (1.0 - exp(-Raw / Layer.Thickness));
}

static const int PA_CLOUD_TOP_MAX_POINTS = 17;
static const int PA_CLOUD_TOP_FIXED_POINTS = 9;   // Step 39: CloudTopClamp 2

/** Size (cm) of a weather-atlas texel on the cloud base sphere. */
float PA_CloudWeatherTexel(FPACloudLayer Layer)
{
	return (Layer.PlanetRadius + Layer.BottomAltitude) * 1.5707963 / max((float)WeatherResolution, 1.0);
}

/**
 * Number of points (>= 3) at which a cloud-top bound must be evaluated along a path of PathLength cm so that no weather
 * feature between them is missed: about two per weather-atlas texel (~39 km on an Earth-size planet at 256).
 * Step 32a: 0 when that would take more than PA_CLOUD_TOP_MAX_POINTS - the path gets no bound then (the whole layer):
 * points farther apart than half a texel miss storm peaks and cut their tops (UE test: bands along the limb, light
 * leaking near the terminator).
 */
int PA_CloudTopSampleCount(FPACloudLayer Layer, float PathLength)
{
	if (Layer.WeatherEnabled == 0)
	{
		return 1;   // no weather: the same bound everywhere
	}
	const float NumPoints = ceil(2.0 * PathLength / max(PA_CloudWeatherTexel(Layer), 1.0)) + 1.0;
	return NumPoints > (float)PA_CLOUD_TOP_MAX_POINTS ? 0 : max((int)NumPoints, 3);
}

/** Soft threshold: fraction of the stretched value U above T, widened by the variance the LOD removed. */
float PA_CloudSoftStep(float U, float T, float Width, float MissingStd)
{
	const float W = sqrt(Width * Width + 2.9 * 2.25 * MissingStd * MissingStd);
	return smoothstep(T - W, T + W, U);
}

/**
 * Step 32b: cloud-level cell noise at PC (planet local, cm): Perlin fBm (base texture, shape distortion) + Worley cells
 * (detail texture: compact, separate clouds), a LINEAR blend so the texture mips stay exact and the variance removed by
 * the LOD is the weighted sum of both (MissingStd, noise units of the blend). Returns the stretched value u in [0, 1];
 * NP / NW = the raw Perlin / Worley values (reused as the warp of the billows).
 */
float PA_CloudCellNoise(FPACloudLayer Layer, float3 PC, float3 PosPlanetLocal, float Footprint, out float NP, out float NW, out float MissingStd)
{
	const float PerlinScale = Layer.ShapeScale * PA_CLOUD_CELL_PERLIN_SCALE;
	const float WorleyScale = Layer.ShapeScale * PA_CLOUD_CELL_WORLEY_SCALE;
	float MissingP;
	float MissingW;
	NP = PA_SampleBaseShapeNoiseLod(PC / PerlinScale, Footprint / PerlinScale, MissingP);
	const float3 Q = PC / WorleyScale;
	NW = PA_SampleDetailNoiseLod(float3(Q.y + 13.1, Q.z - 7.7, Q.x + 3.3), Footprint / WorleyScale, MissingW);
	// Step 32c: billows (Worley, true 3D, not stretched: round bulges) added to the field before the threshold, so the
	// cloud outline bulges outward like cauliflower instead of being eaten by the erosion.
	const float BillowScale = Layer.ShapeScale * PA_CLOUD_BILLOW_SCALE;
	float MissingB;
	const float3 QB = PosPlanetLocal / BillowScale + float3(-5.7, 21.3, 8.9);
	const float NB = PA_SampleDetailNoiseLod(float3(QB.z, QB.x, QB.y), Footprint / BillowScale, MissingB);
	const float SP = PA_CLOUD_CELL_PERLIN_WEIGHT * PA_BASE_NOISE_MIP_STD[0];
	const float SW = PA_CLOUD_CELL_WORLEY_WEIGHT * PA_DETAIL_NOISE_MIP_STD[0];
	const float SB = PA_CLOUD_BILLOW_WEIGHT * PA_DETAIL_NOISE_MIP_STD[0];
	const float InvNorm = 0.18 / sqrt(SP * SP + SW * SW + SB * SB);   // the blend has the base noise's std (~0.18)
	const float MP = PA_CLOUD_CELL_PERLIN_WEIGHT * MissingP;
	const float MW = PA_CLOUD_CELL_WORLEY_WEIGHT * MissingW;
	const float MB = PA_CLOUD_BILLOW_WEIGHT * MissingB;
	MissingStd = sqrt(MP * MP + MW * MW + MB * MB) * InvNorm;
	return saturate(0.5 + 1.5 * (PA_CLOUD_CELL_PERLIN_WEIGHT * NP + PA_CLOUD_CELL_WORLEY_WEIGHT * NW + PA_CLOUD_BILLOW_WEIGHT * NB) * InvNorm);
}

/** Step 39c: the cloud cell value (Perlin + Worley of PA_CloudCellNoise) without the billows, for the macro levels. */
float PA_CloudMacroCellNoise(FPACloudLayer Layer, float3 PC, float Footprint)
{
	const float PerlinScale = Layer.ShapeScale * PA_CLOUD_CELL_PERLIN_SCALE;
	const float WorleyScale = Layer.ShapeScale * PA_CLOUD_CELL_WORLEY_SCALE;
	float MissingP;
	float MissingW;
	const float NP = PA_SampleBaseShapeNoiseLod(PC / PerlinScale, Footprint / PerlinScale, MissingP);
	const float3 Q = PC / WorleyScale;
	const float NW = PA_SampleDetailNoiseLod(float3(Q.y + 13.1, Q.z - 7.7, Q.x + 3.3), Footprint / WorleyScale, MissingW);
	const float SP = PA_CLOUD_CELL_PERLIN_WEIGHT * PA_BASE_NOISE_MIP_STD[0];
	const float SW = PA_CLOUD_CELL_WORLEY_WEIGHT * PA_DETAIL_NOISE_MIP_STD[0];
	const float InvNorm = 0.18 / sqrt(SP * SP + SW * SW);
	return saturate(0.5 + 1.5 * (PA_CLOUD_CELL_PERLIN_WEIGHT * NP + PA_CLOUD_CELL_WORLEY_WEIGHT * NW) * InvNorm);
}

/**
 * Step 37b: macro clouds over Direction (unit, planet local). x = clump value (0..1, mean 0.5) that gathers the local
 * fraction into big clouds, y = extra top height (cm). Fraction = weather cloud fraction. Three PA_CloudCellNoise per call (Step 39b).
 */
float2 PA_CloudMacro(FPACloudLayer Layer, float3 Direction, float Fraction, float Footprint, float DepthRaw, float H0,
	out bool bAbove)
{
	float Height = 0.0;
	float Clump = 0.0;
	bAbove = false;
	const float MacroFraction = saturate(PA_CLOUD_MACRO_FRACTION_BASE + PA_CLOUD_MACRO_FRACTION_SLOPE * Fraction);
	const float T = PA_CloudQuantileCell(1.0 - MacroFraction);
	const float Amp = Layer.HeapAmplitude * Layer.ReliefExaggeration * lerp(Layer.HeapFairWeather, 1.0, saturate(Fraction * 1.5));
	// Step 39c: tallest level first; after each level, stop if the sample is above the highest top the remaining levels
	// could still make (exact) -- most samples of the exaggerated layer are, and skip the remaining fetches.
	float Remaining = PA_CloudMacroMaxHeight(Layer, Fraction);
	for (int Order = 0; Order < PA_CLOUD_MACRO_LEVELS; ++Order)
	{
		const int K = PA_CLOUD_MACRO_ORDER[Order];
		const float Share = PA_CloudMacroLevelShare(Layer, K);
		if (Share <= 0.0)
		{
			continue;   // the 192 km level near the planet (no clump weight, no height)
		}
		FPACloudLayer Macro = Layer;
		Macro.ShapeScale = Layer.HeapScale * PA_CLOUD_MACRO_SCALE[K];
		// Step 39c: a level far below the pixel is its mean (no fetch); macro cells without the billow component (2 fetches,
		// the billows of a 12..192 km cell are invisible; same std 0.18, so the cell quantiles still apply).
		float U = 0.5;
		if (Footprint < PA_CLOUD_MACRO_LOD_SKIP * Macro.ShapeScale)
		{
			const float3 P = Direction * (Layer.PlanetRadius + Layer.BottomAltitude) + PA_CLOUD_MACRO_OFFSET[K] * Macro.ShapeScale;
			U = PA_CloudMacroCellNoise(Macro, P, Footprint);
		}
		const float E = saturate((U - T) / max(1.0 - T, 1e-3));
		const float LevelMax = Amp * PA_CLOUD_MACRO_HEIGHT[K] * Macro.ShapeScale * Share;
		Height += LevelMax * pow(E, PA_CLOUD_MACRO_DOME);
		Remaining -= LevelMax;
		Clump += PA_CLOUD_MACRO_WEIGHT[K] * U;
		if (H0 >= Layer.Thickness * (1.0 - exp(-(DepthRaw + Height + max(Remaining, 0.0)) / Layer.Thickness)))
		{
			bAbove = true;
			return float2(0.5, Height);
		}
	}
	return float2(Clump, Height);
}

/**
 * Step 32b: erosion of the cloud value X by the billow value Detail (threshold Detail x K). Where the footprint removed
 * part of the billows (MissingDetail, stretched units), the expectation over the removed values (uniform equivalent,
 * 3-point Gauss-Legendre) instead of the mean, so the eroded amount does not jump with the billow LOD. The threshold is
 * capped below 1: with the Step 32b strength it could exceed 1 and cut holes into solid cores (a jump at threshold 1).
 */
float PA_CloudErode(float X, float Detail, float K, float MissingDetail)
{
	if (MissingDetail <= 1e-4)
	{
		return saturate(PA_Remap(X, min(Detail * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	}
	const float Offset = 1.342 * MissingDetail;
	const float A = saturate(PA_Remap(X, min(saturate(Detail - Offset) * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	const float B = saturate(PA_Remap(X, min(Detail * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	const float C = saturate(PA_Remap(X, min(saturate(Detail + Offset) * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	return (5.0 * A + 8.0 * B + 5.0 * C) / 18.0;
}

/**
 * Large scales of the cloud layer over Direction: x = local cloud fraction (weather x clusters x macro clump x meso),
 * y = local depth (cm), z = storm factor, w = weather fraction. H0 (cm above the base) is used only for exact early-outs
 * (negative = evaluate everything: the cloud map bake). Step 40: this is what the cloud map stores.
 */
float4 PA_CloudLargeScales(FPACloudLayer Layer, float3 Direction, float Footprint, float H0)
{
	// Weather: cloud fraction (contrast) and storm factor.
	const float3 Weather = PA_CloudWeather(Layer, Direction, Footprint);
	const float Fraction = Weather.x;
	const float Storm = Weather.y;
	if (Fraction <= 0.0)
	{
		return float4(0.0, 0.0, Storm, 0.0);   // exact: Coverage 0 or a clear weather zone
	}

	// Cluster level: soft local fraction. Two samples at incommensurate scales break the texture tiling.
	const float ClusterFraction = pow(Fraction, PA_CLOUD_CLUSTER_EXPONENT);
	const float CloudFraction = Fraction / max(ClusterFraction, 1e-4);
	const float3 PK1 = Direction * (Layer.PlanetRadius / Layer.ClusterScale);
	const float3 PK2 = float3(PK1.y * PA_CLOUD_CLUSTER_RATIO + 31.7, PK1.z * PA_CLOUD_CLUSTER_RATIO - 11.3, PK1.x * PA_CLOUD_CLUSTER_RATIO + 5.1);
	const float ClusterFootprint = Footprint / Layer.ClusterScale;
	float MissingK1;
	float MissingK2;
	const float NK = 0.8 * PA_SampleBaseShapeNoiseLod(PK1, ClusterFootprint, MissingK1)
		+ 0.6 * PA_SampleBaseShapeNoiseLod(PK2, ClusterFootprint * PA_CLOUD_CLUSTER_RATIO, MissingK2);
	const float UK = saturate(0.5 + 1.5 * NK);
	const float MissingK = sqrt(0.64 * MissingK1 * MissingK1 + 0.36 * MissingK2 * MissingK2);
	const float MaskK = ClusterFraction >= 0.999 ? 1.0
		: PA_CloudSoftStep(UK, PA_CloudQuantileCluster(1.0 - ClusterFraction), PA_CLOUD_CLUSTER_WIDTH, MissingK);

	// Meso cells (faded before they reach the pixel size): open / closed cells, relief of the tops.
	float MissingM;
	const float3 PM = Direction * (Layer.PlanetRadius / Layer.MesoScale) + float3(71.3, -23.9, 47.1);
	const float UM = saturate(0.5 + 1.5 * PA_SampleBaseShapeNoiseLod(PM, Footprint / Layer.MesoScale, MissingM));
	const float MesoVisible = 1.0 - smoothstep(PA_CLOUD_MESO_FADE_START, PA_CLOUD_MESO_FADE_END, Footprint / Layer.MesoScale);
	const float UMeso = 0.5 + (UM - 0.5) * MesoVisible;
	const float Fraction4 = Fraction * Fraction * Fraction * Fraction;
	// Local depth: shallow fair-weather clouds (thinner toward the cluster edges), deep storms (tops follow the clusters).
	const float DeepDepth = Layer.Thickness * (0.45 + 0.55 * smoothstep(0.2, 0.8, UK));
	// Step 32c: at most the layer (storm tops with +30 % meso relief used to be cut by the layer top instead of domed).
	float DepthRaw = lerp(Layer.FairDepth * (0.6 + 0.4 * MaskK), DeepDepth, Storm) * (1.0 + PA_CLOUD_MESO_RELIEF * (2.0 * UMeso - 1.0));
	// Step 39c: exact early-out before the macro clouds (~half of the density cost): above the highest top they could make.
	if (Layer.HeapAmplitude > 0.0
		&& H0 >= Layer.Thickness * (1.0 - exp(-(DepthRaw + PA_CloudMacroMaxHeight(Layer, Fraction)) / Layer.Thickness)))
	{
		return float4(0.0, 0.0, Storm, Fraction);
	}
	// Step 37b: macro clouds (the cloud cell noise at HeapScale, 0.25 x and 4 x HeapScale) gather the fraction and raise the tops.
	float2 Macro = float2(0.5, 0.0);
	if (Layer.HeapAmplitude > 0.0)
	{
		bool bAbove;
		Macro = PA_CloudMacro(Layer, Direction, Fraction, Footprint, DepthRaw, H0, bAbove);
		if (bAbove)
		{
			return float4(0.0, 0.0, Storm, Fraction);
		}
	}
	const float MacroClump = max(0.0, 1.0 + PA_CLOUD_MACRO_CLUMP * (1.0 - Storm) * (2.0 * Macro.x - 1.0));
	const float LocalFraction = saturate(CloudFraction * MaskK * MacroClump * (1.0 + PA_CLOUD_MESO_AMPLITUDE * (1.0 - Fraction4) * (2.0 * UMeso - 1.0)));

	float Depth = min(Layer.Thickness, DepthRaw);
	if (Layer.HeapAmplitude > 0.0)
	{
		// Step 37b: macro clouds add top height (flat bases); a soft cap at the layer top keeps the tallest ones rounded.
		DepthRaw += Macro.y;
		Depth = Layer.Thickness * (1.0 - exp(-DepthRaw / Layer.Thickness));
	}
	return float4(LocalFraction, Depth, Storm, Fraction);
}

// ---- Step 40: baked cloud map. Cube-sphere atlas laid out like the weather atlas (same snapshot rows, scaled to its
// resolution): x local fraction, y depth / thickness, z storm, w weather fraction; built from PA_CloudLargeScales at the
// texel footprint whenever a weather snapshot is built. One bilinear fetch per density sample. ----
// C++: FAtmosphereWeatherAtlasParameters (AtmosphereShaders.h), map built by CloudMapBake.usf (AtmosphereWeather.cpp).
Texture2D<float4> CloudMap;            // the transmittance LUT pool when there is no map (never sampled then)
SamplerState CloudMapSampler;          // bilinear, clamp
int CloudMapResolution;                // texels per face side
float4 CloudMapSizeAndInvSize;         // xy = atlas size (texels), zw = 1 / size
int CloudMapEnable;                    // 1 = every planet with weather has its cloud map (FPACloudLayer.CloudMapEnabled)

float4 PA_SampleCloudMapSnapshot(float3 Direction, float RowBase)
{
	const FPAWeatherFaceCoord Coord = PA_WeatherFaceCoord(Direction);
	const float Res = (float)CloudMapResolution;
	const float2 FaceTexel = clamp((float2(Coord.A, Coord.B) + 1.0) * (0.5 * Res), 0.5, Res - 0.5);
	const float2 UV = (float2((float)Coord.Face * Res, RowBase) + FaceTexel) * CloudMapSizeAndInvSize.zw;
	return CloudMap.SampleLevel(CloudMapSampler, UV, 0);
}

float4 PA_SampleCloudMap(FPACloudLayer Layer, float3 Direction)
{
	const float RowScale = (float)CloudMapResolution / max((float)WeatherResolution, 1.0);
	const float4 A = PA_SampleCloudMapSnapshot(Direction, (float)Layer.WeatherRowA * RowScale);
	if (Layer.WeatherBlend <= 0.0)
	{
		return A;
	}
	const float4 B = PA_SampleCloudMapSnapshot(Direction, (float)Layer.WeatherRowB * RowScale);
	return lerp(A, B, Layer.WeatherBlend);
}

/** One cloud map texel: centre Direction (planet local, unit), texel size Footprint (cm). */
float4 PA_CloudMapBake(FPACloudLayer Layer, float3 Direction, float Footprint)
{
	const float4 L = PA_CloudLargeScales(Layer, Direction, Footprint, -1.0);
	return float4(L.x, saturate(L.y / max(Layer.Thickness, 1.0)), L.z, L.w);
}

/**
 * Normalized cloud density (multiply by the extinction coefficient to get sigma_t; may exceed 1 in storm cores).
 *
 * PosPlanetLocal : sample position relative to the planet center, in the planet's local frame (cm).
 * Altitude       : |PosPlanetLocal| - PlanetRadius (cm).
 * Footprint      : noise footprint at this sample (cm, NoiseFootprintScale x pixel); fades the detail smaller than it.
 * LocalHeight    : Step 32c: height of the sample inside its local cloud (0 base .. 1 top of the local depth; 0 where
 *                  the density is 0). The lighting darkens the sky light toward the bases with it.
 * LocalDepth     : Step 36: depth of the local cloud (cm; 0 where the density is 0). With LocalHeight it gives the
 *                  cloud above / below the sample (sky light occlusion, ground bounce).
 */
float PA_SampleCloudDensityEx(FPACloudLayer Layer, float3 PosPlanetLocal, float Altitude, float Footprint, out float LocalHeight,
	out float LocalDepth)
{
	LocalHeight = 0.0;
	LocalDepth = 0.0;
	const float H0 = Altitude - Layer.BottomAltitude;
	if (H0 <= 0.0 || H0 >= Layer.Thickness)
	{
		return 0.0;
	}
	const float3 Direction = PosPlanetLocal / max(length(PosPlanetLocal), 1.0);

	float LocalFraction;
	float Depth;
	float Storm;
	float Fraction;
	if (Layer.CloudMapEnabled != 0)
	{
		// Step 40: one fetch of the baked cloud map replaces weather + clusters + meso + macro clouds (~11 fetches).
		// Step 40: the map is read through a 3D warp of a few km that varies with height (the walls of tall clouds bulge
		// in and out instead of rising as straight vertical faces with the cells stacked into "fir trees", prototype p40).
		const float WarpScale = PA_CLOUD_MAP_WARP_SCALE * Layer.ShapeScale;
		const float3 QW = PosPlanetLocal / WarpScale;
		const float W1 = PA_SampleBaseShapeNoise(QW + float3(11.3, -27.1, 4.6), Footprint / WarpScale);
		const float W2 = PA_SampleBaseShapeNoise(QW + float3(-38.2, 15.7, -9.4), Footprint / WarpScale);
		const float3 T1 = normalize(cross(abs(Direction.z) < 0.9 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0), Direction));
		const float3 T2 = cross(Direction, T1);
		const float WarpAmplitude = PA_CLOUD_MAP_WARP_AMPLITUDE * Layer.ShapeScale / (PA_CLOUD_MAP_WARP_NOISE_STD * Layer.PlanetRadius);
		const float4 Map = PA_SampleCloudMap(Layer, normalize(Direction + (T1 * W1 + T2 * W2) * WarpAmplitude));
		LocalFraction = Map.x;
		Depth = Map.y * Layer.Thickness;
		Storm = Map.z;
		Fraction = Map.w;
	}
	else
	{
		const float4 Large = PA_CloudLargeScales(Layer, Direction, Footprint, H0);
		LocalFraction = Large.x;
		Depth = Large.y;
		Storm = Large.z;
		Fraction = Large.w;
	}
	if (LocalFraction <= 1e-3 || H0 >= Depth)
	{
		return 0.0;
	}
	const float H = H0 / max(Depth, 1.0);
	LocalHeight = H;
	LocalDepth = Depth;

	// Step 32b: edge character per region (~3 km): some clouds billowy and sharp, others ragged with wide soft edges.
	const float EdgeScale = Layer.ShapeScale * PA_CLOUD_EDGE_VARIATION_SCALE;
	// Step 40 (cloud map): the edge character varies in 3D too (a 2D one draws vertical stripes on tall cloud walls).
	const float3 PV = Layer.CloudMapEnabled != 0 ? PosPlanetLocal / EdgeScale : Direction * (Layer.PlanetRadius / EdgeScale);
	const float NV = PA_SampleBaseShapeNoise(PV + float3(-41.7, 9.2, 28.4), Footprint / EdgeScale);
	const float EdgeK = smoothstep(-0.25, 0.25, NV);
	const float ErosionScale = lerp(1.0 - PA_CLOUD_EDGE_VARIATION, 1.0 + PA_CLOUD_EDGE_VARIATION, EdgeK);
	const float EdgeWidthScale = lerp(1.0 - 0.6 * PA_CLOUD_EDGE_VARIATION, 1.0 + 1.5 * PA_CLOUD_EDGE_VARIATION, EdgeK);
	const float ErosionK = Layer.Erosion * PA_CLOUD_EROSION_STRENGTH * ErosionScale;

	// Cloud level (Step 32b): vertically coherent CELL noise (separate compact clouds); threshold from the local fraction,
	// raised by what the billows will erode (the resolved clouds keep the requested amount), rising with height (domes);
	// storms get ragged bases; flat bases otherwise.
	const float ThresholdFraction = saturate(LocalFraction
		/ max(1.0 - PA_CLOUD_EROSION_COMPENSATION * ErosionK * pow(1.0 - LocalFraction, PA_CLOUD_EROSION_COMPENSATION_EXPONENT), 0.2));
	// Step 40 (cloud map): the domes live in a skin of PA_CLOUD_SKIN x ShapeScale under the local top; below it the cloud
	// level is true 3D (vertically coherent columns only in the skin) and the cells widen into one body, so a tall cloud is
	// one mass with a domed top instead of a needle whose dome spans the whole depth (prototype p40).
	const bool bSkin = Layer.CloudMapEnabled != 0;
	const float Skin = bSkin ? min(PA_CLOUD_SKIN * Layer.ShapeScale, Depth) : Depth;
	const float ZC = bSkin
		? H0 * PA_CLOUD_VERTICAL_STRETCH + (1.0 - PA_CLOUD_VERTICAL_STRETCH) * min(H0 - (Depth - Skin), 0.0)
		: H0 * PA_CLOUD_VERTICAL_STRETCH;
	const float3 PC = Direction * (Layer.PlanetRadius + Layer.BottomAltitude + ZC);
	float MissingC;
	float NP;
	float NW;
	const float UC = PA_CloudCellNoise(Layer, PC, PosPlanetLocal, Footprint, NP, NW, MissingC);
	float Threshold;
	if (bSkin)
	{
		const float HD = saturate((H0 - (Depth - Skin)) / max(Skin, 1.0));
		const float Below = saturate((Depth - Skin - H0) / max(Skin, 1.0));
		const float BodyFraction = saturate(ThresholdFraction * (1.0 + PA_CLOUD_SKIN_FILL * Below));
		Threshold = lerp(PA_CloudQuantileCell(1.0 - BodyFraction), 1.02, pow(HD, PA_CLOUD_DOME_EXPONENT));
	}
	else
	{
		Threshold = lerp(PA_CloudQuantileCell(1.0 - ThresholdFraction), 1.02, pow(H, PA_CLOUD_DOME_EXPONENT));
	}
	Threshold = max(Threshold, lerp(PA_CLOUD_BASE_RELIEF * Storm, -0.01, smoothstep(0.0, PA_CLOUD_BASE_ZONE, H)));
	const float Base = smoothstep(0.0, 0.06, H);
	const float Cover = PA_CloudSoftStep(UC, Threshold, PA_CLOUD_EDGE_WIDTH * EdgeWidthScale, MissingC) * Base;
	if (Cover <= 0.0)
	{
		return 0.0;
	}

	// Billows: Worley detail, billowy (inverted) at the base, wispy toward the top. Step 32b: its coordinates are warped by
	// the noises already sampled above (curled, torn fringes at no extra fetch).
	const float DetailScale = Layer.ShapeScale * PA_CLOUD_DETAIL_SCALE;
	const float3 PW = PosPlanetLocal + float3(NP, NW, NV) * (PA_CLOUD_WARP * Layer.ShapeScale);
	float MissingW;
	const float UW = saturate(0.5 + 1.5 * PA_SampleDetailNoiseLod(PW / DetailScale, Footprint / DetailScale, MissingW));
	const float DetailInvert = saturate(H * 1.5);
	const float Detail = lerp(UW, 1.0 - UW, DetailInvert);
	const float MissingDetail = 1.5 * MissingW * abs(1.0 - 2.0 * DetailInvert);
	const float StormDensity = lerp(0.8, 1.3, Storm);
	const float LocalFraction4 = LocalFraction * LocalFraction * LocalFraction * LocalFraction;
	const float Core = max(PA_CLOUD_EDGE_DENSITY + (1.0 - PA_CLOUD_EDGE_DENSITY) * smoothstep(Threshold, Threshold + PA_CLOUD_CORE_WIDTH, UC),
		LocalFraction4);   // closed decks stay solid

	// Resolved: the eroded cloud shape. Unresolved: effective medium of a column (see the header).
	const float Resolved = 1.0 - saturate(MissingC / PA_CLOUD_CELL_STD);
	const float Resolved2 = Resolved * Resolved;
	const float Fine = PA_CloudErode(Cover * Core, Detail, ErosionK * 0.5, MissingDetail) * StormDensity;
	if (Resolved2 >= 1.0)
	{
		return Fine;
	}
	const float InCloud = lerp(PA_CLOUD_UNRESOLVED_DENSITY, Core, Resolved2) * StormDensity;
	const float Tau = InCloud * Layer.Extinction * Depth;
	const float ColumnCover = LocalFraction * (1.0 - PA_CLOUD_EROSION_LOSS * ErosionK * (1.0 - LocalFraction4))
		* (1.0 - PA_CLOUD_DECK_LOSS * LocalFraction4);
	const float SigmaColumn = -log(max(1.0 - ColumnCover * (1.0 - exp(-Tau)), 1e-6)) / Depth;
	const float CoverHere = (1.0 - PA_CloudCdfCell(Threshold)) * Base;   // expected cover at this height
	const float Profile = PA_CloudColumnProfile(ThresholdFraction);
	const float Effective = SigmaColumn * CoverHere / max(ThresholdFraction * Profile, 1e-4) / max(Layer.Extinction, 1e-12);
	const float FarTop = lerp(1.0, (1.0 + PA_CLOUD_FAR_TOP_EXPONENT) * pow(saturate(H), PA_CLOUD_FAR_TOP_EXPONENT), 1.0 - Resolved2);   // Step 39b
	return lerp(Effective * FarTop, Fine, Resolved2);
}

/** PA_SampleCloudDensityEx without the local height (light marches, shadows, debug views). */
float PA_SampleCloudDensity(FPACloudLayer Layer, float3 PosPlanetLocal, float Altitude, float Footprint)
{
	float LocalHeight;
	float LocalDepth;
	return PA_SampleCloudDensityEx(Layer, PosPlanetLocal, Altitude, Footprint, LocalHeight, LocalDepth);
}
