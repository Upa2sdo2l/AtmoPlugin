// Linear interpolation in one of the tables (X in [0, 1], 65 entries). A macro, not a function with an array parameter:
// some shader compilers copy array arguments into a local array on every call.
#define PA_CLOUD_TABLE(Table, X) PA_CloudTableLerp(Table[min((int)(saturate(X) * 64.0), 63)], Table[min((int)(saturate(X) * 64.0), 63) + 1], saturate(X) * 64.0)

float PA_CloudTableLerp(float A, float B, float F)
{
	return lerp(A, B, F - (float)min((int)F, 63));
}

/** Noise value below which a fraction Fraction of the cell (cluster) noise lies. */
float PA_CloudQuantileCell(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_QUANTILE_CELL, Fraction); }
float PA_CloudQuantileCluster(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_QUANTILE_CLUSTER, Fraction); }
/** Fraction of the cell noise below the value U. */
float PA_CloudCdfCell(float U) { return U <= 0.0 ? 0.0 : (U >= 1.0 ? 1.0 : PA_CLOUD_TABLE(PA_CLOUD_CDF_CELL, U)); }
/** Column profile for a base cover Fraction. */
float PA_CloudColumnProfile(float Fraction) { return PA_CLOUD_TABLE(PA_CLOUD_COLUMN_PROFILE, Fraction); }

/**
 * Step 29: local coverage from the weather's cloud water C and the planet's Coverage parameter: Coverage 0.5 = the weather
 * as it is, 0 = no clouds, 1 = overcast; in between C is scaled toward 0 or toward 1.
 */
float PA_WeatherLocalCoverage(float CloudWater, float Coverage)
{
	return Coverage < 0.5 ? CloudWater * (Coverage / 0.5) : 1.0 - (1.0 - CloudWater) * ((1.0 - Coverage) / 0.5);
}

float PA_Remap(float Value, float OldLow, float OldHigh, float NewLow, float NewHigh)
{
	return NewLow + (Value - OldLow) * (NewHigh - NewLow) / max(OldHigh - OldLow, 1e-5);
}

/** 0 at the cloud layer bottom, 1 at its top (unclamped). */
float PA_CloudHeightFraction(FPACloudLayer Layer, float Altitude)
{
	return (Altitude - Layer.BottomAltitude) / Layer.Thickness;
}

/** Weather at Direction (planet local, unit): x = cloud fraction, y = storm factor (0 fair weather, 1 deep storm clouds). */
float2 PA_CloudWeather(FPACloudLayer Layer, float3 Direction)
{
	if (Layer.WeatherEnabled == 0)
	{
		// Without weather: Coverage is the cloud fraction; deeper clouds only near full coverage.
		return float2(Layer.Coverage, smoothstep(0.8, 1.0, Layer.Coverage));
	}
	const float CloudWater = saturate(lerp(
		PA_SampleWeatherSnapshot(Direction, Layer.WeatherRowA).x,
		PA_SampleWeatherSnapshot(Direction, Layer.WeatherRowB).x,
		Layer.WeatherBlend));
	const float LocalCoverage = PA_WeatherLocalCoverage(CloudWater, Layer.Coverage);
	return float2(
		smoothstep(PA_CLOUD_CONTRAST_LOW, PA_CLOUD_CONTRAST_HIGH, LocalCoverage),
		smoothstep(PA_CLOUD_STORM_LOW, PA_CLOUD_STORM_HIGH, LocalCoverage));
}

/**
 * Upper bound of the cloud-top altitude over Direction (planet local, unit): the deepest clouds the weather allows there.
 * Callers march only up to it (Step 32: a 0.6 km fair-weather field no longer shares its samples with 7 km of empty layer).
 */
float PA_CloudMaxTopAltitude(FPACloudLayer Layer, float3 Direction)
{
	const float Storm = PA_CloudWeather(Layer, Direction).y;
	return Layer.BottomAltitude + min(Layer.Thickness, lerp(Layer.FairDepth, Layer.Thickness, Storm) * (1.0 + PA_CLOUD_MESO_RELIEF));
}

static const int PA_CLOUD_TOP_MAX_POINTS = 17;

/**
 * Number of points (>= 3) at which a cloud-top bound must be evaluated along a path of PathLength cm so that no weather
 * feature between them is missed: about two per weather-atlas texel (~39 km on an Earth-size planet at 256).
 * Step 32a: 0 when that would take more than PA_CLOUD_TOP_MAX_POINTS - the path gets no bound then (the whole layer):
 * points farther apart than half a texel miss storm peaks and cut their tops (UE test: bands along the limb, light
 * leaking near the terminator).
 */
int PA_CloudTopSampleCount(FPACloudLayer Layer, float PathLength)
{
	if (Layer.WeatherEnabled == 0)
	{
		return 1;   // no weather: the same bound everywhere
	}
	const float WeatherTexel = (Layer.PlanetRadius + Layer.BottomAltitude) * 1.5707963 / max((float)WeatherResolution, 1.0);
	const float NumPoints = ceil(2.0 * PathLength / max(WeatherTexel, 1.0)) + 1.0;
	return NumPoints > (float)PA_CLOUD_TOP_MAX_POINTS ? 0 : max((int)NumPoints, 3);
}

/** Soft threshold: fraction of the stretched value U above T, widened by the variance the LOD removed. */
float PA_CloudSoftStep(float U, float T, float Width, float MissingStd)
{
	const float W = sqrt(Width * Width + 2.9 * 2.25 * MissingStd * MissingStd);
	return smoothstep(T - W, T + W, U);
}

/**
 * Step 32b: cloud-level cell noise at PC (planet local, cm): Perlin fBm (base texture, shape distortion) + Worley cells
 * (detail texture: compact, separate clouds), a LINEAR blend so the texture mips stay exact and the variance removed by
 * the LOD is the weighted sum of both (MissingStd, noise units of the blend). Returns the stretched value u in [0, 1];
 * NP / NW = the raw Perlin / Worley values (reused as the warp of the billows).
 */
float PA_CloudCellNoise(FPACloudLayer Layer, float3 PC, float Footprint, out float NP, out float NW, out float MissingStd)
{
	const float PerlinScale = Layer.ShapeScale * PA_CLOUD_CELL_PERLIN_SCALE;
	const float WorleyScale = Layer.ShapeScale * PA_CLOUD_CELL_WORLEY_SCALE;
	float MissingP;
	float MissingW;
	NP = PA_SampleBaseShapeNoiseLod(PC / PerlinScale, Footprint / PerlinScale, MissingP);
	const float3 Q = PC / WorleyScale;
	NW = PA_SampleDetailNoiseLod(float3(Q.y + 13.1, Q.z - 7.7, Q.x + 3.3), Footprint / WorleyScale, MissingW);
	const float SP = PA_CLOUD_CELL_PERLIN_WEIGHT * PA_BASE_NOISE_MIP_STD[0];
	const float SW = PA_CLOUD_CELL_WORLEY_WEIGHT * PA_DETAIL_NOISE_MIP_STD[0];
	const float InvNorm = 0.18 / sqrt(SP * SP + SW * SW);   // the blend has the base noise's std (~0.18)
	const float MP = PA_CLOUD_CELL_PERLIN_WEIGHT * MissingP;
	const float MW = PA_CLOUD_CELL_WORLEY_WEIGHT * MissingW;
	MissingStd = sqrt(MP * MP + MW * MW) * InvNorm;
	return saturate(0.5 + 1.5 * (PA_CLOUD_CELL_PERLIN_WEIGHT * NP + PA_CLOUD_CELL_WORLEY_WEIGHT * NW) * InvNorm);
}

/**
 * Step 32b: erosion of the cloud value X by the billow value Detail (threshold Detail x K). Where the footprint removed
 * part of the billows (MissingDetail, stretched units), the expectation over the removed values (uniform equivalent,
 * 3-point Gauss-Legendre) instead of the mean, so the eroded amount does not jump with the billow LOD. The threshold is
 * capped below 1: with the Step 32b strength it could exceed 1 and cut holes into solid cores (a jump at threshold 1).
 */
float PA_CloudErode(float X, float Detail, float K, float MissingDetail)
{
	if (MissingDetail <= 1e-4)
	{
		return saturate(PA_Remap(X, min(Detail * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	}
	const float Offset = 1.342 * MissingDetail;
	const float A = saturate(PA_Remap(X, min(saturate(Detail - Offset) * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	const float B = saturate(PA_Remap(X, min(Detail * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	const float C = saturate(PA_Remap(X, min(saturate(Detail + Offset) * K, PA_CLOUD_EROSION_MAX_THRESHOLD), 1.0, 0.0, 1.0));
	return (5.0 * A + 8.0 * B + 5.0 * C) / 18.0;
}

/**
 * Normalized cloud density (multiply by the extinction coefficient to get sigma_t; may exceed 1 in storm cores).
 *
 * PosPlanetLocal : sample position relative to the planet center, in the planet's local frame (cm).
 * Altitude       : |PosPlanetLocal| - PlanetRadius (cm).
 * Footprint      : noise footprint at this sample (cm, NoiseFootprintScale x pixel); fades the detail smaller than it.
 */
float PA_SampleCloudDensity(FPACloudLayer Layer, float3 PosPlanetLocal, float Altitude, float Footprint)
{
	const float H0 = Altitude - Layer.BottomAltitude;
	if (H0 <= 0.0 || H0 >= Layer.Thickness)
	{
		return 0.0;
	}
	const float3 Direction = PosPlanetLocal / max(length(PosPlanetLocal), 1.0);

	// Weather: cloud fraction (contrast) and storm factor.
	const float2 Weather = PA_CloudWeather(Layer, Direction);
	const float Fraction = Weather.x;
	const float Storm = Weather.y;
	if (Fraction <= 0.0)
	{
		return 0.0;   // exact: Coverage 0 or a clear weather zone
	}

	// Cluster level: soft local fraction. Two samples at incommensurate scales break the texture tiling.
	const float ClusterFraction = pow(Fraction, PA_CLOUD_CLUSTER_EXPONENT);
	const float CloudFraction = Fraction / max(ClusterFraction, 1e-4);
	const float3 PK1 = Direction * (Layer.PlanetRadius / Layer.ClusterScale);
	const float3 PK2 = float3(PK1.y * PA_CLOUD_CLUSTER_RATIO + 31.7, PK1.z * PA_CLOUD_CLUSTER_RATIO - 11.3, PK1.x * PA_CLOUD_CLUSTER_RATIO + 5.1);
	const float ClusterFootprint = Footprint / Layer.ClusterScale;
	float MissingK1;
	float MissingK2;
	const float NK = 0.8 * PA_SampleBaseShapeNoiseLod(PK1, ClusterFootprint, MissingK1)
		+ 0.6 * PA_SampleBaseShapeNoiseLod(PK2, ClusterFootprint * PA_CLOUD_CLUSTER_RATIO, MissingK2);
	const float UK = saturate(0.5 + 1.5 * NK);
	const float MissingK = sqrt(0.64 * MissingK1 * MissingK1 + 0.36 * MissingK2 * MissingK2);
	const float MaskK = ClusterFraction >= 0.999 ? 1.0
		: PA_CloudSoftStep(UK, PA_CloudQuantileCluster(1.0 - ClusterFraction), PA_CLOUD_CLUSTER_WIDTH, MissingK);

	// Meso cells (faded before they reach the pixel size): open / closed cells, relief of the tops.
	float MissingM;
	const float3 PM = Direction * (Layer.PlanetRadius / Layer.MesoScale) + float3(71.3, -23.9, 47.1);
	const float UM = saturate(0.5 + 1.5 * PA_SampleBaseShapeNoiseLod(PM, Footprint / Layer.MesoScale, MissingM));
	const float MesoVisible = 1.0 - smoothstep(PA_CLOUD_MESO_FADE_START, PA_CLOUD_MESO_FADE_END, Footprint / Layer.MesoScale);
	const float UMeso = 0.5 + (UM - 0.5) * MesoVisible;
	const float Fraction4 = Fraction * Fraction * Fraction * Fraction;
	const float LocalFraction = saturate(CloudFraction * MaskK * (1.0 + PA_CLOUD_MESO_AMPLITUDE * (1.0 - Fraction4) * (2.0 * UMeso - 1.0)));
	if (LocalFraction <= 1e-3)
	{
		return 0.0;
	}

	// Local depth: shallow fair-weather clouds (thinner toward the cluster edges), deep storms (tops follow the clusters).
	const float DeepDepth = Layer.Thickness * (0.45 + 0.55 * smoothstep(0.2, 0.8, UK));
	const float Depth = lerp(Layer.FairDepth * (0.6 + 0.4 * MaskK), DeepDepth, Storm) * (1.0 + PA_CLOUD_MESO_RELIEF * (2.0 * UMeso - 1.0));
	const float H = H0 / max(Depth, 1.0);
	if (H >= 1.0)
	{
		return 0.0;
	}

	// Step 32b: edge character per region (~3 km): some clouds billowy and sharp, others ragged with wide soft edges.
	const float EdgeScale = Layer.ShapeScale * PA_CLOUD_EDGE_VARIATION_SCALE;
	const float NV = PA_SampleBaseShapeNoise(Direction * (Layer.PlanetRadius / EdgeScale) + float3(-41.7, 9.2, 28.4), Footprint / EdgeScale);
	const float EdgeK = smoothstep(-0.25, 0.25, NV);
	const float ErosionScale = lerp(1.0 - PA_CLOUD_EDGE_VARIATION, 1.0 + PA_CLOUD_EDGE_VARIATION, EdgeK);
	const float EdgeWidthScale = lerp(1.0 - 0.6 * PA_CLOUD_EDGE_VARIATION, 1.0 + 1.5 * PA_CLOUD_EDGE_VARIATION, EdgeK);
	const float ErosionK = Layer.Erosion * PA_CLOUD_EROSION_STRENGTH * ErosionScale;

	// Cloud level (Step 32b): vertically coherent CELL noise (separate compact clouds); threshold from the local fraction,
	// raised by what the billows will erode (the resolved clouds keep the requested amount), rising with height (domes);
	// storms get ragged bases; flat bases otherwise.
	const float ThresholdFraction = saturate(LocalFraction
		/ max(1.0 - PA_CLOUD_EROSION_COMPENSATION * ErosionK * pow(1.0 - LocalFraction, PA_CLOUD_EROSION_COMPENSATION_EXPONENT), 0.2));
	const float3 PC = Direction * (Layer.PlanetRadius + Layer.BottomAltitude + H0 * PA_CLOUD_VERTICAL_STRETCH);
	float MissingC;
	float NP;
	float NW;
	const float UC = PA_CloudCellNoise(Layer, PC, Footprint, NP, NW, MissingC);
	float Threshold = lerp(PA_CloudQuantileCell(1.0 - ThresholdFraction), 1.02, pow(H, PA_CLOUD_DOME_EXPONENT));
	Threshold = max(Threshold, lerp(PA_CLOUD_BASE_RELIEF * Storm, -0.01, smoothstep(0.0, PA_CLOUD_BASE_ZONE, H)));
	const float Base = smoothstep(0.0, 0.06, H);
	const float Cover = PA_CloudSoftStep(UC, Threshold, PA_CLOUD_EDGE_WIDTH * EdgeWidthScale, MissingC) * Base;
	if (Cover <= 0.0)
	{
		return 0.0;
	}

	// Billows: Worley detail, billowy (inverted) at the base, wispy toward the top. Step 32b: its coordinates are warped by
	// the noises already sampled above (curled, torn fringes at no extra fetch).
	const float DetailScale = Layer.ShapeScale * PA_CLOUD_DETAIL_SCALE;
	const float3 PW = PosPlanetLocal + float3(NP, NW, NV) * (PA_CLOUD_WARP * Layer.ShapeScale);
	float MissingW;
	const float UW = saturate(0.5 + 1.5 * PA_SampleDetailNoiseLod(PW / DetailScale, Footprint / DetailScale, MissingW));
	const float DetailInvert = saturate(H * 1.5);
	const float Detail = lerp(UW, 1.0 - UW, DetailInvert);
	const float MissingDetail = 1.5 * MissingW * abs(1.0 - 2.0 * DetailInvert);
	const float StormDensity = lerp(0.8, 1.3, Storm);
	const float LocalFraction4 = LocalFraction * LocalFraction * LocalFraction * LocalFraction;
	const float Core = max(PA_CLOUD_EDGE_DENSITY + (1.0 - PA_CLOUD_EDGE_DENSITY) * smoothstep(Threshold, Threshold + PA_CLOUD_CORE_WIDTH, UC),
		LocalFraction4);   // closed decks stay solid

	// Resolved: the eroded cloud shape. Unresolved: effective medium of a column (see the header).
	const float Resolved = 1.0 - saturate(MissingC / PA_CLOUD_CELL_STD);
	const float Resolved2 = Resolved * Resolved;
	const float Fine = PA_CloudErode(Cover * Core, Detail, ErosionK * 0.5, MissingDetail) * StormDensity;
	if (Resolved2 >= 1.0)
	{
		return Fine;
	}
	const float InCloud = lerp(PA_CLOUD_UNRESOLVED_DENSITY, Core, Resolved2) * StormDensity;
	const float Tau = InCloud * Layer.Extinction * Depth;
	const float ColumnCover = LocalFraction * (1.0 - PA_CLOUD_EROSION_LOSS * ErosionK * (1.0 - LocalFraction4))
		* (1.0 - PA_CLOUD_DECK_LOSS * LocalFraction4);
	const float SigmaColumn = -log(max(1.0 - ColumnCover * (1.0 - exp(-Tau)), 1e-6)) / Depth;
	const float CoverHere = (1.0 - PA_CloudCdfCell(Threshold)) * Base;   // expected cover at this height
	const float Profile = PA_CloudColumnProfile(ThresholdFraction);
	const float Effective = SigmaColumn * CoverHere / max(ThresholdFraction * Profile, 1e-4) / max(Layer.Extinction, 1e-12);
	return lerp(Effective, Fine, Resolved2);
}
