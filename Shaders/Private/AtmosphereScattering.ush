#pragma once

// Phase 2.5 / Step 13 — atmosphere single scattering (Rayleigh + Mie + ozone absorption).
//
//  - Density profiles: Rayleigh and Mie exponential, ozone a tent; altitudes above the ATMOSPHERE BOTTOM.
//  - Phase functions: Rayleigh, Cornette-Shanks for Mie (as UE SkyAtmosphere).
//  - Transmittance LUT (Bruneton 2017 parameterization, 256 x 64 per planet, rows of a per-frame atlas):
//    transmittance from a point toward the top of the atmosphere, built by TransmittanceLut.usf.
//  - View ray: NumSteps samples, quadratic distribution when the camera is inside the atmosphere, uniform outside;
//    energy-conserving step integral; sun visibility = LUT x hard planet shadow (ray / bottom sphere).
//  - Multiple scattering (Step 14, Hillaire 2020): LUT Psi_ms(altitude, sun cos zenith), 64 x 32 per planet, built by
//    MultipleScatteringLut.usf; the view ray adds (sigma_s Rayleigh + sigma_s Mie) x Psi_ms x sun illuminance per sample.
//
// Precision (AD-3 / Step 13 prototype): at Earth scale r^2 - R^2 in float32 loses up to 1.6 km of altitude.
// Every quantity below is therefore written with ALTITUDES: rho^2 = r^2 - Rb^2 = h (2 Rb + h),
// Rt^2 - r^2 = (Ht - h)(2 Rb + Ht + h), r(t)^2 - Rb^2 = rho^2 + t (t + 2 r mu); no difference of two large squares.
//
// Per-planet parameters: AtmosphereRayleigh / MieScattering / MieAbsorption / Ozone / Surface (PlanetAtmosphereShaderData.ush).

#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"

// Must match PlanetAtmosphere::TransmittanceLut::Width / Height (AtmosphereRenderer.cpp).
#define PA_TRANSMITTANCE_LUT_WIDTH 256
#define PA_TRANSMITTANCE_LUT_HEIGHT 64

// Integration steps of one LUT texel (CPU prototype: 40 steps are as accurate as 200 at 256 x 64).
#define PA_TRANSMITTANCE_LUT_STEPS 40

// Effective top of the scattering medium, in scale heights of the thicker exponential profile (or the ozone layer top,
// if higher): above it the remaining air column is ~exp(-12) = 6e-6 of the total. The LUT and the view ray are
// integrated only up to min(geometric atmosphere top, effective top), so a geometric shell much thicker than the air
// (e.g. AtmosphereTopRadius 500 km above the bottom with Earth's 8 km scale height) does not waste the 16 view samples
// in vacuum. Prototype: 500 km shell, camera 400 km: 28 % -> 0.7 % mean luminance error; 100 km shell unchanged.
#define PA_ATMOSPHERE_EFFECTIVE_TOP_SCALE_HEIGHTS 12.0

// Must match FAtmosphereMultipleScatteringLutCS::LutWidth / LutHeight (AtmosphereShaders.h).
// 64 texels along the sun cos zenith (CPU prototype: 32 smear sunlit values into the Earth's shadow at twilight:
// +57 % at the anti-solar horizon at sun -3 deg; 64: -5 %), 32 along the altitude (64 changes nothing).
#define PA_MS_LUT_WIDTH 64
#define PA_MS_LUT_HEIGHT 32
// Directions per texel (8 x 8 equal-area stratified sphere = one thread each) and steps per direction.
#define PA_MS_LUT_DIRECTIONS_SQRT 8
#define PA_MS_LUT_DIRECTIONS (PA_MS_LUT_DIRECTIONS_SQRT * PA_MS_LUT_DIRECTIONS_SQRT)
#define PA_MS_LUT_STEPS 20

static const float PA_ATMOSPHERE_PI = 3.14159265;

/** One planet's atmosphere in shader units (cm, 1/cm). Altitudes H are above the atmosphere bottom. */
struct FPAScattering
{
	float BottomRadius;            // Rb = planet radius + atmosphere bottom altitude
	float BottomAltitude;          // atmosphere bottom above the planet radius (FPAAtmosphere altitudes -> H)
	float Thickness;               // Ht = min(geometric top, effective top) - bottom: where the medium is integrated
	float3 RayleighScattering;
	float RayleighInvScaleHeight;
	float3 MieScattering;
	float3 MieExtinction;          // scattering + absorption
	float MieInvScaleHeight;
	float MieG;
	float3 OzoneAbsorption;
	float OzoneAltitude;
	float OzoneInvHalfWidth;
	float3 SurfaceAlbedo;
};

FPAScattering PA_LoadScattering(int Index)
{
	FPAScattering S;
	const float PlanetRadius = AtmosphereData0[Index].w;
	S.BottomAltitude = AtmosphereData1[Index].y;
	S.BottomRadius = PlanetRadius + S.BottomAltitude;
	S.RayleighScattering = AtmosphereRayleigh[Index].xyz;
	S.RayleighInvScaleHeight = 1.0 / max(AtmosphereRayleigh[Index].w, 1.0);
	S.MieScattering = AtmosphereMieScattering[Index].xyz;
	S.MieExtinction = AtmosphereMieScattering[Index].xyz + AtmosphereMieAbsorption[Index].xyz;
	S.MieInvScaleHeight = 1.0 / max(AtmosphereMieScattering[Index].w, 1.0);
	S.MieG = AtmosphereMieAbsorption[Index].w;
	S.OzoneAbsorption = AtmosphereOzone[Index].xyz;
	S.OzoneAltitude = AtmosphereOzone[Index].w;
	S.OzoneInvHalfWidth = 2.0 / max(AtmosphereSurface[Index].w, 1.0);
	S.SurfaceAlbedo = AtmosphereSurface[Index].xyz;

	const float GeometricThickness = AtmosphereData1[Index].z - S.BottomAltitude;
	const float EffectiveThickness = max(
		PA_ATMOSPHERE_EFFECTIVE_TOP_SCALE_HEIGHTS * max(AtmosphereRayleigh[Index].w, AtmosphereMieScattering[Index].w),
		AtmosphereOzone[Index].w + 0.5 * AtmosphereSurface[Index].w);
	S.Thickness = max(min(GeometricThickness, EffectiveThickness), 1.0);
	return S;
}

// ---- Medium ---------------------------------------------------------------------------------

/** Relative densities at altitude H above the atmosphere bottom: x = Rayleigh, y = Mie, z = ozone. */
float3 PA_AtmosphereDensities(FPAScattering S, float H)
{
	H = max(H, 0.0);
	return float3(
		exp(-H * S.RayleighInvScaleHeight),
		exp(-H * S.MieInvScaleHeight),
		saturate(1.0 - abs(H - S.OzoneAltitude) * S.OzoneInvHalfWidth));
}

/** Extinction (1/cm) for the given relative densities. */
float3 PA_AtmosphereExtinction(FPAScattering S, float3 Densities)
{
	return S.RayleighScattering * Densities.x + S.MieExtinction * Densities.y + S.OzoneAbsorption * Densities.z;
}

/**
 * Energy-conserving integral of a constant source over one step: (1 - exp(-sigma dt)) / sigma (-> dt for sigma dt -> 0).
 * Outputs the step transmittance. (step()/lerp() instead of a vector ternary: valid in both HLSL 2018 and 2021.)
 */
float3 PA_StepIntegral(float3 Extinction, float Dt, out float3 StepTransmittance)
{
	const float3 OpticalDepth = Extinction * Dt;
	StepTransmittance = exp(-OpticalDepth);
	return lerp(
		Dt * (1.0 - 0.5 * OpticalDepth),
		(1.0 - StepTransmittance) / max(Extinction, 1e-30),
		step(1e-4, OpticalDepth));
}

/** CosTheta = dot(view ray, direction to the sun). Units: 1/sr. */
float PA_RayleighPhase(float CosTheta)
{
	return 3.0 / (16.0 * PA_ATMOSPHERE_PI) * (1.0 + CosTheta * CosTheta);
}

/** Cornette-Shanks (as UE SkyAtmosphere). Units: 1/sr. */
float PA_MiePhase(float CosTheta, float G)
{
	const float G2 = G * G;
	const float K = 3.0 / (8.0 * PA_ATMOSPHERE_PI) * (1.0 - G2) / (2.0 + G2);
	return K * (1.0 + CosTheta * CosTheta) / pow(max(1.0 + G2 - 2.0 * G * CosTheta, 1e-6), 1.5);
}

// ---- Transmittance LUT parameterization (Bruneton 2017), in altitudes ------------------------

/** sqrt(r^2 - Rb^2) for r = Rb + H, without the difference of squares. */
float PA_AtmosphereRho(float BottomRadius, float H)
{
	H = max(H, 0.0);
	return sqrt(H * (2.0 * BottomRadius + H));
}

/** (H, Mu) -> unit-range LUT coordinates (x = Mu axis, y = altitude axis). H is clamped into the atmosphere. */
float2 PA_TransmittanceLutHMuToUnit(FPAScattering S, float H, float Mu)
{
	H = clamp(H, 0.0, S.Thickness);
	const float Rb = S.BottomRadius;
	const float R = Rb + H;
	const float BigH = PA_AtmosphereRho(Rb, S.Thickness);   // sqrt(Rt^2 - Rb^2)
	const float Rho = PA_AtmosphereRho(Rb, H);

	// Distance to the top boundary: -r mu + sqrt(r^2 mu^2 + Rt^2 - r^2), cancellation-free for mu > 0.
	const float RMu = R * Mu;
	const float TopMinusR2 = (S.Thickness - H) * (2.0 * Rb + S.Thickness + H);   // Rt^2 - r^2
	const float SqrtDisc = sqrt(max(TopMinusR2 + RMu * RMu, 0.0));
	const float D = RMu > 0.0 ? TopMinusR2 / (SqrtDisc + RMu) : SqrtDisc - RMu;

	const float DMin = S.Thickness - H;
	const float DMax = Rho + BigH;
	return float2((D - DMin) / max(DMax - DMin, 1e-3), Rho / BigH);
}

/** Inverse of PA_TransmittanceLutHMuToUnit (LUT build): unit coordinates -> altitude H, cos zenith Mu, distance to the top D. */
void PA_TransmittanceLutUnitToHMu(FPAScattering S, float2 X, out float H, out float Mu, out float D)
{
	const float Rb = S.BottomRadius;
	const float BigH = PA_AtmosphereRho(Rb, S.Thickness);
	const float Rho = BigH * X.y;
	H = Rho * Rho / (sqrt(Rho * Rho + Rb * Rb) + Rb);         // r - Rb
	H = min(H, S.Thickness);
	const float R = Rb + H;
	const float DMin = S.Thickness - H;
	const float DMax = Rho + BigH;
	D = DMin + X.x * (DMax - DMin);
	const float BigH2MinusRho2 = (S.Thickness - H) * (2.0 * Rb + S.Thickness + H);   // BigH^2 - Rho^2
	Mu = D <= 0.0 ? 1.0 : clamp((BigH2MinusRho2 - D * D) / (2.0 * R * D), -1.0, 1.0);
}

/**
 * Altitude above the atmosphere bottom at distance T along a ray that starts at altitude H with cos zenith Mu.
 * r(T)^2 - Rb^2 = rho^2 + T (T + 2 r mu)  ->  h = (r(T)^2 - Rb^2) / (r(T) + Rb).
 */
float PA_AltitudeAlongRay(float BottomRadius, float H, float Mu, float T)
{
	const float Rho = PA_AtmosphereRho(BottomRadius, H);
	const float N = max(Rho * Rho + T * (T + 2.0 * (BottomRadius + H) * Mu), 0.0);
	return N / (sqrt(BottomRadius * BottomRadius + N) + BottomRadius);
}

/** Integrated transmittance toward the top of the atmosphere from altitude H, cos zenith Mu (LUT build). */
float3 PA_ComputeTransmittanceToTop(FPAScattering S, float H, float Mu, float DistanceToTop, int NumSteps)
{
	const float Dt = DistanceToTop / (float)NumSteps;
	float3 OpticalDepth = 0.0;
	for (int Step = 0; Step < NumSteps; ++Step)
	{
		const float T = ((float)Step + 0.5) * Dt;
		const float SampleH = PA_AltitudeAlongRay(S.BottomRadius, H, Mu, T);
		OpticalDepth += PA_AtmosphereExtinction(S, PA_AtmosphereDensities(S, SampleH)) * Dt;
	}
	return exp(-OpticalDepth);
}

/** True if the sun (cos zenith Mu) is above the horizon of the atmosphere-bottom sphere at altitude H (hard planet shadow). */
bool PA_SunAboveHorizon(FPAScattering S, float H, float Mu)
{
	H = max(H, 0.0);
	return Mu >= -PA_AtmosphereRho(S.BottomRadius, H) / (S.BottomRadius + H);
}

// ---- Transmittance LUT atlas (render passes that read it) ------------------------------------
#ifndef PA_TRANSMITTANCE_LUT_PASS

Texture2D<float4> TransmittanceLutAtlas;   // PA_TRANSMITTANCE_LUT_WIDTH x (PA_TRANSMITTANCE_LUT_HEIGHT x NumAtmospheres)
SamplerState TransmittanceLutSampler;      // bilinear, clamp

/** Bilinear LUT lookup for planet Index. Texel centers map to the unit range ends, so rows never bleed into each other. */
float3 PA_SampleTransmittanceLut(int Index, FPAScattering S, float H, float Mu)
{
	const float2 Size = float2(PA_TRANSMITTANCE_LUT_WIDTH, PA_TRANSMITTANCE_LUT_HEIGHT);
	const float2 X = saturate(PA_TransmittanceLutHMuToUnit(S, H, Mu));
	float2 UV = (0.5 + X * (Size - 1.0)) / Size;
	UV.y = ((float)Index + UV.y) / (float)max(NumAtmospheres, 1);
	return TransmittanceLutAtlas.SampleLevel(TransmittanceLutSampler, UV, 0).rgb;
}

/** Sun transmittance at altitude H for sun cos zenith Mu: LUT x hard planet shadow. */
float3 PA_AtmosphereSunTransmittance(int Index, FPAScattering S, float H, float Mu)
{
	return PA_SunAboveHorizon(S, H, Mu) ? PA_SampleTransmittanceLut(Index, S, H, Mu) : 0.0;
}

/** MS LUT texel (local, unit range: x = sun cos zenith, y = altitude) <-> (Mu_s, H). Texel centers map to the range ends. */
float2 PA_MultipleScatteringLutHMuToUV(FPAScattering S, float H, float SunMu)
{
	const float2 Size = float2(PA_MS_LUT_WIDTH, PA_MS_LUT_HEIGHT);
	const float2 X = saturate(float2(SunMu * 0.5 + 0.5, H / S.Thickness));
	return (0.5 + X * (Size - 1.0)) / Size;
}

/**
 * One direction of one MS LUT texel (Hillaire 2020): the point at altitude H (above the atmosphere bottom) with the sun
 * at cos zenith SunMu looks along Dir (local frame, up = +z, sun in the xz plane) and integrates, over the medium up to
 * the effective top or the ground (the bottom sphere), with PA_MS_LUT_STEPS quadratic steps:
 *   OutL = second-order light with an isotropic phase: T * sigma_s * (1 / 4 pi) * sun transmittance,
 *          + the sunlit ground (Lambert, SurfaceAlbedo) seen at the end of the ray;
 *   OutF = transfer of an isotropic unit radiance: T * sigma_s.
 * The texel value is mean(OutL) / (1 - mean(OutF)) over the sphere (infinite series of orders, Hillaire eq. 9).
 */
void PA_MultipleScatteringDirection(int Index, FPAScattering S, float H, float SunMu, float3 Dir, out float3 OutL, out float3 OutF)
{
	OutL = 0.0;
	OutF = 0.0;
	const float Rb = S.BottomRadius;
	const float3 O = float3(0.0, 0.0, Rb + H);
	const float3 Sun = float3(sqrt(saturate(1.0 - SunMu * SunMu)), 0.0, SunMu);

	// Altitudes relative to the bottom sphere: medium top = Thickness, ground = 0.
	const float2 TopHit = PA_RaySphereIntersect(O, Dir, Rb, H, S.Thickness);
	const float2 GroundHit = PA_RaySphereIntersect(O, Dir, Rb, H, 0.0);
	const bool bGround = GroundHit.x <= GroundHit.y && GroundHit.y > 0.0;
	const float TEnd = bGround ? max(GroundHit.x, 0.0) : max(TopHit.y, 0.0);

	float3 Transmittance = 1.0;
	const float InvSteps = 1.0 / (float)PA_MS_LUT_STEPS;
	for (int Step = 0; Step < PA_MS_LUT_STEPS; ++Step)
	{
		const float F0 = Step * InvSteps * (Step * InvSteps);
		const float F1 = (Step + 1) * InvSteps * ((Step + 1) * InvSteps);
		const float Dt = TEnd * (F1 - F0);
		const float3 P = O + Dir * (TEnd * 0.5 * (F0 + F1));
		const float R = length(P);
		const float SampleH = R - Rb;
		const float3 Densities = PA_AtmosphereDensities(S, SampleH);
		const float3 Scattering = S.RayleighScattering * Densities.x + S.MieScattering * Densities.y;
		const float3 SunTransmittance = PA_AtmosphereSunTransmittance(Index, S, SampleH, dot(P, Sun) / max(R, 1.0));

		float3 StepTransmittance;
		const float3 StepIntegral = PA_StepIntegral(PA_AtmosphereExtinction(S, Densities), Dt, StepTransmittance);
		OutL += Transmittance * Scattering * (1.0 / (4.0 * PA_ATMOSPHERE_PI)) * SunTransmittance * StepIntegral;
		OutF += Transmittance * Scattering * StepIntegral;
		Transmittance *= StepTransmittance;
	}

	if (bGround)
	{
		const float3 GroundNormal = normalize(O + Dir * TEnd);
		const float GroundMu = dot(GroundNormal, Sun);
		OutL += Transmittance * (S.SurfaceAlbedo / PA_ATMOSPHERE_PI) * saturate(GroundMu)
			* PA_SampleTransmittanceLut(Index, S, 0.0, GroundMu);
	}
}

#ifndef PA_MULTIPLE_SCATTERING_LUT_PASS

Texture2D<float4> MultipleScatteringLutAtlas;   // PA_MS_LUT_WIDTH x (PA_MS_LUT_HEIGHT x NumAtmospheres), sampled with TransmittanceLutSampler
int bMultipleScattering;                         // r.PlanetAtmosphere.Atmosphere.MultipleScattering

/** Psi_ms for planet Index (sun illuminance 1). */
float3 PA_SampleMultipleScatteringLut(int Index, FPAScattering S, float H, float SunMu)
{
	float2 UV = PA_MultipleScatteringLutHMuToUV(S, H, SunMu);
	UV.y = ((float)Index + UV.y) / (float)max(NumAtmospheres, 1);
	return MultipleScatteringLutAtlas.SampleLevel(TransmittanceLutSampler, UV, 0).rgb;
}

struct FPAAtmosphereSegment
{
	float3 Luminance;       // in-scattered, absolute (sun illuminance x 1/sr)
	float3 Transmittance;
};

/**
 * Adds the view-ray interval [TBase + O0, TBase + O1] to Segment: one sample at the midpoint, energy-conserving
 * integral, attenuated by the transmittance Segment has accumulated so far. Single scattering (+ multiple
 * scattering, Step 14). The interval is given as offsets from TBase so its length never comes from subtracting two
 * large distances (camera far from the planet).
 */
void PA_AtmosphereInterval(
	int Index, FPAAtmosphere A, FPAScattering S, float3 RayDir, float TBase, float O0, float O1,
	float PhaseRayleigh, float PhaseMie, float3 SunDirection, float3 SunIlluminance, bool bHasSun,
	inout FPAAtmosphereSegment Segment)
{
	const float Dt = O1 - O0;
	if (Dt <= 0.0)
	{
		return;
	}
	const float3 P = A.CameraRel + RayDir * (TBase + 0.5 * (O0 + O1));   // planet-relative, world axes
	const float R = length(P);
	const float H = R - A.PlanetRadius - S.BottomAltitude;      // ~64 cm granularity at Earth scale: fine for density
	const float3 Densities = PA_AtmosphereDensities(S, H);
	const float3 Extinction = PA_AtmosphereExtinction(S, Densities);

	float3 Scattered = 0.0;
	if (bHasSun)
	{
		const float SunMu = dot(P, SunDirection) / max(R, 1.0);
		const float3 SunTransmittance = PA_AtmosphereSunTransmittance(Index, S, H, SunMu);
		Scattered = (S.RayleighScattering * (Densities.x * PhaseRayleigh) + S.MieScattering * (Densities.y * PhaseMie))
			* SunTransmittance;
		if (bMultipleScattering != 0)
		{
			// Step 14: all orders >= 2 (isotropic, not shadowed by the planet: Psi_ms already depends on SunMu).
			Scattered += (S.RayleighScattering * Densities.x + S.MieScattering * Densities.y)
				* PA_SampleMultipleScatteringLut(Index, S, H, SunMu);
		}
		Scattered *= SunIlluminance;
	}

	// Energy-conserving integral over the interval: S * (1 - exp(-sigma dt)) / sigma (-> S dt for sigma dt -> 0).
	float3 StepTransmittance;
	const float3 StepIntegral = PA_StepIntegral(Extinction, Dt, StepTransmittance);
	Segment.Luminance += Segment.Transmittance * Scattered * StepIntegral;
	Segment.Transmittance *= StepTransmittance;
}

/**
 * Atmosphere along the view ray inside the medium (sphere BottomAltitude + Thickness, i.e. the effective top), clipped
 * to [0, TMax] (TMax = planet surface or scene geometry), split at SplitT (Step 15: the clouds' contribution-weighted
 * mean depth; PA_INFINITY = everything in Front). NumSteps steps at the Step 13 positions: quadratic distribution
 * (fine near the camera) when the camera is inside the medium, uniform from outside (CPU prototype: mean luminance
 * error <= 0.9 % at 16 steps); the step containing SplitT is cut in two (one extra sample).
 * Front: [camera, SplitT]. Back: [SplitT, TMax], relative to SplitT (not attenuated by Front).
 */
void PA_IntegrateAtmosphereSplit(
	int Index, FPAAtmosphere A, FPAScattering S,
	float3 RayDir, float TMax, float SplitT, int NumSteps,
	float3 SunDirection, float3 SunIlluminance, bool bHasSun,
	out FPAAtmosphereSegment Front, out FPAAtmosphereSegment Back)
{
	Front.Luminance = 0.0;
	Front.Transmittance = 1.0;
	Back.Luminance = 0.0;
	Back.Transmittance = 1.0;

	const float MediumTopAltitude = S.BottomAltitude + S.Thickness;   // above the planet radius
	const float2 MediumHit = PA_RaySphereIntersect(A.CameraRel, RayDir, A.PlanetRadius, A.CameraAltitude, MediumTopAltitude);
	if (MediumHit.x > MediumHit.y || MediumHit.y <= 0.0)
	{
		return;
	}
	const float TStart = max(MediumHit.x, 0.0);
	const float Length = min(MediumHit.y, TMax) - TStart;
	if (Length <= 0.0 || NumSteps <= 0)
	{
		return;
	}

	const bool bQuadratic = A.CameraAltitude < MediumTopAltitude;
	const float CosTheta = dot(RayDir, SunDirection);
	const float PhaseRayleigh = PA_RayleighPhase(CosTheta);
	const float PhaseMie = PA_MiePhase(CosTheta, S.MieG);
	const float InvSteps = 1.0 / (float)NumSteps;
	const float SplitOffset = SplitT - TStart;   // PA_INFINITY stays huge

	for (int Step = 0; Step < NumSteps; ++Step)
	{
		float F0 = (float)Step * InvSteps;
		float F1 = (float)(Step + 1) * InvSteps;
		if (bQuadratic)
		{
			F0 *= F0;
			F1 *= F1;
		}
		// Offsets from TStart (see PA_AtmosphereInterval).
		const float Oa = Length * F0;
		const float Ob = Length * F1;
		if (Oa < SplitOffset)
		{
			PA_AtmosphereInterval(Index, A, S, RayDir, TStart, Oa, min(Ob, SplitOffset), PhaseRayleigh, PhaseMie, SunDirection, SunIlluminance, bHasSun, Front);
		}
		if (Ob > SplitOffset)
		{
			PA_AtmosphereInterval(Index, A, S, RayDir, TStart, max(Oa, SplitOffset), Ob, PhaseRayleigh, PhaseMie, SunDirection, SunIlluminance, bHasSun, Back);
		}
	}
}

#endif // PA_MULTIPLE_SCATTERING_LUT_PASS
#endif // PA_TRANSMITTANCE_LUT_PASS
