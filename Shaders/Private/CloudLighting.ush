#pragma once

// Step 7 — basic sun lighting of the clouds.
//   - phase function: two-lobe Henyey-Greenstein (strong forward lobe = glow toward the sun, weak back lobe)
//   - sun transmittance: short light march toward the sun; density comes ONLY from PA_SampleCloudDensity()
//     (CloudDensity.ush, AD-1), called with a coarser LOD footprint to keep it cheap
//   - planet shadow: soft terminator (day / night side)
// Not here yet (Phase 7): multiple scattering, silver lining, atmospheric reddening at sunset.

#include "/Plugin/PlanetAtmosphere/Private/PlanetAtmosphereShaderData.ush"

static const float PA_PI = 3.14159265;

// Light march early exit (Step 9): beyond this optical depth the sun is fully blocked for practical purposes
// (exp(-7) ~ 0.0009), further samples cannot change the result visibly.
static const float PA_LIGHT_MARCH_MAX_OPTICAL_DEPTH = 7.0;

float PA_HenyeyGreenstein(float CosTheta, float G)
{
	const float G2 = G * G;
	return (1.0 - G2) / (4.0 * PA_PI * pow(max(1.0 + G2 - 2.0 * G * CosTheta, 1e-4), 1.5));
}

/** CosTheta = dot(view ray direction, direction to the sun). Units: 1/sr. */
float PA_CloudPhase(float CosTheta)
{
	return 0.7 * PA_HenyeyGreenstein(CosTheta, 0.6) + 0.3 * PA_HenyeyGreenstein(CosTheta, -0.25);
}

/**
 * Length of the light march from P (planet-relative, world axes, altitude known) toward the sun: up to the cloud-top
 * exit, at most MaxLength. Step 32: the top is the deepest cloud the weather allows along the path
 * (PA_CloudRayTopAltitude), so the few light samples stay inside a shallow cloud instead of spreading over the layer.
 */
float PA_CloudSunMarchLength(FPAAtmosphere A, FPACloudLayer Layer, float3 P, float Altitude, float3 SunDirection, float MaxLength)
{
	// Exit of the cloud-top sphere along the sun direction (precision-safe form, sample altitude known).
	const float2 TopHit = PA_RaySphereIntersect(P, SunDirection, A.PlanetRadius, Altitude, A.CloudTop);
	float Exit = max(TopHit.y, 0.0);
	const float Top = PA_CloudRayTopAltitude(A, Layer, P, SunDirection, 0.0, min(Exit, MaxLength));
	if (Top < A.CloudTop)
	{
		Exit = max(PA_RaySphereIntersect(P, SunDirection, A.PlanetRadius, Altitude, Top).y, 0.0);
	}
	return min(Exit, MaxLength);
}

/**
 * Optical depth of the clouds from P toward the sun over MarchLength: NumSteps samples with quadratically growing
 * spacing (fine near P). Stops above PA_LIGHT_MARCH_MAX_OPTICAL_DEPTH.
 */
float PA_CloudSunOpticalDepth(
	FPAAtmosphere A, FPACloudLayer Layer,
	float3 P, float3 SunDirection,
	float BaseFootprint, int NumSteps, float MarchLength,
	inout uint NumDensitySamples)   // incremented per density call (Ray Steps debug view)
{
	if (MarchLength <= 0.0 || NumSteps <= 0)
	{
		return 0.0;
	}

	const float InvSteps2 = 1.0 / (float)(NumSteps * NumSteps);
	float OpticalDepth = 0.0;
	for (int Step = 0; Step < NumSteps; ++Step)
	{
		const float S = MarchLength * ((float)Step + 0.5) * ((float)Step + 0.5) * InvSteps2;
		const float Ds = MarchLength * (float)(2 * Step + 1) * InvSteps2;
		const float3 SampleP = P + SunDirection * S;
		const float SampleAltitude = length(SampleP) - A.PlanetRadius;

		// LOD: the light march does not need detail finer than its own step.
		const float Density = PA_SampleCloudDensity(Layer, PA_ToPlanetLocal(A, SampleP), SampleAltitude, max(BaseFootprint, Ds));
		NumDensitySamples += 1u;
		OpticalDepth += Density * A.CloudExtinction * Ds;
		if (OpticalDepth > PA_LIGHT_MARCH_MAX_OPTICAL_DEPTH)
		{
			break;
		}
	}
	return OpticalDepth;
}

/**
 * Transmittance of sunlight from P (planet-relative, world axes, inside the cloud shell) toward the sun: the light march
 * of Steps 7-12, NumSteps samples up to the cloud top, at most 3 layer thicknesses. Since Phase 4 the fallback where the
 * cloud shadow cascades are not available (CloudRaymarch.usf).
 */
float PA_CloudSunTransmittance(
	FPAAtmosphere A, FPACloudLayer Layer,
	float3 P, float Altitude, float3 SunDirection,
	float BaseFootprint, int NumSteps,
	inout uint NumDensitySamples)
{
	const float MarchLength = PA_CloudSunMarchLength(A, Layer, P, Altitude, SunDirection, 3.0 * Layer.Thickness);
	return exp(-PA_CloudSunOpticalDepth(A, Layer, P, SunDirection, BaseFootprint, NumSteps, MarchLength, NumDensitySamples));
}

/**
 * Phase 4 / Step 24 (AD-27): cloud optical depth of the sun path from P BELOW the cloud layer (the planet surface;
 * planet-relative, world axes, altitude known): uniform samples over the whole layer crossing (cloud-bottom exit ->
 * cloud-top exit), no length cap. Step count = ceil(length / MaxStepLength) clamped to [MinSteps, MaxSteps]: long
 * low-sun paths need short steps, otherwise every sample stamps a shifted copy of the cloud and the light between the
 * stamps leaks through (UE test: "ladder" shadows; prototype p24d, sun 8 deg / 48 km path: 12 fixed steps 9.5 bright,
 * steps <= 1 km 0.8; high sun unchanged). Jitter (per pixel, animated, [0, 1)) moves the samples inside their steps;
 * the temporal accumulation averages what is left of the stamps. Noise footprint max(BaseFootprint, step / 4): a
 * footprint of the whole step fades the octaves and loses clouds (AD-14). No pixel-footprint LOD of the step count:
 * from orbit the march is what keeps the shadows sharp. Stops above PA_LIGHT_MARCH_MAX_OPTICAL_DEPTH.
 */
float PA_CloudLayerCrossingOpticalDepth(
	FPAAtmosphere A, FPACloudLayer Layer,
	float3 P, float Altitude, float3 SunDirection,
	float BaseFootprint, int MinSteps, int MaxSteps, float MaxStepLength, float Jitter,
	inout uint NumDensitySamples)
{
	const float2 BottomHit = PA_RaySphereIntersect(P, SunDirection, A.PlanetRadius, Altitude, A.CloudBottom);
	float2 TopHit = PA_RaySphereIntersect(P, SunDirection, A.PlanetRadius, Altitude, A.CloudTop);
	const float Start = max(BottomHit.y, 0.0);
	// Step 32: only up to the deepest clouds the weather allows along the crossing.
	const float Top = PA_CloudRayTopAltitude(A, Layer, P, SunDirection, Start, max(TopHit.y, Start));
	if (Top < A.CloudTop)
	{
		TopHit = PA_RaySphereIntersect(P, SunDirection, A.PlanetRadius, Altitude, Top);
	}
	const float Length = max(TopHit.y, 0.0) - Start;
	if (Length <= 0.0 || MaxSteps <= 0)
	{
		return 0.0;
	}

	const float StepsForLength = ceil(Length / max(MaxStepLength, 1.0));
	const int NumSteps = clamp((int)min(StepsForLength, (float)MaxSteps), max(MinSteps, 1), max(MaxSteps, 1));
	const float Ds = Length / (float)NumSteps;
	const float Footprint = max(BaseFootprint, 0.25 * Ds);
	float OpticalDepth = 0.0;
	for (int Step = 0; Step < NumSteps; ++Step)
	{
		const float3 SampleP = P + SunDirection * (Start + ((float)Step + Jitter) * Ds);
		const float SampleAltitude = length(SampleP) - A.PlanetRadius;
		const float Density = PA_SampleCloudDensity(Layer, PA_ToPlanetLocal(A, SampleP), SampleAltitude, Footprint);
		NumDensitySamples += 1u;
		OpticalDepth += Density * A.CloudExtinction * Ds;
		if (OpticalDepth > PA_LIGHT_MARCH_MAX_OPTICAL_DEPTH)
		{
			break;
		}
	}
	return OpticalDepth;
}

/** 1 in sunlight, 0 in the planet's shadow, with a narrow soft terminator. P planet-relative. */
float PA_PlanetShadow(float3 P, float3 SunDirection, float PlanetRadius)
{
	const float B = dot(P, SunDirection);
	if (B >= 0.0)
	{
		return 1.0; // the sun is above this point's horizon plane -> the planet cannot block it
	}
	const float DistanceToSunAxis = length(P - B * SunDirection);
	const float Penumbra = 0.004 * PlanetRadius;
	return smoothstep(PlanetRadius - Penumbra, PlanetRadius + Penumbra, DistanceToSunAxis);
}

/** Ambient (sky) light fades out across the terminator: ~0 on the night side. */
float PA_DaylightFactor(float3 P, float3 SunDirection)
{
	const float3 Up = P / max(length(P), 1.0);
	return saturate(dot(Up, SunDirection) * 4.0 + 0.25);
}
