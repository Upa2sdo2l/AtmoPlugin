#pragma once

// Cloud shadow cascades (Phase 4). Declarations and helpers shared by CloudShadowGenerate.usf (writes the atlas) and
// CloudRaymarch.usf (debug views 9-11; Step 23: lookup for the sun path beyond the short local march).
// C++ counterpart: FAtmosphereCloudShadowParameters (AtmosphereShaders.h), state in AtmosphereCloudShadows.cpp.
//
// Geometry (planet-local frame of the primary planet, cm): each cascade is an orthographic grid in the plane
// perpendicular to the sun direction S, axes U and V. Global texel (i, j) covers u in [i, i+1) * Texel, v likewise;
// its ray comes from the sun side along -S: P(w) = u U + v V + w S. The cloud-shell segment of that ray is analytic:
//   enters the cloud-top sphere at w = +HTop, HTop = sqrt(RTop^2 - rho^2), rho = |(u, v)|,
//   leaves it at the cloud-bottom sphere (w = +HBottom, rho < RBottom) or at the top sphere again (w = -HTop).
// Stored per texel (Beer Shadow Map, RGBA16F): front and back of the cloud matter along that segment as fractions of
// the segment (0 = top entry), the optical depth of the whole segment, and alpha = 1 when the texel is valid.
//
// Only the sun-side segment is stored: a point on the night side (w < 0 below the cloud bottom sphere's shadow) has the
// same (u, v) as a day-side column; it is in the planet's shadow anyway, so lookups must be gated by the sun visibility
// (planet shadow / transmittance LUT) first.
//
// Storage: a window of Res x Res texels around the sub-camera point, addressed toroidally (texel i at i mod Res), so
// a moving window only needs the newly covered tiles. Cascade c occupies rows [c * Res, (c + 1) * Res) of the atlas.

#define PA_SHADOW_CASCADES 3                 // = PLANET_ATMOSPHERE_SHADOW_CASCADES
#define PA_SHADOW_TILE 32                    // texels per tile side (update granularity)
#define PA_SHADOW_MAX_TILES_PER_PASS 64      // = PLANET_ATMOSPHERE_SHADOW_MAX_TILES_PER_PASS
#define PA_SHADOW_MAX_OPTICAL_DEPTH 12.0     // generation stops above this (transmittance 6e-6)

// Content of a texel that is not (yet) generated: alpha 0 -> callers use the per-sample light march instead.
#define PA_SHADOW_INVALID float4(1.0, 1.0, 0.0, 0.0)

int CloudShadowPlanet;                               // index in the atmosphere arrays; -1 = no cascades this frame
int CloudShadowResolution;                           // texels per cascade side
float4 CloudShadowAxisU[PA_SHADOW_CASCADES];         // xyz = axis U (planet local, unit), w = texel size (cm)
float4 CloudShadowAxisV[PA_SHADOW_CASCADES];         // xyz = axis V, w = 1 / texel size
float4 CloudShadowSun[PA_SHADOW_CASCADES];           // xyz = direction toward the sun (planet local), w = 1 if configured
float4 CloudShadowWindow[PA_SHADOW_CASCADES];        // xy = global texel of the window's first texel, zw = sub-camera point (window texels)

/** Atlas texel of a global cascade texel (toroidal addressing). */
int2 PA_ShadowStorageTexel(int Cascade, int2 GlobalTexel)
{
	const int Res = CloudShadowResolution;
	const int2 Wrapped = ((GlobalTexel % Res) + Res) % Res;   // % keeps the sign of the dividend
	return int2(Wrapped.x, Wrapped.y + Cascade * Res);
}

/**
 * Cloud-shell segment of the cascade ray through light-plane distance Rho from the planet axis along the sun:
 * WEntry = sun-axis coordinate where it enters the cloud-top sphere, Length = length of the segment.
 * Returns false if the ray misses the cloud layer. Radii as PlanetRadius + altitude (AD-3); the differences of squares
 * are formed as (R - rho)(R + rho).
 */
bool PA_ShadowRaySegment(float Rho, float PlanetRadius, float CloudBottom, float CloudTop, out float WEntry, out float Length)
{
	const float RTop = PlanetRadius + CloudTop;
	const float RBottom = PlanetRadius + CloudBottom;
	WEntry = 0.0;
	Length = 0.0;
	if (Rho >= RTop)
	{
		return false;
	}
	WEntry = sqrt((RTop - Rho) * (RTop + Rho));
	const float WExit = Rho < RBottom ? sqrt((RBottom - Rho) * (RBottom + Rho)) : -WEntry;
	Length = WEntry - WExit;
	return Length > 0.0;
}

/**
 * Cloud transmittance toward the sun at QLocal (planet-local, cm) from the cascades (Phase 4 / Step 23): the smallest
 * cascade whose window holds the 2 x 2 texel footprint (+1 texel margin); per texel the Beer Shadow Map optical depth
 * at QLocal's depth along that texel's own ray, OD = min(ext x max(depth - front, 0), total), ext = total / (back - front);
 * the four transmittances are blended bilinearly (Step 21 prototype: "bsm_pcf"). Returns -1 when no cascade covers the
 * point or one of the texels is not generated yet: the caller uses the full light march then.
 * Only the sun-side segment of a texel ray is stored (see the note at the top); a point in the planet's shadow must not
 * get here (the caller gates by the sun visibility).
 */
float PA_CloudShadowTransmittance(Texture2D<float4> Atlas, float3 QLocal, float PlanetRadius, float CloudBottom, float CloudTop)
{
	if (CloudShadowPlanet < 0)
	{
		return -1.0;
	}
	const int Res = CloudShadowResolution;
	for (int Cascade = 0; Cascade < PA_SHADOW_CASCADES; ++Cascade)
	{
		if (CloudShadowSun[Cascade].w < 0.5)
		{
			continue;
		}
		const float Texel = CloudShadowAxisU[Cascade].w;
		const float2 TexelPosition = float2(dot(QLocal, CloudShadowAxisU[Cascade].xyz), dot(QLocal, CloudShadowAxisV[Cascade].xyz))
			* CloudShadowAxisV[Cascade].w - 0.5;   // global texel coordinates, texel centers at integers
		const float2 BaseF = floor(TexelPosition);
		const float2 Blend = TexelPosition - BaseF;
		const int2 Base = int2(BaseF);
		const int2 InWindow = Base - int2(CloudShadowWindow[Cascade].xy);
		if (any(InWindow < 1) || any(InWindow > Res - 3))
		{
			continue;   // not in this cascade's window: try the next (larger) one
		}

		const float W = dot(QLocal, CloudShadowSun[Cascade].xyz);
		float Transmittance = 0.0;
		for (int Corner = 0; Corner < 4; ++Corner)
		{
			const int2 Offset = int2(Corner & 1, Corner >> 1);
			const int2 GlobalTexel = Base + Offset;
			const float4 Data = Atlas.Load(int3(PA_ShadowStorageTexel(Cascade, GlobalTexel), 0));
			if (Data.a < 0.5)
			{
				return -1.0;   // tile not generated yet
			}
			const float2 TexelUV = (float2(GlobalTexel) + 0.5) * Texel;
			float WEntry;
			float Length;
			float OpticalDepth = 0.0;
			if (PA_ShadowRaySegment(length(TexelUV), PlanetRadius, CloudBottom, CloudTop, WEntry, Length))
			{
				const float Depth = saturate((WEntry - W) / Length);   // 0 = cloud-top entry, 1 = end of the segment
				const float Extinction = Data.b / max(Data.g - Data.r, 1e-4);
				OpticalDepth = min(Extinction * max(Depth - Data.r, 0.0), Data.b);
			}
			const float Weight = (Offset.x != 0 ? Blend.x : 1.0 - Blend.x) * (Offset.y != 0 ? Blend.y : 1.0 - Blend.y);
			Transmittance += Weight * exp(-OpticalDepth);
		}
		return Transmittance;
	}
	return -1.0;
}
